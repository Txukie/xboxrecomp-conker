+int nv2a_vsh_export(uint32_t out[NV2A_VSH_SLOTS][8])
+{
+    int i, k;
+
+    nv2a_vsh_prepare();
+    for (i = 0; i < s_ndecoded; i++) {
+        const VshIns *d = &s_decoded[i];
+        out[i][0] = d->mac | (uint32_t)d->ilu << 4 | (uint32_t)d->mac_mask << 8
+                  | (uint32_t)d->ilu_mask << 12 | (uint32_t)d->omask << 16
+                  | (uint32_t)d->out_ilu << 20 | (uint32_t)d->out_to_o << 21
+                  | (uint32_t)d->need_a << 22 | (uint32_t)d->need_b << 23
+                  | (uint32_t)d->need_c << 24;
+        out[i][1] = d->oaddr | (uint32_t)(uint8_t)(d->mac_dst + 1) << 8
+                  | (uint32_t)(uint8_t)(d->ilu_dst + 1) << 16;
+        for (k = 0; k < 3; k++) {
+            const VshSrc *r = &d->src[k];
+            out[i][2 + k] = r->kind | (uint32_t)r->idx << 4 | (uint32_t)r->neg << 9
+                          | (uint32_t)r->swz[0] << 10 | (uint32_t)r->swz[1] << 12
+                          | (uint32_t)r->swz[2] << 14 | (uint32_t)r->swz[3] << 16
+                          | ((uint32_t)r->ci & 0xFFFu) << 18;
+        }
+        out[i][5] = out[i][6] = out[i][7] = 0;
+    }
+    return s_ndecoded;
+}
