+static void backend_program_batch(void)
+{
+    static uint32_t prog[NV2A_VSH_SLOTS][8];
+    static int near_z = -1;
+    Nv2aProgramBatch pb;
+    Nv2aRenderState rs;
+    Nv2aSurface surf;
+    uint32_t n = s_gpu.idx_count, i, lo = 0xFFFFFFFFu, hi = 0;
+    const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset();
+
+    if (near_z < 0) {
+        const char *e = getenv("RECOMP_CLIP_NEAR_Z");
+        near_z = !(e && e[0] == '0');
+    }
+    memset(&pb, 0, sizeof pb);
+    pb.ninst = (uint32_t)nv2a_vsh_export(prog);
+    if (!pb.ninst)
+        return;                                        /* no program loaded */
+    pb.count = program_triangles(n);
+    if (!pb.count)
+        return;
+    pb.indices = s_ptri;
+    for (i = 0; i < n; i++) {
+        if (s_gpu.idx[i] < lo) lo = s_gpu.idx[i];
+        if (s_gpu.idx[i] > hi) hi = s_gpu.idx[i];
+    }
+    pb.min_index = lo;
+    pb.max_index = hi;
+    for (i = 0; i < NV2A_VSH_INPUTS; i++) {
+        const VertexAttr *at = &s_gpu.attr[i];
+        Nv2aAttrib *o = &pb.attr[i];
+        uint64_t first, span;
+
+        o->value[0] = o->value[1] = o->value[2] = 0.0f;
+        o->value[3] = 1.0f;
+        if (!at->size) {                   /* the current value (transform_vertex) */
+            memcpy(o->value, s_gpu.imm_attr[i], sizeof o->value);
+            continue;
+        }
+        if (!at->stride || (!at->offset && !s_gpu.inline_active))
+            continue;
+        o->stride = at->stride;
+        o->type = at->type;
+        o->size = at->size;
+        o->bytes = attr_elem_bytes(at);
+        first = (uint64_t)at->offset + (uint64_t)lo * at->stride;
+        span = (uint64_t)(hi - lo) * at->stride + o->bytes;
+        if (s_gpu.inline_active) {
+            if (first + span > (uint64_t)s_gpu.inline_count * 4)
+                continue;
+            o->data = (const uint8_t *)s_gpu.inline_buf + at->offset;
