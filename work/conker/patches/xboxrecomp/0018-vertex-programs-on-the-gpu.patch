+/* ---- Vertex programs on the back end ------------------------------------
+ *
+ * A back end with draw_program runs the title's vertex program itself, so a
+ * program batch goes over as the title stored it: the attribute arrays, the
+ * index list as triangles, and the program and constants. The CPU then does
+ * no per-vertex work at all for it -- which on Conker's front end was most of
+ * the executor's time once the GPU drew the pixels. A program that writes
+ * constants (_CXT_WRITE_EN) depends on vertex order, and stays here. */
+static int backend_program(void)
+{
+    return s_backend && s_backend->draw_program && s_backend->draw_full;
+}
+
+/* The primitive as a triangle list of vertex indices, in the order
+ * raster_batch_program assembles it. Returns the index count. */
+static uint32_t *s_ptri;
+
+static uint32_t program_triangles(uint32_t n)
+{
+    const uint32_t *x = s_gpu.idx;
+    uint32_t i, m = 0;
+
+    if (!s_ptri && !(s_ptri = (uint32_t *)malloc(sizeof *s_ptri * NV_MAX_INDICES * 3)))
+        return 0;
+#define TRI(a, b, c) (s_ptri[m] = x[a], s_ptri[m + 1] = x[b], s_ptri[m + 2] = x[c], m += 3)
+    switch (s_gpu.prim) {
+    case NV_PRIM_TRIANGLES:
+        for (i = 0; i + 2 < n; i += 3) TRI(i, i + 1, i + 2);
+        break;
+    case NV_PRIM_TRIANGLE_STRIP:
+        for (i = 0; i + 2 < n; i++) TRI(i, i + 1, i + 2);
+        break;
+    case NV_PRIM_TRIANGLE_FAN:
+    case NV_PRIM_POLYGON:
+        for (i = 1; i + 1 < n; i++) TRI(0, i, i + 1);
+        break;
+    case NV_PRIM_QUADS:
+        for (i = 0; i + 3 < n; i += 4) { TRI(i, i + 1, i + 2); TRI(i, i + 2, i + 3); }
+        break;
+    case NV_PRIM_QUAD_STRIP:
+        for (i = 0; i + 3 < n; i += 2) { TRI(i, i + 1, i + 3); TRI(i, i + 3, i + 2); }
+        break;
+    default:
+        break;
+    }
+#undef TRI
+    return m;
+}
