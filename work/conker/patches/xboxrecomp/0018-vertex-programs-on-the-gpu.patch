diff --git a/src/vulkan/nv2a_vk.h b/src/vulkan/nv2a_vk.h
index 73cc2a3..df17f1b 100644
--- a/src/vulkan/nv2a_vk.h
+++ b/src/vulkan/nv2a_vk.h
@@ -1,15 +1,19 @@
 /*
  * NV2A render back end on Vulkan.
  *
- * Registers itself with the pushbuffer executor (nv2a_backend.h, draw_full)
- * and rasterises on the host GPU what the CPU rasteriser would draw: the
- * executor still runs the vertex stage and the near-plane clip, the GPU does
- * every pixel -- texture stages, register combiners, alpha test, blending,
- * depth, stencil and the visibility-test pixel counts.
+ * Registers itself with the pushbuffer executor (nv2a_backend.h) and draws
+ * on the host GPU what the CPU rasteriser would draw. Vertex-program batches
+ * run their program on the GPU too (draw_program: shaders/nv2a_vsh.vert
+ * interprets it, pulling the attributes from a copy of the title's arrays,
+ * and clip distances stand in for the executor's near-plane clip);
+ * fixed-function and pre-transformed batches arrive transformed (draw_full).
+ * The GPU does every pixel -- texture stages, register combiners, alpha
+ * test, blending, depth, stencil and the visibility-test pixel counts.
  *
  * Surfaces live in GPU images. Guest memory is brought up to date when the
  * title would see it: before a flip shows a surface, and before a texture
- * stage reads memory a surface was drawn into (render to texture). A surface
+ * stage reads memory a surface was drawn into -- unless the stage reads
+ * exactly the surface, when it samples a GPU copy instead. A surface
  * whose guest memory changed since then (written by the CPU) is uploaded
  * before the GPU draws into it again. The framebuffer window keeps showing
  * guest memory, so every presenter works unchanged.
@@ -18,6 +22,7 @@
  *   RECOMP_VK_VALIDATE  enable the Khronos validation layer
  *   RECOMP_VK_VERBOSE   device choice, and a line of counts every 300 flips
  *   RECOMP_VK_STENCIL=0 ignore the stencil test (the CPU rasteriser has none)
+ *   RECOMP_VK_CPU_VSH   run vertex programs on the CPU, as for draw_full
  */
 #ifndef XBOXRECOMP_NV2A_VK_H
 #define XBOXRECOMP_NV2A_VK_H
diff --git a/src/vulkan/shaders/nv2a_vsh.vert b/src/vulkan/shaders/nv2a_vsh.vert
new file mode 100644
index 0000000..b23aeea
--- /dev/null
+++ b/src/vulkan/shaders/nv2a_vsh.vert
@@ -0,0 +1,255 @@
+#version 450
+/* An NV2A vertex program, run on the GPU.
+ *
+ * A port of the executor's interpreter (nv2a_vsh_interp.c nv2a_vsh_run, and
+ * fetch_attr and transform_vertex in nv2a_pb_exec.c), so that a program batch
+ * comes out as it does on the CPU. The program is data: the decoded form
+ * nv2a_vsh_export() writes (its layout is in nv2a_vsh_interp.h), read from a
+ * uniform block, one instruction at a time. Attributes are pulled from the
+ * batch's vertex data, copied as the title stored it.
+ *
+ * The CPU path's near-plane clip becomes two clip distances, the same two
+ * planes: w = 1e-3, and screen z at the viewport's z offset. */
+
+layout(location = 0) out vec4 v_d0;
+layout(location = 1) out vec4 v_d1;
+layout(location = 2) out float v_fog;
+layout(location = 3) out vec4 v_t0;
+layout(location = 4) out vec4 v_t1;
+layout(location = 5) out vec4 v_t2;
+layout(location = 6) out vec4 v_t3;
+
+out gl_PerVertex {
+    vec4 gl_Position;
+    float gl_ClipDistance[2];
+};
+
+layout(set = 0, binding = 9, std430) readonly buffer Verts { uint words[]; } vb;
+layout(set = 0, binding = 10, std140) uniform Consts { vec4 c[192]; } kc;
+layout(set = 0, binding = 11, std140) uniform Prog { uvec4 p[272]; } kp;
+/* nv2a_vk.c VkVshDraw: keep the two in step. */
+layout(set = 0, binding = 12, std140) uniform VshDraw {
+    uvec4 attr[16];   /* byte address of vertex 0, stride, type | size << 8
+                       * | present << 16, - */
+    vec4  value[16];  /* what an absent attribute reads */
+    vec4  vp;         /* 2 / width, 2 / height, 1 / zmax, aa x */
+    vec4  vp2;        /* aa y, near-plane screen z, instructions, - */
+    vec4  fogp;       /* enable, mode, param 0, param 1 */
+} u;
+
+uint rd32(uint a)
+{
+    uint i = a >> 2, sh = (a & 3u) * 8u;
+    if (sh == 0u)
+        return vb.words[i];
+    return (vb.words[i] >> sh) | (vb.words[i + 1u] << (32u - sh));
+}
+
+float s16(uint a)
+{
+    uint v = rd32(a) & 0xFFFFu;
+    return float(int(v << 16) >> 16);
+}
+
+float u8(uint a) { return float(rd32(a) & 0xFFu); }
+
+vec4 fetch(int i, uint vid)
+{
+    uvec4 d = u.attr[i];
+    vec4 o = vec4(0.0, 0.0, 0.0, 1.0);
+    uint type = d.z & 0xFFu, size = min((d.z >> 8) & 0xFFu, 4u);
+    uint a = d.x + vid * d.y;
+
+    if ((d.z & 0x10000u) == 0u)
+        return u.value[i];
+    if (type == 0u) {                                  /* D3DCOLOR */
+        uint v = rd32(a);
+        return vec4(float((v >> 16) & 0xFFu), float((v >> 8) & 0xFFu),
+                    float(v & 0xFFu), float(v >> 24)) / 255.0;
+    }
+    if (type == 6u) {                                  /* packed 11:11:10 */
+        uint v = rd32(a);
+        o.x = float(int(v << 21) >> 21) / 1023.0;
+        o.y = float(int(v << 10) >> 21) / 1023.0;
+        o.z = float(int(v) >> 22) / 511.0;
+        return o;
+    }
+    for (uint k = 0u; k < size; k++) {
+        if (type == 2u)      o[k] = uintBitsToFloat(rd32(a + 4u * k));
+        else if (type == 4u) o[k] = u8(a + k) / 255.0;
+        else if (type == 1u) o[k] = s16(a + 2u * k) / 32767.0;
+        else if (type == 5u) o[k] = s16(a + 2u * k);
+    }
+    return o;
+}
+
+vec4 R[13];        /* r0..r11, and 12 = oPos */
+vec4 O[13];        /* o[1..12]; o[0] is oPos */
+vec4 V[16];
+int a0;
+
+vec4 src(uint w)
+{
+    uint kind = w & 0xFu, idx = (w >> 4) & 0x1Fu;
+    vec4 s;
+    if (kind == 0u)      s = R[idx];
+    else if (kind == 1u) s = R[12];
+    else if (kind == 2u) s = V[idx];
+    else {
+        int ci = int(w >> 18);
+        if (kind == 4u) {
+            ci += a0;
+            if (ci < 0 || ci >= 192) ci = 0;
+        }
+        s = kc.c[ci];
+    }
+    vec4 r = vec4(s[(w >> 10) & 3u], s[(w >> 12) & 3u], s[(w >> 14) & 3u], s[(w >> 16) & 3u]);
+    return ((w >> 9) & 1u) != 0u ? -r : r;
+}
+
+void put(inout vec4 d, vec4 v, uint m)
+{
+    if ((m & 8u) != 0u) d.x = v.x;
+    if ((m & 4u) != 0u) d.y = v.y;
+    if ((m & 2u) != 0u) d.z = v.z;
+    if ((m & 1u) != 0u) d.w = v.w;
+}
+
+const float INF = uintBitsToFloat(0x7F800000u);
+
+vec4 mac(uint op, vec4 a, vec4 b, vec4 c)
+{
+    switch (op) {
+    case 1u:  return a;
+    case 2u:  return a * b;
+    case 3u:  return a + c;
+    case 4u:  return a * b + c;
+    case 5u:  return vec4(a.x * b.x + a.y * b.y + a.z * b.z);
+    case 6u:  return vec4(a.x * b.x + a.y * b.y + a.z * b.z + b.w);
+    case 7u:  return vec4(a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w);
+    case 8u:  return vec4(1.0, a.y * b.y, a.z, b.w);
+    case 9u:  return vec4(a.x < b.x ? a.x : b.x, a.y < b.y ? a.y : b.y,
+                          a.z < b.z ? a.z : b.z, a.w < b.w ? a.w : b.w);
+    case 10u: return vec4(a.x >= b.x ? a.x : b.x, a.y >= b.y ? a.y : b.y,
+                          a.z >= b.z ? a.z : b.z, a.w >= b.w ? a.w : b.w);
+    case 11u: return vec4(lessThan(a, b));
+    case 12u: return vec4(greaterThanEqual(a, b));
+    case 13u: a0 = int(floor(a.x + 0.001)); return a;
+    default:  return a;
+    }
+}
+
+vec4 ilu(uint op, vec4 c)
+{
+    float x = c.x;
+    switch (op) {
+    case 1u: return c;
+    case 2u: return vec4(x == 0.0 ? INF : 1.0 / x);
+    case 3u: {
+        float f = 1.0 / x;
+        if (abs(f) < 5.42101e-20) f = f < 0.0 ? -5.42101e-20 : 5.42101e-20;
+        if (abs(f) > 1.884467e19) f = f < 0.0 ? -1.884467e19 : 1.884467e19;
+        return vec4(f);
+    }
+    case 4u: return vec4(abs(x) == 0.0 ? INF : inversesqrt(abs(x)));
+    case 5u: {
+        float fl = floor(x);
+        return vec4(exp2(fl), x - fl, exp2(x), 1.0);
+    }
+    case 6u: {
+        float ax = abs(x);
+        if (ax == 0.0)
+            return vec4(-INF, 1.0, -INF, 1.0);
+        float e = floor(log2(ax));
+        return vec4(e, ax / exp2(e), log2(ax), 1.0);
+    }
+    case 7u: {
+        float nl = max(c.x, 0.0), nh = max(c.y, 0.0);
+        float p = clamp(c.w, -127.9961, 127.9961), sp;
+        if (nh == 0.0)
+            sp = p > 0.0 ? 0.0 : (p == 0.0 ? 1.0 : INF);
+        else
+            sp = pow(nh, p);
+        return vec4(1.0, nl, c.x > 0.0 ? sp : 0.0, 1.0);
+    }
+    default: return c;
+    }
+}
+
+/* The fog unit, per vertex (nv2a_pb_exec.c fog_factor). */
+float fog_factor(float d)
+{
+    uint mode = uint(u.fogp.y);
+    float px = u.fogp.z, py = u.fogp.w, f;
+    if (u.fogp.x == 0.0)
+        return 1.0;
+    if (mode == 0x800u || mode == 0x802u)
+        f = px + exp2(d * py * 16.0) - 1.5;
+    else if (mode == 0x801u || mode == 0x803u)
+        f = px + exp2(-d * d * py * py * 32.0) - 1.5;
+    else
+        f = px + d * py - 1.0;
+    if (mode == 0x802u || mode == 0x803u || mode == 0x804u)
+        f = abs(f);
+    if (isnan(f))
+        f = 1.0;
+    return clamp(f, 0.0, 1.0);
+}
+
+void main()
+{
+    uint vid = uint(gl_VertexIndex), n = uint(u.vp2.z);
+
+    for (int i = 0; i < 16; i++)
+        V[i] = fetch(i, vid);
+    for (int i = 0; i < 13; i++) {
+        R[i] = vec4(0.0);
+        O[i] = vec4(0.0);
+    }
+    O[3].w = O[4].w = 1.0;
+    O[9].w = O[10].w = O[11].w = O[12].w = 1.0;
+    a0 = 0;
+
+    for (uint s = 0u; s < n; s++) {
+        uvec4 w0 = kp.p[2u * s], w1 = kp.p[2u * s + 1u];
+        uint f = w0.x, op = f & 0xFu, iop = (f >> 4) & 0x7u;
+        vec4 a = vec4(0.0), b = vec4(0.0), c = vec4(0.0), mr = vec4(0.0), ir = vec4(0.0);
+
+        /* Both units read their sources before either writes. */
+        if ((f & (1u << 22)) != 0u) a = src(w0.z);
+        if ((f & (1u << 23)) != 0u) b = src(w0.w);
+        if ((f & (1u << 24)) != 0u) c = src(w1.x);
+        if (op != 0u)  mr = mac(op, a, b, c);
+        if (iop != 0u) ir = ilu(iop, c);
+
+        uint md = (w0.y >> 8) & 0xFFu, id = (w0.y >> 16) & 0xFFu;
+        if (md != 0u) put(R[md - 1u], mr, (f >> 8) & 0xFu);
+        if (id != 0u) put(R[id - 1u], ir, (f >> 12) & 0xFu);
+        uint om = (f >> 16) & 0xFu;
+        if (om != 0u && ((f >> 21) & 1u) != 0u) {    /* to o[] (c[] stays CPU) */
+            uint oa = w0.y & 0xFFu;
+            vec4 v = ((f >> 20) & 1u) != 0u ? ir : mr;
+            if (oa == 0u)       put(R[12], v, om);
+            else if (oa < 13u)  put(O[oa], v, om);
+        }
+    }
+
+    vec4 pos = R[12];
+    /* w == +0: a program that never divided by w (transform_vertex). */
+    if (pos.w == 0.0 && floatBitsToUint(pos.w) == 0u)
+        pos.w = 1.0;
+    pos.x *= u.vp.w;
+    pos.y *= u.vp2.x;
+    gl_ClipDistance[0] = pos.w - 1e-3;
+    gl_ClipDistance[1] = (pos.z - u.vp2.y) * pos.w;
+    gl_Position = vec4((pos.x * u.vp.x - 1.0) * pos.w, (pos.y * u.vp.y - 1.0) * pos.w,
+                       pos.z * u.vp.z * pos.w, pos.w);
+
+    v_d0 = clamp(O[3], 0.0, 1.0);
+    v_d1 = clamp(O[4], 0.0, 1.0);
+    v_fog = fog_factor(O[5].x);
+    v_t0 = O[9];
+    v_t1 = O[10];
+    v_t2 = O[11];
+    v_t3 = O[12];
+}
