+/* Raise interrupt status bits.
+ *
+ * Atomically, because the driver clears them from another thread: a plain
+ * |= that reads the register before an acknowledgement and writes it back
+ * after puts the acknowledged bit back, and the driver is handed the same
+ * WritebackDoneHead twice. */
+static void status_set(OhciController *hc, uint32_t bits)
+{
+    InterlockedOr((volatile LONG *)&hc->reg[HcInterruptStatus / 4], (LONG)bits);
+}
