+/* ---- Zeta surfaces as textures ------------------------------------- */
+
+/* A title that samples its depth buffer reads the zeta surface's memory as
+ * a colour texture: Conker's glow, every frame from the front end on, reads
+ * the 640x480 Z24S8 surface as LIN_R8G8B8A8. Read back for that, each frame
+ * waited for the GPU to finish the scene so far, converted 300 000 depths
+ * on the CPU, hashed them, decoded them again a texel at a time and uploaded
+ * the result -- most of the frame on a slower CPU, and a stall of whatever
+ * the GPU still had to do. The texture is made on the GPU from the depth
+ * image instead (shaders/zeta_pack.frag), which leaves guest memory as it
+ * was; a stage that reads it any other way still has it read back. */
+static VkPipelineCache s_pcache;
+static VkDescriptorSetLayout s_zp_dsl;
+static VkPipelineLayout s_zp_layout;
+static VkPipeline s_zp_pipe;
+static int s_zp_failed;
+
+static VkSampler sampler_get(int mag, int min, int mip, uint32_t au, uint32_t av);
+
+/* A full-screen pass: zeta_pack.vert's triangle, a fragment shader, one
+ * colour target of format cf, viewport and scissor dynamic. */
+static VkPipeline pass_pipeline(const uint32_t *fspv, size_t fsize, VkFormat cf,
+                                VkPipelineLayout layout)
+{
+    VkShaderModuleCreateInfo sm = { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+    VkShaderModule vs = VK_NULL_HANDLE, fs = VK_NULL_HANDLE;
+    VkPipelineShaderStageCreateInfo stages[2];
+    VkPipelineVertexInputStateCreateInfo vin = { VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+    VkPipelineInputAssemblyStateCreateInfo ia = { VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO };
+    VkPipelineViewportStateCreateInfo vp = { VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO };
+    VkPipelineRasterizationStateCreateInfo rs = { VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO };
+    VkPipelineMultisampleStateCreateInfo ms = { VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO };
+    VkPipelineColorBlendAttachmentState cba;
+    VkPipelineColorBlendStateCreateInfo cb = { VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO };
+    VkDynamicState dyn[2] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+    VkPipelineDynamicStateCreateInfo ds = { VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO };
+    VkPipelineRenderingCreateInfo ri = { VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO };
+    VkGraphicsPipelineCreateInfo gi = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO };
+    VkPipeline pipe = VK_NULL_HANDLE;
+
+    sm.codeSize = sizeof k_zpack_vert_spv;
+    sm.pCode = k_zpack_vert_spv;
+    if (vkCreateShaderModule(s_dev, &sm, NULL, &vs) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    sm.codeSize = fsize;
+    sm.pCode = fspv;
+    if (vkCreateShaderModule(s_dev, &sm, NULL, &fs) != VK_SUCCESS) {
+        vkDestroyShaderModule(s_dev, vs, NULL);
+        return VK_NULL_HANDLE;
+    }
+    memset(stages, 0, sizeof stages);
+    stages[0].sType = stages[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+    stages[0].module = vs;
+    stages[0].pName = "main";
+    stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+    stages[1].module = fs;
+    stages[1].pName = "main";
+    ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    vp.viewportCount = vp.scissorCount = 1;
+    rs.polygonMode = VK_POLYGON_MODE_FILL;
+    rs.cullMode = VK_CULL_MODE_NONE;
+    rs.lineWidth = 1.0f;
+    ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    memset(&cba, 0, sizeof cba);
+    cba.colorWriteMask = 0xF;
+    cb.attachmentCount = 1;
+    cb.pAttachments = &cba;
+    ds.dynamicStateCount = 2;
+    ds.pDynamicStates = dyn;
+    ri.colorAttachmentCount = 1;
+    ri.pColorAttachmentFormats = &cf;
+    gi.pNext = &ri;
+    gi.stageCount = 2;
+    gi.pStages = stages;
+    gi.pVertexInputState = &vin;
+    gi.pInputAssemblyState = &ia;
+    gi.pViewportState = &vp;
+    gi.pRasterizationState = &rs;
+    gi.pMultisampleState = &ms;
+    gi.pColorBlendState = &cb;
+    gi.pDynamicState = &ds;
+    gi.layout = layout;
+    if (vkCreateGraphicsPipelines(s_dev, s_pcache, 1, &gi, NULL, &pipe) != VK_SUCCESS)
+        pipe = VK_NULL_HANDLE;
+    vkDestroyShaderModule(s_dev, vs, NULL);
+    vkDestroyShaderModule(s_dev, fs, NULL);
+    return pipe;
+}
+
+/* A pass's layout: nimg combined image samplers at bindings 0.., pushed,
+ * and pc bytes of fragment push constants. */
+static VkPipelineLayout pass_layout(uint32_t nimg, uint32_t pc, VkDescriptorSetLayout *dsl)
+{
+    VkDescriptorSetLayoutBinding bind[2];
+    VkDescriptorSetLayoutCreateInfo dl = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+    VkPushConstantRange pcr = { VK_SHADER_STAGE_FRAGMENT_BIT, 0, pc };
+    VkPipelineLayoutCreateInfo pl = { VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+    VkPipelineLayout layout;
+    uint32_t i;
+
+    memset(bind, 0, sizeof bind);
+    for (i = 0; i < nimg && i < 2; i++) {
+        bind[i].binding = i;
+        bind[i].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+        bind[i].descriptorCount = 1;
+        bind[i].stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+    }
+    dl.flags = VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR;
+    dl.bindingCount = i;
+    dl.pBindings = bind;
+    if (vkCreateDescriptorSetLayout(s_dev, &dl, NULL, dsl) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    pl.setLayoutCount = 1;
+    pl.pSetLayouts = dsl;
+    pl.pushConstantRangeCount = 1;
+    pl.pPushConstantRanges = &pcr;
+    if (vkCreatePipelineLayout(s_dev, &pl, NULL, &layout) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    return layout;
+}
+
+/* Draw a full-screen pass into target (w x h): what it had stays where the
+ * shader discards. The caller has bound nothing; this binds everything. */
+static void pass_draw(VkImageView target, uint32_t w, uint32_t h, VkPipeline pipe,
+                      VkPipelineLayout layout, const VkDescriptorImageInfo *img,
+                      uint32_t nimg, const void *pc, uint32_t pcsize)
+{
+    VkRenderingInfo ri = { VK_STRUCTURE_TYPE_RENDERING_INFO };
+    VkRenderingAttachmentInfo ca = { VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO };
+    VkWriteDescriptorSet wr[2];
+    VkViewport vp;
+    VkRect2D sc;
+    VkCommandBuffer c;
+    uint32_t k;
+
+    end_rendering();
+    s_rt = NULL;
+    s_rt_z = NULL;
+    barrier_all();
+    ca.imageView = target;
+    ca.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+    ca.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+    ca.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    ri.renderArea.extent.width = w;
+    ri.renderArea.extent.height = h;
+    ri.layerCount = 1;
+    ri.colorAttachmentCount = 1;
+    ri.pColorAttachments = &ca;
+    c = cmd();
+    vkCmdBeginRendering(c, &ri);
+    vkCmdBindPipeline(c, VK_PIPELINE_BIND_POINT_GRAPHICS, pipe);
+    memset(&vp, 0, sizeof vp);
+    vp.width = (float)w;
+    vp.height = (float)h;
+    vp.maxDepth = 1.0f;
+    vkCmdSetViewport(c, 0, 1, &vp);
+    memset(&sc, 0, sizeof sc);
+    sc.extent.width = w;
+    sc.extent.height = h;
+    vkCmdSetScissor(c, 0, 1, &sc);
+    memset(wr, 0, sizeof wr);
+    for (k = 0; k < nimg && k < 2; k++) {
+        wr[k].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+        wr[k].dstBinding = k;
+        wr[k].descriptorCount = 1;
+        wr[k].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+        wr[k].pImageInfo = &img[k];
+    }
+    s_push_desc(c, VK_PIPELINE_BIND_POINT_GRAPHICS, layout, 0, k, wr);
+    vkCmdPushConstants(c, layout, VK_SHADER_STAGE_FRAGMENT_BIT, 0, pcsize, pc);
+    vkCmdDraw(c, 3, 1, 0, 0);
+    vkCmdEndRendering(c);
+    barrier_all();
+}
+
+static int zpack_pipeline(void)
+{
+    if (s_zp_pipe)
+        return 1;
+    if (s_zp_failed)
+        return 0;
+    s_zp_failed = 1;
+    s_zp_layout = pass_layout(2, 4, &s_zp_dsl);
+    if (s_zp_layout)
+        s_zp_pipe = pass_pipeline(k_zpack_frag_spv, sizeof k_zpack_frag_spv,
+                                  VK_FORMAT_B8G8R8A8_UNORM, s_zp_layout);
+    if (!s_zp_pipe) {
+        fprintf(stderr, "[VK] no depth-to-texture pipeline; sampled zeta surfaces are read back\n");
+        return 0;
+    }
+    s_zp_failed = 0;
+    return 1;
+}
+
+/* ---- One view of a surface's memory redrawn as another ------------- */
+
+static VkDescriptorSetLayout s_sa_dsl;
+static VkPipelineLayout s_sa_layout;
+static struct { VkFormat f; VkPipeline p; } s_sa_pipes[4];
+static int s_sa_npipes, s_sa_off = -1;
+
+typedef struct {
+    uint32_t dst_pitch, dst_mx, dst_my, dst_swz;
+    uint32_t src_pitch, src_mx, src_my, src_swz;
+    uint32_t src_w, src_h, bpp, sc;
+} SurfAliasPc;
+
+static VkPipeline surf_alias_pipeline(VkFormat f)
+{
+    VkPipeline p;
+    int i;
+    for (i = 0; i < s_sa_npipes; i++)
+        if (s_sa_pipes[i].f == f)
+            return s_sa_pipes[i].p;
+    if (s_sa_npipes == (int)(sizeof s_sa_pipes / sizeof s_sa_pipes[0]))
+        return VK_NULL_HANDLE;
+    if (!s_sa_layout)
+        s_sa_layout = pass_layout(1, sizeof(SurfAliasPc), &s_sa_dsl);
+    if (!s_sa_layout)
+        return VK_NULL_HANDLE;
+    p = pass_pipeline(k_salias_frag_spv, sizeof k_salias_frag_spv, f, s_sa_layout);
+    s_sa_pipes[s_sa_npipes].f = f;           /* a failure is remembered too */
+    s_sa_pipes[s_sa_npipes].p = p;
+    s_sa_npipes++;
+    if (!p)
+        fprintf(stderr, "[VK] no surface alias pipeline for format %d; aliased"
+                        " surfaces go through guest memory\n", (int)f);
+    return p;
+}
+
+/* dst takes what src drew, as dst's layout sees src's bytes: both start at
+ * the same address, have the same texel size and image format and the same
+ * render scale, and src covers all of dst. 0: not done, use guest memory. */
+static int surf_alias_gpu(Surf *dst, Surf *src)
+{
+    SurfAliasPc pc;
+    VkDescriptorImageInfo ii;
+    VkPipeline p;
+
+    if (s_sa_off < 0)
+        s_sa_off = getenv("RECOMP_VK_ALIAS_READBACK") != NULL;
+    if (s_sa_off || dst->va != src->va || dst->bpp != src->bpp || dst->sc != src->sc
+        || dst->color.fmt != src->color.fmt || surf_span(src) < surf_span(dst)
+        || (dst->swz_w && (dst->w & (dst->w - 1) || dst->h & (dst->h - 1)))
+        || (src->swz_w && (src->w & (src->w - 1) || src->h & (src->h - 1))))
+        return 0;
+    p = surf_alias_pipeline(dst->color.fmt);
+    if (!p)
+        return 0;
+    memset(&pc, 0, sizeof pc);
+    pc.dst_pitch = dst->pitch;
+    pc.dst_swz = dst->swz_w != 0;
+    if (pc.dst_swz)
+        xbox_swizzle_masks(dst->w, dst->h, &pc.dst_mx, &pc.dst_my);
+    pc.src_pitch = src->pitch;
+    pc.src_swz = src->swz_w != 0;
+    if (pc.src_swz)
+        xbox_swizzle_masks(src->w, src->h, &pc.src_mx, &pc.src_my);
+    if ((!pc.dst_swz && !pc.dst_pitch) || (!pc.src_swz && !pc.src_pitch))
+        return 0;
+    pc.src_w = src->w;
+    pc.src_h = src->h;
+    pc.bpp = dst->bpp;
+    pc.sc = dst->sc;
+    ii.sampler = sampler_get(0, 0, 0, 0, 0);
+    ii.imageView = src->color.view;
+    ii.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+    pass_draw(dst->color.view, dst->color.w, dst->color.h, p, s_sa_layout, &ii, 1,
+              &pc, sizeof pc);
+    return 1;
+}
+
+static VkImageView zeta_view(const Zeta *z, VkImageAspectFlags aspect)
+{
+    VkImageViewCreateInfo vi = { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+    VkImageView v;
+    vi.image = z->depth.image;
+    vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    vi.format = s_depth_fmt;
+    vi.subresourceRange.aspectMask = aspect;
+    vi.subresourceRange.levelCount = 1;
+    vi.subresourceRange.layerCount = 1;
+    return vkCreateImageView(s_dev, &vi, NULL, &v) == VK_SUCCESS ? v : VK_NULL_HANDLE;
+}
+
+/* The zeta surface a stage reads, if it reads one in a way the pass makes:
+ * the surface's own memory, pitch and dword layout. */
+static Zeta *zeta_source(const Nv2aStage *st)
+{
+    int i;
+    if (!s_zsample || st->normalized || st->cube || st->levels > 1
+        || (st->color != 0x41 && st->color != 0x12))
+        return NULL;
+    for (i = 0; i < VK_MAX_ZETAS; i++) {
+        Zeta *z = &s_zetas[i];
+        if (z->depth.image && z->va == st->offset && z->zfmt == 2
+            && z->pitch == st->pitch && st->width * 4 <= z->pitch
+            && st->width * z->sc <= z->depth.w && st->height * z->sc <= z->depth.h)
+            return z;
+    }
+    return NULL;
+}
+
