diff --git a/src/vulkan/shaders/surf_alias.frag b/src/vulkan/shaders/surf_alias.frag
new file mode 100644
index 0000000..d111ea1
--- /dev/null
+++ b/src/vulkan/shaders/surf_alias.frag
@@ -0,0 +1,59 @@
+#version 450
+/* One render target's image redrawn as another view of the same memory
+ * would see it (nv2a_vk.c, surf_alias_gpu): the same bytes in the other
+ * layout, linear (pitch) or swizzled (the NV2A's Morton order, from the
+ * masks xbox_swizzle_masks makes). Each target texel finds its byte offset
+ * in its own layout and takes the source texel stored at that offset.
+ * Pixels the source does not cover keep what the target had. A render
+ * scale above 1 maps whole guest pixels and keeps the position inside one. */
+
+layout(set = 0, binding = 0) uniform sampler2D u_src;
+layout(push_constant) uniform Pc {
+    uint dst_pitch, dst_mx, dst_my, dst_swz;   /* pitch in bytes; masks */
+    uint src_pitch, src_mx, src_my, src_swz;
+    uint src_w, src_h, bpp, sc;
+} pc;
+
+layout(location = 0) out vec4 o_color;
+
+uint deposit(uint v, uint mask)
+{
+    uint r = 0u, bit = 1u;
+    for (int i = 0; i < 32 && mask != 0u; i++) {
+        uint low = mask & (~mask + 1u);
+        if ((v & bit) != 0u) r |= low;
+        mask &= mask - 1u;
+        bit <<= 1;
+    }
+    return r;
+}
+
+uint extract(uint v, uint mask)
+{
+    uint r = 0u, bit = 1u;
+    for (int i = 0; i < 32 && mask != 0u; i++) {
+        uint low = mask & (~mask + 1u);
+        if ((v & low) != 0u) r |= bit;
+        mask &= mask - 1u;
+        bit <<= 1;
+    }
+    return r;
+}
+
+void main()
+{
+    uvec2 p = uvec2(gl_FragCoord.xy);
+    uvec2 g = p / pc.sc, sub = p % pc.sc;
+    uint off = pc.dst_swz != 0u ? (deposit(g.x, pc.dst_mx) | deposit(g.y, pc.dst_my)) * pc.bpp
+                                : g.y * pc.dst_pitch + g.x * pc.bpp;
+    uvec2 s;
+    if (pc.src_swz != 0u) {
+        uint m = off / pc.bpp;
+        s = uvec2(extract(m, pc.src_mx), extract(m, pc.src_my));
+    } else {
+        s = uvec2((off % pc.src_pitch) / pc.bpp, off / pc.src_pitch);
+    }
+    if (s.x >= pc.src_w || s.y >= pc.src_h)
+        discard;
+    o_color = texelFetch(u_src, ivec2(s * pc.sc + sub), 0);
+}
diff --git a/src/vulkan/shaders/zeta_pack.frag b/src/vulkan/shaders/zeta_pack.frag
new file mode 100644
index 0000000..f876fe5
--- /dev/null
+++ b/src/vulkan/shaders/zeta_pack.frag
@@ -0,0 +1,28 @@
+#version 450
+/* A depth/stencil image as the colour texture a title reads when it samples
+ * its zeta surface's memory (nv2a_vk.c, tex_from_zeta). The NV2A stores
+ * Z24S8 as one dword per pixel, depth << 8 | stencil; the texture format
+ * decides which byte lands in which channel, as the executor's decoder does:
+ *
+ *   mode 0, LIN_R8G8B8A8: A = stencil, R G B = depth from the top byte down
+ *   mode 1, LIN_A8R8G8B8: A R G = depth from the top byte down, B = stencil
+ *
+ * The target is B8G8R8A8_UNORM, so each byte is written as itself / 255. */
+
+layout(set = 0, binding = 0) uniform sampler2D u_depth;
+layout(set = 0, binding = 1) uniform usampler2D u_stencil;
+layout(push_constant) uniform Pc { int mode; } pc;
+
+layout(location = 0) out vec4 o_color;
+
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    float d = clamp(texelFetch(u_depth, p, 0).r, 0.0, 1.0);
+    uint d24 = uint(d * 16777215.0 + 0.5);
+    uint s = texelFetch(u_stencil, p, 0).r & 0xFFu;
+    vec4 b = vec4(float(d24 >> 16), float((d24 >> 8) & 0xFFu), float(d24 & 0xFFu),
+                  float(s)) / 255.0;
+    o_color = pc.mode == 0 ? vec4(b.x, b.y, b.z, b.w)     /* R G B A */
+                           : vec4(b.y, b.z, b.w, b.x);    /* R G B A */
+}
diff --git a/src/vulkan/shaders/zeta_pack.vert b/src/vulkan/shaders/zeta_pack.vert
new file mode 100644
index 0000000..99f962c
--- /dev/null
+++ b/src/vulkan/shaders/zeta_pack.vert
@@ -0,0 +1,8 @@
+#version 450
+/* One triangle over the whole target (zeta_pack.frag). */
+
+void main()
+{
+    vec2 p = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
