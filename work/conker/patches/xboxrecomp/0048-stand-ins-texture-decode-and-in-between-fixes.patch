+/* Whether slot's in-between variant is ready; asks for it if not. */
+static int vprog_blend_ready(uint32_t slot)
+{
+    int want = 0;
+    if (atomic_load(&s_vprogs[slot].bstate) == VPROG_READY + 1)
+        return 1;
+    if (s_jobs_up >= 0 && atomic_compare_exchange_strong(&s_vprogs[slot].bstate, &want, VPROG_QUEUED + 1))
+        job_push_vprog(slot | VSH_BLEND_BIT);
+    return 0;
