+/* A multiply-blended program draw (a projected shadow laid on the scene):
+ * its program, the constants, and each vertex as the CPU interpreter runs
+ * it -- inputs, oPos, oD0, oT0 -- so a fade the program computes per
+ * vertex can be checked against what the screen shows. */
+static void trace_vertices(FILE *f, const Nv2aProgramBatch *pb)
+{
+    uint32_t v, a, i, n = 0;
+
+    if (pb->program) {
+        char *g = nv2a_vk_vprog_glsl(pb->program, (int)pb->ninst, 0);
+        const char *m = g ? strstr(g, "#ifdef VSH_PROGRAM") : NULL;
+        const char *e = m ? strstr(m + 1, "#e") : NULL;
+        fprintf(f, "  program:\n%.*s\n", m && e ? (int)(e - m) : 6, m && e ? m : "(none)");
+        free(g);
+    }
+    if (pb->constants)
+        for (i = 0; i < 192; i++) {
+            const float *c = pb->constants[i];
+            if (c[0] != 0.0f || c[1] != 0.0f || c[2] != 0.0f || c[3] != 0.0f)
+                fprintf(f, "  c%u %g %g %g %g\n", i, c[0], c[1], c[2], c[3]);
+        }
+    for (a = 0; a < 16; a++)
+        if (pb->attr[a].data)
+            fprintf(f, "  attr %u stride %u type %u size %u\n", a, pb->attr[a].stride,
+                    pb->attr[a].type, pb->attr[a].size);
+    nv2a_vsh_prepare();
+    for (v = pb->min_index; v <= pb->max_index && n < 600; v++, n++) {
+        float in[NV2A_VSH_INPUTS][4];
+        Nv2aVshOutput o;
+        for (a = 0; a < 16; a++) {
+            const Nv2aAttrib *at = &pb->attr[a];
+            const uint8_t *p = at->data ? at->data + (size_t)v * at->stride : NULL;
+            memcpy(in[a], at->value, sizeof in[a]);
+            if (!p)
+                continue;
+            in[a][0] = in[a][1] = in[a][2] = 0.0f; in[a][3] = 1.0f;
+            for (i = 0; i < at->size && i < 4; i++) {
+                switch (at->type) {
+                case 0: in[a][i] = p[i == 3 ? 3 : 2 - i] / 255.0f; break;
+                case 1: in[a][i] = ((const int16_t *)p)[i] / 32767.0f; break;
+                case 2: memcpy(&in[a][i], p + 4 * i, 4); break;
+                case 4: in[a][i] = p[i] / 255.0f; break;
+                case 5: in[a][i] = ((const int16_t *)p)[i]; break;
+                default: in[a][i] = -999.0f; break;
+                }
+            }
+        }
+        memset(&o, 0, sizeof o);
+        if (!nv2a_vsh_run((const float (*)[4])in, &o))
+            break;
+        fprintf(f, "  v %u", v);
+        for (a = 0; a < 16; a++)
+            if (pb->attr[a].data)
+                fprintf(f, " in%u %g %g %g %g", a, in[a][0], in[a][1], in[a][2], in[a][3]);
+        fprintf(f, " | pos %g %g %g %g d0 %g %g %g %g t0 %g %g %g %g\n",
+                o.pos[0], o.pos[1], o.pos[2], o.pos[3], o.d0[0], o.d0[1], o.d0[2], o.d0[3],
+                o.tex[0][0], o.tex[0][1], o.tex[0][2], o.tex[0][3]);
+    }
+    if (pb->indices) {
+        fprintf(f, "  idx");
+        for (i = 0; i < pb->count; i++)
+            fprintf(f, " %u", pb->indices[i]);
+        fprintf(f, "\n");
+    }
+}
