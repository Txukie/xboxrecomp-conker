+        case 6: mr[0] = mr[1] = mr[2] = mr[3] = a[0]*b[0] + a[1]*b[1] + a[2]*b[2] + b[3]; break;
+        case 7: mr[0] = mr[1] = mr[2] = mr[3] = a[0]*b[0] + a[1]*b[1] + a[2]*b[2] + a[3]*b[3]; break;
