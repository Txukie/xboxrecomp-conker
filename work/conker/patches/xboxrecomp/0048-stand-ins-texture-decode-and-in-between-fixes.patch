+        case 9: for (k = 0; k < 4; k++) mr[k] = a[k] < b[k] ? a[k] : b[k]; break;
+        case 10: for (k = 0; k < 4; k++) mr[k] = a[k] >= b[k] ? a[k] : b[k]; break;
+        case 11: for (k = 0; k < 4; k++) mr[k] = a[k] < b[k]; break;
