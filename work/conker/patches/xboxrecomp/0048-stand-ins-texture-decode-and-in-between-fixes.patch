+/* Whether two draws put their first and last vertices in the same place:
+ * the same surface drawn twice. */
+static int rec_same_place(const RecFrame *F1, const Rec *a, const RecFrame *F2, const Rec *b)
+{
+    float pa[4], pb[4];
+    uint32_t e;
+    int k;
+
+    if (a->kind != 2 || b->kind != 2 || a->pb.count != b->pb.count)
+        return 0;
+    for (e = 0; e < 2; e++) {
+        uint32_t nth = e ? a->pb.count - 1 : 0;
+        if (!rec_vpos(F1, a, nth, pa) || !rec_vpos(F2, b, nth, pb))
+            return 0;
+        for (k = 0; k < 4; k++)
+            if (!(fabsf(pa[k] - pb[k]) <= 1e-3f * (1.0f + fabsf(pa[k]))))
+                return 0;
+    }
+    return 1;
