+    o[0] = o[1] = o[2] = 0.0f;
+    o[3] = 1.0f;
+    if (r->attr[i] == (size_t)-1) {
+        memcpy(o, at->value, 16);
+        return;
+    }
+    p = mem + r->attr[i] + (size_t)(vid - r->pb.min_index) * at->stride;
+    if (at->type == 0) {
+        memcpy(&v, p, 4);
+        o[0] = ((v >> 16) & 0xFF) / 255.0f;
+        o[1] = ((v >> 8) & 0xFF) / 255.0f;
+        o[2] = (v & 0xFF) / 255.0f;
+        o[3] = (v >> 24) / 255.0f;
+        return;
+    }
+    if (at->type == 6) {
+        memcpy(&v, p, 4);
+        o[0] = (float)((int32_t)(v << 21) >> 21) / 1023.0f;
+        o[1] = (float)((int32_t)(v << 10) >> 21) / 1023.0f;
+        o[2] = (float)((int32_t)v >> 22) / 511.0f;
+        return;
+    }
+    size = at->size < 4 ? at->size : 4;
+    for (k = 0; k < size; k++)
+        o[k] = rv_fetch1(p, at->type, k);
