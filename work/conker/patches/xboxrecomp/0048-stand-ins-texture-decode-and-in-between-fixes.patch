+/* A program draw of frame F into ns; with kb, the GPU runs the program on
+ * F's constants and on kb and blends the two by t (nv2a_vsh.vert
+ * VSH_BLEND): blending the constants instead put a vertex behind the eye in
+ * one frame at w near 0 in between, a spike across the screen. Until the
+ * program's variant is compiled, and in the interpreter, the constants are
+ * blended. */
+static void rec_draw_prog(const RecFrame *F, Rec *r, const Nv2aSurface *ns,
+                          const float (*kb)[4], float t)
+{
+    static float mixed[NV2A_VSH_CONSTANTS][4];
+    Nv2aProgramBatch b = r->pb;
+    uint32_t vsh = r->vsh;
+    int k;
+
+    b.pix.state = &r->rs;
+    b.pix.rc = &r->rc;
+    b.indices = (const uint32_t *)(F->mem + r->data);
+    b.program = (const uint32_t (*)[8])(F->mem + r->prog);
+    b.constants = (const float (*)[4])(F->mem + r->consts);
+    for (k = 0; k < 16; k++)
+        if (r->attr[k] != (size_t)-1)
+            b.attr[k].data = (const uint8_t *)((uintptr_t)(F->mem + r->attr[k])
