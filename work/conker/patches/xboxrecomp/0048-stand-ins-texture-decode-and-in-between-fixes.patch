+/* How far a draw's middle vertex lands from where it was, run with A's
+ * constants and then with B's, against the surface's size (1 off to the
+ * other side, or in front of the eye in one and behind it in the other).
+ * -1 when it cannot tell. `held`: each end held to two surfaces around it
+ * first -- near the eye a small step lands far out there. */
+static float rec_shift(const RecFrame *A, const Rec *r, const float *cb, int held)
+{
+    const uint32_t *ix = (const uint32_t *)(A->mem + r->data);
+    float V[16][4], pa[4], pb[4], size;
+    uint32_t vid;
+    int i;
+
+    if (!r->pb.count || !r->pb.ninst)
+        return -1.0f;
+    vid = ix[r->pb.count / 2];
+    if (vid < r->pb.min_index || vid > r->pb.max_index)
+        return -1.0f;
+    for (i = 0; i < 16; i++)
+        rv_fetch(r, A->mem, i, vid, V[i]);
+    if (!rv_run((const uint32_t (*)[8])(A->mem + r->prog), r->pb.ninst,
+                (const float (*)[4])(A->mem + r->consts), (const float (*)[4])V, pa)
+        || !rv_run((const uint32_t (*)[8])(A->mem + r->prog), r->pb.ninst,
+                   (const float (*)[4])cb, (const float (*)[4])V, pb))
+        return -1.0f;
+    if ((pa[3] > 0.0f) != (pb[3] > 0.0f))
+        return 1.0f;
+    if (!(pa[3] > 0.0f) || !(fabsf(pa[0]) < 1e5f) || !(fabsf(pb[0]) < 1e5f)
+        || !(fabsf(pa[1]) < 1e5f) || !(fabsf(pb[1]) < 1e5f))
+        return -1.0f;
+    size = (float)(r->ns.width > r->ns.height ? r->ns.width : r->ns.height);
+    if (size < 64.0f)
+        return -1.0f;
+    if (held) {
+        float w = (float)r->ns.width, h = (float)r->ns.height;
+        float ax = fminf(fmaxf(pa[0], -2.0f * w), 3.0f * w), ay = fminf(fmaxf(pa[1], -2.0f * h), 3.0f * h);
+        float bx = fminf(fmaxf(pb[0], -2.0f * w), 3.0f * w), by = fminf(fmaxf(pb[1], -2.0f * h), 3.0f * h);
+        return hypotf(bx - ax, by - ay) / size;
+    }
+    return hypotf(pb[0] - pa[0], pb[1] - pa[1]) / size;
+}
