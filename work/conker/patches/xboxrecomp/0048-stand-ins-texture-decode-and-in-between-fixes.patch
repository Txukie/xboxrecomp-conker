+/* Vertex `nth` of draw r (frame F) on the CPU: its oPos. 0 if it cannot. */
+static int rec_vpos(const RecFrame *F, const Rec *r, uint32_t nth, float pos[4])
+{
+    const uint32_t *ix = (const uint32_t *)(F->mem + r->data);
+    float V[16][4];
+    uint32_t vid;
+    int i;
+
+    if (!r->pb.count || !r->pb.ninst)
+        return 0;
+    vid = ix[nth < r->pb.count ? nth : r->pb.count - 1];
+    if (vid < r->pb.min_index || vid > r->pb.max_index)
+        return 0;
+    for (i = 0; i < 16; i++)
+        rv_fetch(r, F->mem, i, vid, V[i]);
+    return rv_run((const uint32_t (*)[8])(F->mem + r->prog), r->pb.ninst,
+                  (const float (*)[4])(F->mem + r->consts), (const float (*)[4])V, pos);
+}
