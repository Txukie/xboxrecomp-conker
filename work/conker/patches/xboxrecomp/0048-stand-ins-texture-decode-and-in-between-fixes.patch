diff --git a/src/vulkan/shaders/hole_fill.frag b/src/vulkan/shaders/hole_fill.frag
new file mode 100644
index 0000000..6fe16f3
--- /dev/null
+++ b/src/vulkan/shaders/hole_fill.frag
@@ -0,0 +1,26 @@
+#version 450
+/* An in-between frame's holes (nv2a_vk.c rec_holefill): where A's geometry,
+ * blended toward B, left the depth as it was cleared, B's colour and depth.
+ * Everything A drew stays. */
+
+layout(set = 0, binding = 0) uniform sampler2D s_bcol;   /* B's picture */
+layout(set = 0, binding = 1) uniform sampler2D s_bdep;   /* B's depth */
+layout(set = 0, binding = 2) uniform sampler2D s_cdep;   /* this frame's, so far */
+layout(push_constant) uniform P { float clear_at; } pc;  /* at or past: untouched */
+
+layout(location = 0) out vec4 o_color;
+
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    float bd = texelFetch(s_bdep, p, 0).r;
+    /* Empty in B as well (sky, a backdrop drawn without depth): not a hole,
+     * and B's picture there is its finished one -- with the glow its
+     * full-screen passes added, which this frame's own passes then add
+     * again (the sky over the training level's scarecrow, every second
+     * frame brighter). */
+    if (texelFetch(s_cdep, p, 0).r < pc.clear_at || bd >= pc.clear_at)
+        discard;
+    o_color = texelFetch(s_bcol, p, 0);
+    gl_FragDepth = bd;
+}
