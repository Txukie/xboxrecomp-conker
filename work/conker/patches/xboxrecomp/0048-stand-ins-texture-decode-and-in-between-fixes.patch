+        else
+            b.attr[k].data = NULL;
+    if (kb && t > 0.0f) {
+        if (!vsh)
+            vsh = vprog_for(b.program, b.ninst, 0);
+        if (vsh >= 2 && vprog_blend_ready(vsh - 2)) {
+            s_vsh_kb = kb;
+            s_vsh_t = t;
