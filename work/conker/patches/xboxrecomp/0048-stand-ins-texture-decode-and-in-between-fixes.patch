+/* ---- Draw trace (nv2a_vk_trace_arm) --------------------------------- */
+/* One frame's draws, armed from the game (the debug build's mark): from
+ * the next flip to the one after, every draw's state on a line of
+ * <path>.txt, and for those into a frame-sized surface the part of it
+ * RECOMP_VK_TRACE_BOX (fractions x0,y0,x1,y1) covers as it stood after the
+ * draw, into <path>.bin -- only those that changed it; without the box,
+ * the whole surface at a quarter of its size (a frame of 1700 draws fits,
+ * and a glare anywhere shows). The in-between
+ * frames drawn meanwhile are in it too (replay t). For what only one GPU
+ * draws (Berri's window on the Deck). */
+#define TRACE_BYTES (224u << 20)
+static char s_trace_path[1024];
+static atomic_int s_trace_arm;
+static int s_trace_on, s_trace_n;
+static float s_trace_rt;
+static Ring s_trace_buf;
+static VkDeviceSize s_trace_used;
+static FILE *s_trace_txt;
+typedef struct { VkDeviceSize off; uint32_t w, h, draw; uint32_t va; } TraceCrop;
+static TraceCrop s_trace_crop[4096];
+static Img s_trace_small;          /* the frame at a quarter, blitted (no box set) */
+static int s_trace_ncrop;
+
+void nv2a_vk_trace_arm(const char *path)
+{
+    if (atomic_load(&s_trace_arm))
+        return;
+    snprintf(s_trace_path, sizeof s_trace_path, "%s", path);
+    atomic_store(&s_trace_arm, 1);
+}
+
+static void trace_box(uint32_t w, uint32_t h, uint32_t *x0, uint32_t *y0, uint32_t *x1, uint32_t *y1)
+{
+    float b[4] = { 0.40f, 0.12f, 0.78f, 0.62f };
+    const char *e = getenv("RECOMP_VK_TRACE_BOX");
+    if (e)
+        sscanf(e, "%f,%f,%f,%f", &b[0], &b[1], &b[2], &b[3]);
+    *x0 = (uint32_t)(b[0] * w); *y0 = (uint32_t)(b[1] * h);
+    *x1 = (uint32_t)(b[2] * w); *y1 = (uint32_t)(b[3] * h);
+    if (*x1 > w) *x1 = w;
+    if (*y1 > h) *y1 = h;
+    if (*x0 >= *x1) *x0 = *x1 ? *x1 - 1 : 0;
+    if (*y0 >= *y1) *y0 = *y1 ? *y1 - 1 : 0;
+}
+
+/* At a flip: start an armed trace, or write out the one running. */
+static void trace_flip(void)
+{
+    static long at = -2;
+    if (at == -2) {      /* RECOMP_VK_TRACE_AT=flip,path: armed without a mark */
+        const char *e = getenv("RECOMP_VK_TRACE_AT"), *c = e ? strchr(e, ',') : NULL;
+        at = c ? atol(e) : -1;
+        if (c)
+            snprintf(s_trace_path, sizeof s_trace_path, "%s", c + 1);
+    }
+    if (at >= 0 && (long)s_frame == at && !atomic_load(&s_trace_arm))
+        atomic_store(&s_trace_arm, 1);
+    if (s_trace_on) {
+        FILE *f;
+        char p[1100];
+        int i;
+        /* The copies done: a full flush waits for the submission in flight
+         * only when it has something to submit itself -- with the last
+         * draws handed over by a soft flush it returned at once, and the
+         * crops were read before the GPU wrote them (white or stale). */
+        cmd();
+        flush();
+        snprintf(p, sizeof p, "%s.bin", s_trace_path);
+        f = fopen(p, "wb");
+        for (i = 0; f && i < s_trace_ncrop; i++) {
+            const TraceCrop *c = &s_trace_crop[i];
+            uint32_t hdr[4] = { c->draw, c->w, c->h, c->va };
+            size_t n = (size_t)c->w * c->h * 4;
+            int k, same = 0;
+            for (k = i - 1; k >= 0; k--)   /* the same surface's previous crop */
+                if (s_trace_crop[k].va == c->va && s_trace_crop[k].w == c->w && s_trace_crop[k].h == c->h
+                    && !((s_trace_crop[k].draw ^ c->draw) & 0x80000000u)) {
+                    same = !memcmp(s_trace_buf.map + s_trace_crop[k].off, s_trace_buf.map + c->off, n);
+                    break;
+                }
+            if (same)
+                continue;
+            fwrite(hdr, sizeof hdr, 1, f);
+            fwrite(s_trace_buf.map + c->off, 1, n, f);
+        }
+        if (f)
+            fclose(f);
+        if (s_trace_txt) {
+            fprintf(s_trace_txt, "end: %d draws, %d crops\n", s_trace_n, s_trace_ncrop);
+            fclose(s_trace_txt);
+        }
+        s_trace_txt = NULL;
+        fprintf(stderr, "[VK] trace: %d draws, %d crops -> %s.txt/.bin\n", s_trace_n, s_trace_ncrop, s_trace_path);
+        s_trace_on = 0;
+        atomic_store(&s_trace_arm, 0);
+        return;
+    }
+    if (atomic_load(&s_trace_arm) == 1) {
+        char p[1100];
+        atomic_store(&s_trace_arm, 2);     /* running: a second mark waits */
+        if (!s_trace_buf.buf && !ring_create(&s_trace_buf, TRACE_BYTES, VK_BUFFER_USAGE_TRANSFER_DST_BIT)) {
+            fprintf(stderr, "[VK] trace: no buffer\n");
+            atomic_store(&s_trace_arm, 0);
+            return;
+        }
+        snprintf(p, sizeof p, "%s.txt", s_trace_path);
+        s_trace_txt = fopen(p, "w");
+        s_trace_on = 1;
+        s_trace_n = s_trace_ncrop = 0;
+        s_trace_used = 0;
+        if (s_trace_txt)
+            fprintf(s_trace_txt, "trace from flip %u; msaa %u\n", s_frame, s_msaa);
+    }
+}
