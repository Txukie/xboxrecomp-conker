+static void rv_fetch(const Rec *r, const uint8_t *mem, int i, uint32_t vid, float o[4])
+{
+    const Nv2aAttrib *at = &r->pb.attr[i];
+    const uint8_t *p;
+    uint32_t k, size, v;
