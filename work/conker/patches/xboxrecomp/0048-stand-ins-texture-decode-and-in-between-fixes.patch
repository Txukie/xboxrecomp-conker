+static void rec_underlay(const Nv2aSurface *ns, const Nv2aRenderState *rs,
+                         const RecFrame *B, const Rec *zc)
+{
+    Surf *src = B->shown_va ? title_surf(B->shown_va) : NULL, *d;
+
+    if (!src || src->version != B->shown_ver) {
+        s_is_under[src ? 1 : 2]++;
+        return;
+    }
+    d = surf_get(ns, ns->clip_y + ns->height);
+    if (!d || !d->color.image || d->color.w != src->color.w || d->color.h != src->color.h
+        || d->color.fmt != src->color.fmt) {
+        s_is_under[3]++;
+        return;
+    }
+    s_is_under[0]++;
+    blit(src->color.image, d->color.image, src->color.w, src->color.h,
+         d->color.w, d->color.h, VK_IMAGE_ASPECT_COLOR_BIT, VK_FILTER_NEAREST);
+    d->version = ++s_writes;
+    /* And depth a step short of the far value A cleared to, when the holes
+     * cannot be filled (rec_holefill): what tests depth after the geometry
+     * (a sky drawn last) then leaves B's picture alone. */
+    if (zc) {
+        uint32_t zs = zc->zs;
+        if (zc->rs.zeta_format == 1 && (zs & 0xFFFF) > 0x8000)
+            vk_clear(ns, &zc->rs, 1, 0, (zs & 0xFFFF0000u) | ((zs & 0xFFFF) - 2));
