+/* Whether A's draw, its vertices moved by B's constants instead of its own,
+ * moves as one thing. Paired with a draw that only shares its program and
+ * most constants -- one plant of a field for another, a skinned palette of
+ * bones from another instance -- some vertices jump and others stay, and
+ * halfway between the two they are spikes across the screen (the training
+ * level's white shards). A few vertices on the CPU: no blend when how far
+ * they moved differs, among them, by more than the draw spans. */
+static int rec_coherent(const RecFrame *A, const Rec *r, const float *cb)
+{
+    const uint32_t (*pw)[8] = (const uint32_t (*)[8])(A->mem + r->prog);
+    const float (*ca)[4] = (const float (*)[4])(A->mem + r->consts);
+    const uint32_t *ix = (const uint32_t *)(A->mem + r->data);
+    float pa[8][4], pb[8][4], V[16][4], mx = 0, my = 0, spread = 0, ext = 0;
+    uint32_t j, n = 0, step;
+    int i;
+
+    if (!r->pb.count || !r->pb.ninst)
+        return 1;
+    step = r->pb.count / 8 ? r->pb.count / 8 : 1;
+    for (j = 0; j < r->pb.count && n < 8; j += step) {
+        uint32_t vid = ix[j];
+        if (vid < r->pb.min_index || vid > r->pb.max_index)
+            continue;
+        for (i = 0; i < 16; i++)
+            rv_fetch(r, A->mem, i, vid, V[i]);
+        if (!rv_run(pw, r->pb.ninst, ca, (const float (*)[4])V, pa[n])
+            || !rv_run(pw, r->pb.ninst, (const float (*)[4])cb, (const float (*)[4])V, pb[n]))
+            return 1;
+        if (!(pa[n][3] > 0.0f) || !(pb[n][3] > 0.0f)
+            || !(fabsf(pa[n][0]) < 1e5f) || !(fabsf(pb[n][0]) < 1e5f)
+            || !(fabsf(pa[n][1]) < 1e5f) || !(fabsf(pb[n][1]) < 1e5f))
+            continue;                      /* behind the eye, or off at infinity */
+        mx += pb[n][0] - pa[n][0];
+        my += pb[n][1] - pa[n][1];
+        n++;
+    }
+    if (n < 2)
+        return 1;
+    mx /= (float)n;
+    my /= (float)n;
+    for (j = 0; j < n; j++) {
+        uint32_t q;
+        float dx = pb[j][0] - pa[j][0] - mx, dy = pb[j][1] - pa[j][1] - my, d = sqrtf(dx * dx + dy * dy);
+        if (d > spread) spread = d;
+        for (q = 0; q < j; q++) {
+            float ea = hypotf(pa[j][0] - pa[q][0], pa[j][1] - pa[q][1]);
+            float eb = hypotf(pb[j][0] - pb[q][0], pb[j][1] - pb[q][1]);
+            if (ea > ext) ext = ea;
+            if (eb > ext) ext = eb;
+        }
+    }
+    return spread <= 0.75f * ext + 8.0f;
+}
