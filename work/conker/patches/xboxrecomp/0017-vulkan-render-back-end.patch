--- /dev/null
+++ b/src/vulkan/CMakeLists.txt
@@ -0,0 +1,36 @@
+# NV2A render back end on Vulkan (nv2a_vk.h). Optional: built when the Vulkan
+# headers and loader and a GLSL compiler (glslc) are found; a game project
+# links xbox_nv2a_vk and calls nv2a_vk_install() to use it.
+find_package(Vulkan QUIET)
+find_program(XBOXRECOMP_GLSLC glslc HINTS ENV VULKAN_SDK PATH_SUFFIXES bin)
+
+if(NOT Vulkan_FOUND OR NOT XBOXRECOMP_GLSLC)
+    message(STATUS "xboxrecomp: Vulkan back end off (needs the Vulkan SDK and glslc)")
+    return()
+endif()
+
+set(_vk_gen "${CMAKE_CURRENT_BINARY_DIR}/shaders")
+set(_vk_spv)
+foreach(_shader nv2a.vert nv2a.frag)
+    add_custom_command(
+        OUTPUT "${_vk_gen}/${_shader}.inc"
+        COMMAND "${CMAKE_COMMAND}" -E make_directory "${_vk_gen}"
+        COMMAND "${XBOXRECOMP_GLSLC}" -O --target-env=vulkan1.3 -mfmt=c
+                -o "${_vk_gen}/${_shader}.inc"
+                "${CMAKE_CURRENT_SOURCE_DIR}/shaders/${_shader}"
+        DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/shaders/${_shader}"
+        COMMENT "glslc ${_shader}"
+        VERBATIM)
+    list(APPEND _vk_spv "${_vk_gen}/${_shader}.inc")
+endforeach()
+
+add_library(xbox_nv2a_vk STATIC nv2a_vk.c ${_vk_spv})
+target_include_directories(xbox_nv2a_vk
+    PUBLIC  ${CMAKE_CURRENT_SOURCE_DIR}
+    PRIVATE ${_vk_gen})
+# The executor's back-end interface comes from xbox_kernel. Only its headers
+# here: linking it would take xbox_kernel out of the umbrella target's
+# archive group (GNU ld), and the kernel needs the libraries in that group.
+target_include_directories(xbox_nv2a_vk PRIVATE
+    $<TARGET_PROPERTY:xbox_kernel,INTERFACE_INCLUDE_DIRECTORIES>)
+target_link_libraries(xbox_nv2a_vk PUBLIC Vulkan::Vulkan)
diff --git a/src/vulkan/nv2a_vk.c b/src/vulkan/nv2a_vk.c
