+/* Where the JUMP that ended the last top-level segment pointed, or 0: the
+ * ring's wrap, for the caller to follow (nv2a_pb_scan_segment). */
+static uint32_t s_seg_jump;
+
 static uint32_t pb_walk_segment(uint32_t va, uint32_t end_va, int in_call,
                                 uint32_t *jumps, uint32_t *unknown)
 {
@@ -481,8 +485,10 @@ static uint32_t pb_walk_segment(uint32_t va, uint32_t end_va, int in_call,
             uint32_t target = (w & 3u) == 1u ? (w & 0xFFFFFFFCu)
                                              : (w & 0x1FFFFFFCu);
             (*jumps)++;
-            if (!in_call)
+            if (!in_call) {
+                s_seg_jump = 0x80000000u | (target & 0x0FFFFFFFu);
                 break;                        /* the ring: a jump ends it */
+            }
             va = 0x80000000u | (target & 0x0FFFFFFFu);
             end_va = va + 0x400000u;
             continue;
@@ -524,12 +530,15 @@ static uint32_t pb_walk_segment(uint32_t va, uint32_t end_va, int in_call,
     return words;
 }
 
-void nv2a_pb_scan_segment(uint32_t start_va, uint32_t end_va)
+/* Returns the guest VA the JUMP ending the segment pointed to, or 0 when the
+ * segment ran to end_va without one. */
+uint32_t nv2a_pb_scan_segment(uint32_t start_va, uint32_t end_va)
 {
     uint32_t words, jumps = 0, unknown = 0;
 
+    s_seg_jump = 0;
     if (!pb_walk_enabled() || end_va <= start_va)
-        return;
+        return 0;
     if (end_va - start_va > 0x400000u)        /* a sane single-frame bound */
         end_va = start_va + 0x400000u;
 
@@ -543,4 +552,5 @@ void nv2a_pb_scan_segment(uint32_t start_va, uint32_t end_va)
     s_tot_unknown += unknown;
     s_tot_jumps += jumps;
     s_tot_segments++;
+    return s_seg_jump;
 }
