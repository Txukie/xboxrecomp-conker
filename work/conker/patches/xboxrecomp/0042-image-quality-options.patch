new file mode 100644
index 0000000..c87771b
--- /dev/null
+++ b/src/vulkan/embed_bin.cmake
@@ -0,0 +1,6 @@
+# A binary file as a C array: cmake -DIN=<file> -DOUT=<header> -DNAME=<symbol>
+# -P embed_bin.cmake
+file(READ "${IN}" _hex HEX)
+string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
+string(REGEX REPLACE "((0x..,){24})" "\\1\n" _bytes "${_bytes}")
+file(WRITE "${OUT}" "static const unsigned char ${NAME}[] = {\n${_bytes}\n};\n")
