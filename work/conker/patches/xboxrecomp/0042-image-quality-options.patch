diff --git a/src/vulkan/shaders/fsr_easu.frag b/src/vulkan/shaders/fsr_easu.frag
new file mode 100644
index 0000000..725542f
--- /dev/null
+++ b/src/vulkan/shaders/fsr_easu.frag
@@ -0,0 +1,25 @@
+#version 450
+/* FSR 1 upscaling (third_party/fsr, AMD FidelityFX), the scalar path: the
+ * frame from its size (pc.size.xy) to the window's (pc.size.zw). */
+layout(set = 0, binding = 0) uniform sampler2D u_src;
+layout(push_constant) uniform Pc { vec4 size; } pc;
+layout(location = 0) out vec4 o_color;
+
+#define A_GPU 1
+#define A_GLSL 1
+#include "third_party/fsr/ffx_a.h"
+#define FSR_EASU_F 1
+AF4 FsrEasuRF(AF2 p) { return textureGather(u_src, p, 0); }
+AF4 FsrEasuGF(AF2 p) { return textureGather(u_src, p, 1); }
+AF4 FsrEasuBF(AF2 p) { return textureGather(u_src, p, 2); }
+#include "third_party/fsr/ffx_fsr1.h"
+
+void main()
+{
+    AU4 c0, c1, c2, c3;
+    AF3 c;
+    FsrEasuCon(c0, c1, c2, c3, pc.size.x, pc.size.y, pc.size.x, pc.size.y,
+               pc.size.z, pc.size.w);
+    FsrEasuF(c, AU2(gl_FragCoord.xy), c0, c1, c2, c3);
+    o_color = vec4(c, 1.0);
+}
diff --git a/src/vulkan/shaders/fsr_rcas.frag b/src/vulkan/shaders/fsr_rcas.frag
new file mode 100644
index 0000000..d2e900c
--- /dev/null
+++ b/src/vulkan/shaders/fsr_rcas.frag
@@ -0,0 +1,26 @@
+#version 450
+/* FSR 1 sharpening (RCAS) of the upscaled frame; pc.sharp in stops below
+ * the most (0). */
+layout(set = 0, binding = 0) uniform sampler2D u_src;
+layout(push_constant) uniform Pc { float sharp; } pc;
+layout(location = 0) out vec4 o_color;
+
+#define A_GPU 1
+#define A_GLSL 1
+#include "third_party/fsr/ffx_a.h"
+#define FSR_RCAS_F 1
+AF4 FsrRcasLoadF(ASU2 p)
+{
+    return texelFetch(u_src, clamp(p, ASU2(0), textureSize(u_src, 0) - 1), 0);
+}
+void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
+#include "third_party/fsr/ffx_fsr1.h"
+
+void main()
+{
+    AU4 con;
+    AF3 c;
+    FsrRcasCon(con, pc.sharp);
+    FsrRcasF(c.r, c.g, c.b, AU2(gl_FragCoord.xy), con);
+    o_color = vec4(c, 1.0);
+}
diff --git a/src/vulkan/shaders/post_copy.frag b/src/vulkan/shaders/post_copy.frag
new file mode 100644
index 0000000..6633bd7
--- /dev/null
+++ b/src/vulkan/shaders/post_copy.frag
@@ -0,0 +1,12 @@
+#version 450
+/* A texel per pixel from another image of the same size (nv2a_vk.c): the
+ * frame shown into the image post-processing starts from, and a surface into
+ * its multisampled image, where each pixel's samples all take its value. */
+
+layout(set = 0, binding = 0) uniform sampler2D u_src;
+layout(location = 0) out vec4 o_color;
+
+void main()
+{
+    o_color = texelFetch(u_src, ivec2(gl_FragCoord.xy), 0);
+}
diff --git a/src/vulkan/shaders/smaa_blend.frag b/src/vulkan/shaders/smaa_blend.frag
new file mode 100644
index 0000000..b63fabe
--- /dev/null
+++ b/src/vulkan/shaders/smaa_blend.frag
@@ -0,0 +1,14 @@
+#version 450
+/* SMAA pass 3: each pixel blended with its neighbours by the weights. */
+#include "smaa_common.glsl"
+
+layout(set = 0, binding = 0) uniform sampler2D u_color;
+layout(set = 0, binding = 1) uniform sampler2D u_weights;
+
+void main()
+{
+    vec2 tc = smaa_texcoord();
+    vec4 off;
+    SMAANeighborhoodBlendingVS(tc, off);
+    o_color = vec4(SMAANeighborhoodBlendingPS(tc, off, u_color, u_weights).rgb, 1.0);
+}
diff --git a/src/vulkan/shaders/smaa_common.glsl b/src/vulkan/shaders/smaa_common.glsl
new file mode 100644
index 0000000..4a4057c
--- /dev/null
+++ b/src/vulkan/shaders/smaa_common.glsl
@@ -0,0 +1,16 @@
+/* SMAA (third_party/smaa, Jimenez et al.) for nv2a_vk.c's post-processing:
+ * the three passes run as full-screen fragment passes, so what SMAA puts in
+ * its vertex shaders is worked out per pixel. Vulkan's texture coordinates
+ * run down the image as Direct3D's do: no flip. */
+#define SMAA_GLSL_4
+#define SMAA_PRESET_HIGH
+layout(push_constant) uniform Pc { vec4 metrics; } pc;  /* 1/w, 1/h, w, h */
+#define SMAA_RT_METRICS pc.metrics
+#include "third_party/smaa/SMAA.hlsl"
+
+layout(location = 0) out vec4 o_color;
+
+vec2 smaa_texcoord()
+{
+    return gl_FragCoord.xy * pc.metrics.xy;
+}
diff --git a/src/vulkan/shaders/smaa_edges.frag b/src/vulkan/shaders/smaa_edges.frag
new file mode 100644
index 0000000..3b33944
--- /dev/null
+++ b/src/vulkan/shaders/smaa_edges.frag
@@ -0,0 +1,14 @@
+#version 450
+/* SMAA pass 1: luma edges. Pixels with none are discarded, over a target
+ * cleared to no edges. */
+#include "smaa_common.glsl"
+
+layout(set = 0, binding = 0) uniform sampler2D u_color;
+
+void main()
+{
+    vec2 tc = smaa_texcoord();
+    vec4 off[3];
+    SMAAEdgeDetectionVS(tc, off);
+    o_color = vec4(SMAALumaEdgeDetectionPS(tc, off, u_color), 0.0, 0.0);
+}
diff --git a/src/vulkan/shaders/smaa_weights.frag b/src/vulkan/shaders/smaa_weights.frag
new file mode 100644
index 0000000..062769c
--- /dev/null
+++ b/src/vulkan/shaders/smaa_weights.frag
@@ -0,0 +1,17 @@
+#version 450
+/* SMAA pass 2: blending weights from the edges and SMAA's precomputed area
+ * and search textures. */
+#include "smaa_common.glsl"
+
+layout(set = 0, binding = 0) uniform sampler2D u_edges;
+layout(set = 0, binding = 1) uniform sampler2D u_area;
+layout(set = 0, binding = 2) uniform sampler2D u_search;
+
+void main()
+{
+    vec2 tc = smaa_texcoord(), pix;
+    vec4 off[3];
+    SMAABlendingWeightCalculationVS(tc, pix, off);
+    o_color = SMAABlendingWeightCalculationPS(tc, pix, off, u_edges, u_area, u_search,
+                                              vec4(0.0));
+}
