+/* The console's language, as a title reads it (XGetLanguage): 1 English,
+ * 2 Japanese, 3 German, 4 French, 5 Spanish, 6 Italian. Set before the title
+ * starts: titles read it once. */
+static ULONG s_xbox_language = 1;
+
+void xbox_SetLanguage(unsigned long language)
+{
+    s_xbox_language = (ULONG)language;
+}
