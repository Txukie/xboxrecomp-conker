diff --git a/tools/recomp/test_x87_stack_pointer.py b/tools/recomp/test_x87_stack_pointer.py
new file mode 100644
index 0000000..1a448a7
--- /dev/null
+++ b/tools/recomp/test_x87_stack_pointer.py
@@ -0,0 +1,48 @@
+import unittest
+from .disasm import Instruction, Operand
+from .lifter import Lifter
+
+
+def _lift(mnemonic, op_str='', operands=()):
+    instruction = Instruction(0, 2, mnemonic, op_str, '')
+    instruction.operands = list(operands)
+    return '\n'.join(Lifter().lift_instruction(instruction))
+
+
+class X87StackPointerTest(unittest.TestCase):
+    """fincstp/fdecstp move TOP and nothing else.
+
+    Conker's scale-rotate-translate builder parks a product below the stack
+    with fincstp and reads it back as st(6) and st(5). Lifted as a no-op,
+    every later st(i) named the wrong register and the front end's camera
+    came out degenerate (tools.recomp.fpdiff fincstp_park runs the sequence
+    against the CPU).
+    """
+
+    def test_fincstp_increments_top_without_popping(self):
+        code = _lift('fincstp')
+        self.assertIn('g_fp_top = (g_fp_top + 1u) & 7u;', code)
+        self.assertNotIn('FPU:', code)
+
+    def test_fdecstp_decrements_top(self):
+        code = _lift('fdecstp')
+        self.assertIn('g_fp_top = (g_fp_top + 7u) & 7u;', code)
+        self.assertNotIn('FPU:', code)
+
+    def test_ffree_keeps_top_and_ffreep_pops(self):
+        reg = [Operand(type='reg', reg='st(1)')]
+        ffree = _lift('ffree', 'st(1)', reg)
+        self.assertNotIn('g_fp_top', ffree)
+        self.assertNotIn('fp_pop', ffree)
+        self.assertNotIn('FPU:', ffree)
+        self.assertIn('fp_pop();', _lift('ffreep', 'st(1)', reg))
+
+    def test_fxtract_replaces_st0_and_pushes(self):
+        code = _lift('fxtract')
+        self.assertIn('frexp(', code)
+        self.assertIn('fp_top() = _e; fp_push(_s);', code)
+        self.assertNotIn('FPU:', code)
+
+
+if __name__ == '__main__':
+    unittest.main()
