+/* Overlay folders on the game directory (xbox_path_set_overlays). */
+static char s_overlay[XBOX_PATH_MAX_OVERLAYS][MAX_PATH];
+static int  s_overlay_count;
+
+void xbox_path_set_overlays(const char* const* dirs, int count)
+{
+    int i, n = 0;
+    for (i = 0; i < count && n < XBOX_PATH_MAX_OVERLAYS; i++) {
+        size_t len;
+        if (!dirs[i] || !dirs[i][0])
+            continue;
+        snprintf(s_overlay[n], MAX_PATH, "%s", dirs[i]);
+        len = strlen(s_overlay[n]);
+        while (len > 1 && (s_overlay[n][len - 1] == '/' || s_overlay[n][len - 1] == '\\'))
+            s_overlay[n][--len] = '\0';
+        xbox_log(XBOX_LOG_INFO, XBOX_LOG_PATH, "Overlay %d: %s", n, s_overlay[n]);
+        n++;
+    }
+    s_overlay_count = n;
+}
