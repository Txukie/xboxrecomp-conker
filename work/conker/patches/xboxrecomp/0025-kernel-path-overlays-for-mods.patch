+/*
+ * Overlay folders on the game directory (mods): a file a title opens from the
+ * game directory (D:, \Device\CdRom0) is taken from the first overlay that
+ * has it, at the same relative path (case folded as for the game directory).
+ * Only existing files are redirected; folders, listings and new files stay
+ * the game directory's. dirs[0] wins over dirs[1] and so on. Call before the
+ * title runs; at most XBOX_PATH_MAX_OVERLAYS are kept.
+ */
+#define XBOX_PATH_MAX_OVERLAYS 16
+void xbox_path_set_overlays(const char* const* dirs, int count);
+
