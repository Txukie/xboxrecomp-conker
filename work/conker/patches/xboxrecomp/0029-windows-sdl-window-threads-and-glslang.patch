diff --git a/src/vulkan/c11_threads.h b/src/vulkan/c11_threads.h
new file mode 100644
index 0000000..b86b878
--- /dev/null
+++ b/src/vulkan/c11_threads.h
@@ -0,0 +1,73 @@
+/*
+ * C11 <threads.h>, or on Windows the part of it nv2a_vk.c uses, over Win32:
+ * MinGW-w64's C runtime has no <threads.h> (MSVC's has it since 17.8).
+ * Plain mutexes are SRW locks, which need no destroy; a thread is a
+ * CreateThread whose handle detach closes.
+ */
+#ifndef XBOXRECOMP_C11_THREADS_H
+#define XBOXRECOMP_C11_THREADS_H
+
+#if !defined(_WIN32) || (defined(_MSC_VER) && !defined(__clang__))
+#include <threads.h>
+#else
+#include <windows.h>
+#include <time.h>
+
+enum { thrd_success = 0, thrd_error = 2 };
+enum { mtx_plain = 0 };
+
+typedef SRWLOCK mtx_t;
+typedef CONDITION_VARIABLE cnd_t;
+typedef HANDLE thrd_t;
+typedef int (*thrd_start_t)(void *);
+
+static inline int mtx_init(mtx_t *m, int type)
+{
+    (void)type;
+    InitializeSRWLock(m);
+    return thrd_success;
+}
+static inline int mtx_lock(mtx_t *m) { AcquireSRWLockExclusive(m); return thrd_success; }
+static inline int mtx_unlock(mtx_t *m) { ReleaseSRWLockExclusive(m); return thrd_success; }
+
+static inline int cnd_init(cnd_t *c) { InitializeConditionVariable(c); return thrd_success; }
+static inline int cnd_signal(cnd_t *c) { WakeConditionVariable(c); return thrd_success; }
+static inline int cnd_wait(cnd_t *c, mtx_t *m)
+{
+    return SleepConditionVariableSRW(c, m, INFINITE, 0) ? thrd_success : thrd_error;
+}
+
+struct c11_thrd_start { thrd_start_t fn; void *arg; };
+
+static DWORD WINAPI c11_thrd_trampoline(LPVOID p)
+{
+    struct c11_thrd_start s = *(struct c11_thrd_start *)p;
+    HeapFree(GetProcessHeap(), 0, p);
+    return (DWORD)s.fn(s.arg);
+}
+
+static inline int thrd_create(thrd_t *t, thrd_start_t fn, void *arg)
+{
+    struct c11_thrd_start *s = HeapAlloc(GetProcessHeap(), 0, sizeof *s);
+    if (!s)
+        return thrd_error;
+    s->fn = fn;
+    s->arg = arg;
+    *t = CreateThread(NULL, 0, c11_thrd_trampoline, s, 0, NULL);
+    if (!*t) {
+        HeapFree(GetProcessHeap(), 0, s);
+        return thrd_error;
+    }
+    return thrd_success;
+}
+static inline int thrd_detach(thrd_t t) { return CloseHandle(t) ? thrd_success : thrd_error; }
+
+static inline int thrd_sleep(const struct timespec *d, struct timespec *rem)
+{
+    (void)rem;
+    Sleep((DWORD)(d->tv_sec * 1000 + (d->tv_nsec + 999999) / 1000000));
+    return 0;
+}
+#endif
+
+#endif /* XBOXRECOMP_C11_THREADS_H */
