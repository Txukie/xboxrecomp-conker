--- a/src/apu/apu_state.h
+++ b/src/apu/apu_state.h
@@ -431,6 +431,9 @@ typedef struct MCPXAPUVPState {
     float sample_buf[NUM_SAMPLES_PER_FRAME][2];
     volatile uint8_t voice_locked[MCPX_HW_MAX_VOICES];
     volatile LONG voice_spin[MCPX_HW_MAX_VOICES];   /* see voice_spin_lock */
+    /* Idle voices already reported to the front end this round (see
