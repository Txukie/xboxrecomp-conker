diff --git a/src/kernel/kernel_bridge.c b/src/kernel/kernel_bridge.c
index e1f177c..d2076e4 100644
--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -3393,9 +3393,11 @@ int xbox_DpcDrainHere(void)
  * VOID KeInitializeDpc(PKDPC Dpc, PKDEFERRED_ROUTINE DeferredRoutine,
  *                       PVOID DeferredContext)
  *
- * Initializes a DPC object. The Xbox KDPC structure is 32 bytes.
+ * Initializes a DPC object. The Xbox KDPC structure is 0x1C (28) bytes.
  * We zero it and set the routine and context pointers.
  */
+#define XBOX_KDPC_SIZE 0x1Cu   /* sizeof(KDPC) on the guest */
+
 static void bridge_KeInitializeDpc(void)
 {
     uint32_t dpc_va = STACK_ARG(0);
@@ -3406,13 +3408,18 @@ static void bridge_KeInitializeDpc(void)
      * makes this memset write through NULL inside the bridge. The export
      * returns void, so refusing is doing nothing -- which is what the real
      * kernel does with an object it cannot write. */
-    if (!bridge_buf_ok(dpc_va, 32, "KeInitializeDpc")) {
+    if (!bridge_buf_ok(dpc_va, XBOX_KDPC_SIZE, "KeInitializeDpc")) {
         g_eax = 0;
         return;
     }
 
-    /* Zero the structure (32 bytes) */
-    memset(XBOX_TO_NATIVE(dpc_va), 0, 32);
+    /* Zero the structure: Type, Inserted, Padding, DpcListEntry,
+     * DeferredRoutine, DeferredContext, SystemArgument1/2 -- 0x1C bytes on
+     * the 32-bit guest. This used to clear 32, and the 4 bytes past the end
+     * belong to the caller: Conker keeps its audio object pointer right
+     * after its KDPC (0x0075F11C), stores it, then initialises the DPC, and
+     * the overrun nulled it; the DPC then ran on garbage and faulted. */
+    memset(XBOX_TO_NATIVE(dpc_va), 0, XBOX_KDPC_SIZE);
 
     /* Set Type (0x13 = DpcObject) and fields */
     BRIDGE_MEM16(dpc_va + 0) = 0x13;   /* Type */
