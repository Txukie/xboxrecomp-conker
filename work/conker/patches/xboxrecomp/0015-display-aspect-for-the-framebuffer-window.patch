diff --git a/src/video/display_aspect.h b/src/video/display_aspect.h
new file mode 100644
--- /dev/null
+++ b/src/video/display_aspect.h
@@ -0,0 +1,43 @@
+/* The shape the framebuffer window shows the frame at.
+ *
+ * Every presenter letterboxed the guest's framebuffer to the framebuffer's
+ * own shape: 640x480 at 4:3. A title rendering for a wide display -- natively
+ * anamorphic, or with its projection widened by the project, Hor+ -- still
+ * renders 640x480, and wants that frame stretched to 16:9 instead.
+ * RECOMP_DISPLAY_ASPECT names the shape: "16:9", "21:9", "4:3" or a ratio
+ * such as 1.7778. Unset (or unparsable), the frame keeps its own. */
+#ifndef XBOX_DISPLAY_ASPECT_H
+#define XBOX_DISPLAY_ASPECT_H
+
+#include <stdint.h>
+#include <stdlib.h>
+
+/* Width over height, or 0 for "the frame's own". Read once. */
+static inline double xbox_DisplayAspect(void)
+{
+    static double aspect = -1.0;
+    if (aspect < 0.0) {
+        const char *e = getenv("RECOMP_DISPLAY_ASPECT");
+        char *end = NULL;
+        double a = 0.0;
+        if (e && *e) {
+            a = strtod(e, &end);
+            if (end && *end == ':') {
+                double b = strtod(end + 1, NULL);
+                a = b > 0.0 ? a / b : 0.0;
+            }
+        }
+        aspect = a > 0.25 && a < 8.0 ? a : 0.0;
+    }
+    return aspect;
+}
+
+/* The width a frame w x h is shown at for its height (w itself unless a
+ * display aspect is set). */
+static inline uint32_t xbox_DisplayWidth(uint32_t w, uint32_t h)
+{
+    double a = xbox_DisplayAspect();
+    return a > 0.0 ? (uint32_t)(h * a + 0.5) : w;
+}
+
+#endif
