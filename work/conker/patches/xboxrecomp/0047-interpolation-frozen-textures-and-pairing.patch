+/* RECOMP_VK_VERBOSE: every 600 presents, how evenly they came -- the time
+ * between one and the next, as a frame-time graph shows it. */
+static void pace_note(void)
+{
+    static int on = -1, n;
+    static uint64_t last;
+    static float iv[600];
+    uint64_t now = SDL_GetPerformanceCounter(), f = SDL_GetPerformanceFrequency();
+    if (on < 0) {
+        const char *e = getenv("RECOMP_VK_VERBOSE");
+        on = e && *e && *e != '0';
+    }
+    if (!on)
+        return;
+    if (last) {
+        float ms = (float)((double)(now - last) * 1000.0 / (double)f);
+        if (ms < 200.0f)
+            iv[n++] = ms;
+    }
+    last = now;
+    if (n == 600) {
+        float sum = 0, sq = 0, a[600], mean;
+        int i, j, over = 0;
+        for (i = 0; i < n; i++) {
+            sum += iv[i];
+            a[i] = iv[i];
+        }
+        mean = sum / n;
+        for (i = 0; i < n; i++) {
+            sq += (iv[i] - mean) * (iv[i] - mean);
+            over += iv[i] > mean * 1.5f;
+        }
+        for (i = 1; i < n; i++)       /* small: insertion sort */
+            for (j = i; j > 0 && a[j] < a[j - 1]; j--) {
+                float t = a[j]; a[j] = a[j - 1]; a[j - 1] = t;
+            }
+        fprintf(stderr, "[VK] window: presents every %.2f ms, sd %.2f, 5%% %.2f 95%% %.2f,"
+                        " %d over 1.5x\n", mean, sqrtf(sq / n), a[n / 20], a[n - n / 20 - 1], over);
+        n = 0;
+    }
+}
