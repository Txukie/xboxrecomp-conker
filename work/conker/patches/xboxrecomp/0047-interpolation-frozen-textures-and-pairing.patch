+/* Until the performance counter reaches `due`: sleeping, then yielding for
+ * the last stretch (a sleep can overshoot by a millisecond). At most 50 ms,
+ * whatever the request. */
+static void wait_until(uint64_t due)
+{
+    uint64_t f = SDL_GetPerformanceFrequency(), now = SDL_GetPerformanceCounter();
+    uint64_t cap = now + f / 20;
+    if (due > cap)
+        due = cap;
+    while (now < due) {
+        uint64_t left_us = (due - now) * 1000000u / f;
+        if (left_us > 2000)
+            SDL_Delay((Uint32)((left_us - 1500) / 1000));
+        else
+            SDL_Delay(0);
+        now = SDL_GetPerformanceCounter();
+    }
+}
