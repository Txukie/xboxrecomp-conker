+/* FATX and the DVD's file system ignore case; a POSIX host does not. Conker
+ * asks for D:\dvddata\audio\dsp\dspimage.bin, which the disc spells
+ * Audio\dsp, and the open failed with "path not found".
+ *
+ * So when the translated path does not exist, walk it below `fixed` (the
+ * host base, which is left alone) one component at a time and take the
+ * directory entry that matches ignoring case. An exact match always wins,
+ * and the first component with no match ends the walk: the rest stays as
+ * the title wrote it, so creating something new still works. Costs nothing
+ * on a hit, one readdir per wrong-case component on a miss. */
+static void fold_path_case(char *path, size_t fixed)
+{
+    struct stat st;
+    char *p = path + fixed;
+
+    if (stat(path, &st) == 0)
+        return;
+    while (*p == '/')
+        p++;
+    while (*p) {
+        char *end = strchr(p, '/');
+        size_t len = end ? (size_t)(end - p) : strlen(p);
+        char saved = end ? *end : '\0';
+        int exists;
+
+        if (end)
+            *end = '\0';
+        exists = stat(path, &st) == 0;
+        if (!exists) {
+            /* p[-1] is the '/' before this component. */
+            DIR *d;
+            struct dirent *de;
+            int found = 0;
+
+            p[-1] = '\0';
+            d = opendir(p - 1 == path ? "/" : path);
+            p[-1] = '/';
+            if (d) {
+                while ((de = readdir(d)) != NULL) {
+                    if (strlen(de->d_name) == len && strncasecmp(de->d_name, p, len) == 0) {
+                        memcpy(p, de->d_name, len);
+                        found = 1;
+                        break;
+                    }
+                }
+                closedir(d);
+            }
+            if (!found) {
+                if (end)
+                    *end = saved;
+                return;
+            }
+        }
+        if (!end)
+            return;
+        *end = saved;
+        p = end + 1;
+    }
+}
