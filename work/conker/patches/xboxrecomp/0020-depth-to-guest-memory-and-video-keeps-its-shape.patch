+/* RECOMP_FB_WINDOW_SHOT=<prefix>: while <prefix>.req exists, each presented
+ * window image -- scaled, with its bars, as the player sees it -- is written
+ * to <prefix>NNNN.bmp. It shows what the window does to a frame, which the
+ * framebuffer dumps (RECOMP_FB_DUMP) cannot; with SDL_VIDEODRIVER=offscreen
+ * it works without a display. */
+static void window_shot(SDL_Renderer *ren)
+{
+    static const char *prefix = (const char *)-1;
+    static unsigned seq;
+    char path[512];
+    FILE *f;
+    int w, h;
+    SDL_Surface *sf;
+
+    if (prefix == (const char *)-1)
+        prefix = getenv("RECOMP_FB_WINDOW_SHOT");
+    if (!prefix || !*prefix)
+        return;
+    snprintf(path, sizeof path, "%s.req", prefix);
+    if (!(f = fopen(path, "rb")))
+        return;
+    fclose(f);
+    if (SDL_GetRendererOutputSize(ren, &w, &h) != 0)
+        return;
+    sf = SDL_CreateRGBSurfaceWithFormat(0, w, h, 32, SDL_PIXELFORMAT_ARGB8888);
+    if (!sf)
+        return;
+    if (SDL_RenderReadPixels(ren, NULL, SDL_PIXELFORMAT_ARGB8888, sf->pixels, sf->pitch) == 0) {
+        snprintf(path, sizeof path, "%s%04u.bmp", prefix, seq++);
+        SDL_SaveBMP(sf, path);
+    }
+    SDL_FreeSurface(sf);
+}
