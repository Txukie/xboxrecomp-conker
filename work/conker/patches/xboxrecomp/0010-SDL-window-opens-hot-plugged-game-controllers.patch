+/* A controller came or went (SDL_CONTROLLERDEVICEADDED / REMOVED, from the
+ * framebuffer window's event loop). SDL also reports the controllers that
+ * were plugged in before it started this way, so this is what opens them
+ * when the window owns SDL: nothing else calls xbox_InputInit then. A
+ * detached pad is closed so its slot can be taken again. */
+void xbox_InputControllersChanged(void)
+{
+    for (int i = 0; i < XBOX_MAX_CONTROLLERS; i++)
+        if (g_pads[i] && !SDL_GameControllerGetAttached(g_pads[i])) {
+            fprintf(stderr, "  [INPUT] controller %d removed\n", i);
+            SDL_GameControllerClose(g_pads[i]);
+            g_pads[i] = NULL;
+            g_controller_connected[i] = FALSE;
+        }
+    open_controllers();
+}
