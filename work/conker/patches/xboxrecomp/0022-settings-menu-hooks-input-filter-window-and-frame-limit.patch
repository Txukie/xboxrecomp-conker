+/* The input filter (xbox_InputSetFilter) on the report as the title will get
+ * it, scripted and synthetic presses included: once, here. */
+static void report_filter(int pad, uint8_t *out)
+{
+    XBOX_INPUT_STATE st;
+    int16_t ax[4];
+    int i;
+
+    memset(&st, 0, sizeof st);
+    st.Gamepad.wButtons = (WORD)(out[2] | out[3] << 8);
+    for (i = 0; i < 8; i++)
+        st.Gamepad.bAnalogButtons[i] = out[4 + i];
+    memcpy(ax, &out[12], sizeof ax);
+    st.Gamepad.sThumbLX = ax[0];
+    st.Gamepad.sThumbLY = ax[1];
+    st.Gamepad.sThumbRX = ax[2];
+    st.Gamepad.sThumbRY = ax[3];
+    xbox_InputFilterState((DWORD)pad, &st, 1);
+    out[2] = (uint8_t)(st.Gamepad.wButtons & 0xFF);
+    out[3] = (uint8_t)(st.Gamepad.wButtons >> 8);
+    for (i = 0; i < 8; i++)
+        out[4 + i] = st.Gamepad.bAnalogButtons[i];
+    ax[0] = st.Gamepad.sThumbLX;
+    ax[1] = st.Gamepad.sThumbLY;
+    ax[2] = st.Gamepad.sThumbRX;
+    ax[3] = st.Gamepad.sThumbRY;
+    memcpy(&out[12], ax, sizeof ax);
+}
