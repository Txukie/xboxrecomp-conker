+static volatile int s_req_mode = -1, s_req_w, s_req_h, s_req_vsync = -1;
+static volatile unsigned s_req_gen;
+static int s_res[64][2];
+static volatile int s_nres;
+static volatile int s_desk_w, s_desk_h;
+
+static void wake_main_loop(void)
+{
+    if (__atomic_load_n(&s_running, __ATOMIC_SEQ_CST)
+            && !__atomic_exchange_n(&s_wake_pending, 1, __ATOMIC_ACQ_REL)) {
+        SDL_Event ev;
+        memset(&ev, 0, sizeof ev);
+        ev.type = s_frame_event;
+        if (SDL_PushEvent(&ev) <= 0)
+            __atomic_store_n(&s_wake_pending, 0, __ATOMIC_RELEASE);
+    }
+}
