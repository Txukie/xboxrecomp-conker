+void xbox_WindowSetMode(int mode, int width, int height)
+{
+    s_req_w = width;
+    s_req_h = height;
+    s_req_mode = mode;
+    __atomic_add_fetch(&s_req_gen, 1, __ATOMIC_SEQ_CST);
+    wake_main_loop();
+}
+
+void xbox_WindowSetVsync(int on)
+{
+    s_req_vsync = on ? 1 : 0;
+    __atomic_add_fetch(&s_req_gen, 1, __ATOMIC_SEQ_CST);
+    wake_main_loop();
