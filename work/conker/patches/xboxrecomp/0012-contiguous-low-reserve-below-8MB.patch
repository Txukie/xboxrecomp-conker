+              "a request limited to the low 8 MB still fits", d);
 
         hi = xbox_ContiguousAllocEx(0x10000, 0x10000, 0x02800000u, 0x02FFFFFFu);
         snprintf(d, sizeof d, "got 0x%08X", hi);
