+/* NV2A vertex programs translated to GLSL, compiled at run time.
+ *
+ * nv2a_vsh.vert interprets a program: it reads each instruction from a
+ * uniform block and indexes the registers with what it read. A GPU cannot
+ * keep such arrays in registers by index, so every register of the vertex
+ * stays live and the shader takes all the registers there are (192 on
+ * RDNA, with 56 KB of code): few vertices run at a time, and on the Steam
+ * Deck that interpreter was most of the GPU's frame. Translated, each
+ * instruction becomes one line with constant indices.
+ *
+ * The translation is nv2a_vsh.vert itself, with VSH_PROGRAM defined: the
+ * program's lines replace the interpreter loop and call the same mac() and
+ * ilu(), with the opcode a constant, so the two cannot drift apart.
+ *
+ * GLSL to SPIR-V is glslang's, through its C interface, linked statically
+ * where the build finds it; without it (and on Windows, for now) every
+ * program stays in the interpreter. */
+#include "nv2a_vk_vprog.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if defined(XBOXRECOMP_VK_GLSLANG) && !defined(_WIN32)
+#include <math.h>
+#include <glslang/Include/glslang_c_interface.h>
+#include <glslang/Public/resource_limits_c.h>
+#define VPROG_COMPILER 1
+#endif
+
+#include "nv2a_vsh.vert.txt.inc"   /* s_vsh_template: the shader's source */
+
+/* ---- Translation ---------------------------------------------------- */
+
+typedef struct { char *p; size_t len, cap; } Text;
+
+static void put(Text *t, const char *fmt, ...)
+{
+    va_list ap;
+    int n;
+
+    for (;;) {
+        va_start(ap, fmt);
+        n = vsnprintf(t->p + t->len, t->cap - t->len, fmt, ap);
+        va_end(ap);
+        if (n < 0)
+            return;
+        if ((size_t)n < t->cap - t->len)
+            break;
+        t->cap = t->cap * 2 + (size_t)n;
+        t->p = realloc(t->p, t->cap);
+    }
+    t->len += (size_t)n;
+}
+
+/* A source operand, as src() in the shader reads it. */
+static void put_src(Text *t, uint32_t w)
+{
+    static const char xyzw[] = "xyzw";
+    uint32_t kind = w & 0xFu, idx = (w >> 4) & 0x1Fu, ci = w >> 18, k;
+    char sw[6] = ".";
+
+    if ((w >> 9) & 1u)
+        put(t, "-");
+    if (kind == 0u)
+        put(t, idx < 13u ? "R[%u]" : "vec4(0.0)", idx);
+    else if (kind == 1u)
+        put(t, "R[12]");
+    else if (kind == 2u)
+        put(t, idx < 16u ? "V[%u]" : "vec4(0.0)", idx);
+    else if (kind == 3u)
+        put(t, "kc.c[%u]", ci < 192u ? ci : 0u);
+    else
+        put(t, "kc.c[(%u + a0) < 0 || (%u + a0) >= 192 ? 0 : %u + a0]", ci, ci, ci);
+    for (k = 0; k < 4; k++)
+        sw[1 + k] = xyzw[(w >> (10 + 2 * k)) & 3u];
+    if (strcmp(sw, ".xyzw"))
+        put(t, "%s", sw);
+}
+
+/* A masked write, as put() in the shader does it. */
+static void put_write(Text *t, const char *dst, const char *v, uint32_t m)
+{
+    char mk[5];
+    int n = 0;
+
+    if (m & 8u) mk[n++] = 'x';
+    if (m & 4u) mk[n++] = 'y';
+    if (m & 2u) mk[n++] = 'z';
+    if (m & 1u) mk[n++] = 'w';
+    mk[n] = 0;
+    if (n)
+        put(t, " %s.%s = %s.%s;", dst, mk, v, mk);
+}
+
+char *nv2a_vk_vprog_glsl(const uint32_t (*prog)[8], int n)
+{
+    static const char marker[] = "    VSH_PROGRAM\n";
+    const char *at = strstr(s_vsh_template, marker), *nl = strchr(s_vsh_template, '\n');
+    Text body = { malloc(16384), 0, 16384 }, out;
+    uint32_t inputs = 0;
+    int i, k;
+
+    if (!at || !nl || !body.p)
+        return NULL;
+    body.p[0] = 0;
+    for (i = 0; i < n; i++) {
+        const uint32_t *w = prog[i];
+        uint32_t f = w[0], op = f & 0xFu, iop = (f >> 4) & 0x7u;
+        uint32_t md = (w[1] >> 8) & 0xFFu, id = (w[1] >> 16) & 0xFFu;
+        uint32_t om = (f >> 16) & 0xFu, oa = w[1] & 0xFFu;
+        char dst[16];
+
+        /* Both units read their sources before either writes. */
+        put(&body, "    {");
+        for (k = 0; k < 3; k++) {
+            put(&body, " vec4 %c = ", "abc"[k]);
+            if (f & (1u << (22 + k))) {
+                put_src(&body, w[2 + k]);
+                if ((w[2 + k] & 0xFu) == 2u && ((w[2 + k] >> 4) & 0x1Fu) < 16u)
+                    inputs |= 1u << ((w[2 + k] >> 4) & 0x1Fu);
+            } else {
+                put(&body, "vec4(0.0)");
+            }
+            put(&body, ";");
+        }
+        if (op)
+            put(&body, " vec4 mr = mac(%uu, a, b, c);", op);
+        else
+            put(&body, " vec4 mr = vec4(0.0);");
+        if (iop)
+            put(&body, " vec4 ir = ilu(%uu, c);", iop);
+        else
+            put(&body, " vec4 ir = vec4(0.0);");
+        if (md != 0u && md <= 13u) {
+            snprintf(dst, sizeof dst, "R[%u]", md - 1u);
+            put_write(&body, dst, "mr", (f >> 8) & 0xFu);
+        }
+        if (id != 0u && id <= 13u) {
+            snprintf(dst, sizeof dst, "R[%u]", id - 1u);
+            put_write(&body, dst, "ir", (f >> 12) & 0xFu);
+        }
+        if (om != 0u && ((f >> 21) & 1u) && oa < 13u) {   /* to o[] (c[] stays CPU) */
+            snprintf(dst, sizeof dst, oa ? "O[%u]" : "R[12]", oa);
+            put_write(&body, dst, ((f >> 20) & 1u) ? "ir" : "mr", om);
+        }
+        put(&body, " }\n");
+    }
+
+    out.cap = strlen(s_vsh_template) + body.len + 128;
+    out.p = malloc(out.cap);
+    out.len = 0;
+    if (!out.p) {
+        free(body.p);
+        return NULL;
+    }
+    put(&out, "%.*s", (int)(nl + 1 - s_vsh_template), s_vsh_template);   /* #version */
+    put(&out, "#define VSH_PROGRAM\n#define VSH_INPUTS 0x%Xu\n", inputs);
+    put(&out, "%.*s", (int)(at - (nl + 1)), nl + 1);
+    put(&out, "%s", body.p);
+    put(&out, "%s", at + strlen(marker));
+    free(body.p);
+    return out.p;
+}
+
+/* ---- Compilation ---------------------------------------------------- */
+
+#ifdef VPROG_COMPILER
+#ifdef __GLIBC__
+/* glslang folds constant sinh() and cosh(), and a glibc of 2.44 or later
+ * links them as their 2.44 versions: the binary would then refuse to start
+ * on an older one (SteamOS has 2.43), for two functions no vertex program
+ * uses. These keep the requirement where the rest of the binary has it. */
+double cosh(double x)
+{
+    double e = exp(x);
+    return (e + 1.0 / e) * 0.5;
+}
+
+double sinh(double x)
+{
+    double e = exp(x);
+    return (e - 1.0 / e) * 0.5;
+}
+#endif
+
+uint32_t *nv2a_vk_vprog_compile(const uint32_t (*prog)[8], int n, size_t *words)
+{
+    glslang_input_t in;
+    glslang_shader_t *sh;
+    glslang_program_t *pr = NULL;
+    uint32_t *spv = NULL;
+    char *src;
+    int msgs = GLSLANG_MSG_SPV_RULES_BIT | GLSLANG_MSG_VULKAN_RULES_BIT;
+    static int ready;   /* glslang set up: 0 not yet, 1 yes, -1 failed */
+
+    if (!ready)
+        ready = glslang_initialize_process() ? 1 : -1;
+    if (ready < 0 || !(src = nv2a_vk_vprog_glsl(prog, n)))
+        return NULL;
+    memset(&in, 0, sizeof in);
+    in.language = GLSLANG_SOURCE_GLSL;
+    in.stage = GLSLANG_STAGE_VERTEX;
+    in.client = GLSLANG_CLIENT_VULKAN;
+    in.client_version = GLSLANG_TARGET_VULKAN_1_3;
+    in.target_language = GLSLANG_TARGET_SPV;
+    in.target_language_version = GLSLANG_TARGET_SPV_1_6;
+    in.code = src;
+    in.default_version = 450;
+    in.default_profile = GLSLANG_NO_PROFILE;
+    in.messages = (glslang_messages_t)msgs;
+    in.resource = glslang_default_resource();
+    sh = glslang_shader_create(&in);
+    if (!sh)
+        goto out;
+    if (!glslang_shader_preprocess(sh, &in) || !glslang_shader_parse(sh, &in)) {
+        fprintf(stderr, "[VK] vertex program: %s\n", glslang_shader_get_info_log(sh));
+        goto out;
+    }
+    pr = glslang_program_create();
+    glslang_program_add_shader(pr, sh);
+    if (!glslang_program_link(pr, msgs)) {
+        fprintf(stderr, "[VK] vertex program: %s\n", glslang_program_get_info_log(pr));
+        goto out;
+    }
+    glslang_program_SPIRV_generate(pr, GLSLANG_STAGE_VERTEX);
+    *words = glslang_program_SPIRV_get_size(pr);
+    if (*words && (spv = malloc(*words * 4)))
+        glslang_program_SPIRV_get(pr, spv);
+out:
+    if (pr)
+        glslang_program_delete(pr);
+    if (sh)
+        glslang_shader_delete(sh);
+    free(src);
+    return spv;
+}
+#else
+uint32_t *nv2a_vk_vprog_compile(const uint32_t (*prog)[8], int n, size_t *words)
+{
+    (void)prog;
+    (void)n;
+    (void)words;
+    return NULL;
+}
+#endif
