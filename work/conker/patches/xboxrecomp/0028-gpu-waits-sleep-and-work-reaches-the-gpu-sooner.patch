+            && (buf = malloc((size_t)size)) && fread(buf, 1, (size_t)size, f) != (size_t)size)
+            size = 0;
+        fclose(f);
+    }
+    if (buf && size >= 12 && !memcmp(buf, k_pl_magic, 8)
+        && (memcpy(&ks, buf + 8, 4), ks == sizeof(PipeKey))) {
+        for (at = 12; at + 8 + sizeof(PipeKey) <= (size_t)size;) {
+            uint32_t n, check;
+            PipeKey k;
+            const uint32_t (*w)[8];
+            size_t len;
+
+            memcpy(&n, buf + at, 4);
+            if (n > NV2A_VSH_SLOTS_VK)
+                break;
+            len = 4 + sizeof k + (size_t)n * 32 + 4;
+            if (at + len > (size_t)size)
+                break;
+            memcpy(&k, buf + at + 4, sizeof k);
+            w = (const uint32_t (*)[8])(buf + at + 4 + sizeof k);
+            memcpy(&check, buf + at + len - 4, 4);
+            if (check != (uint32_t)pl_hash(&k, n, n ? w : NULL) || (n ? k.vsh != 2 : k.vsh != 0))
+                break;
+            at += len;
+            if (!pl_note(pl_hash(&k, n, n ? w : NULL)))
+                continue;
+            if (s_pre_n == cap) {
+                PipeRec *g = realloc(s_pre, (cap = cap ? cap * 2 : 256) * sizeof *g);
+                if (!g)
+                    break;
+                s_pre = g;
+            }
+            s_pre[s_pre_n].k = k;
+            s_pre[s_pre_n].n = n;
+            s_pre[s_pre_n].words = NULL;
+            if (n && !(s_pre[s_pre_n].words = malloc((size_t)n * 32)))
+                continue;
+            if (n)
+                memcpy(s_pre[s_pre_n].words, w, (size_t)n * 32);
+            s_pre_n++;
+        }
+    }
+    free(buf);
+
+    snprintf(tmp, sizeof tmp, "%s.tmp", path);
+    if ((f = fopen(tmp, "wb"))) {
+        uint32_t i;
+        ks = sizeof(PipeKey);
+        fwrite(k_pl_magic, 8, 1, f);
+        fwrite(&ks, 4, 1, f);
+        for (i = 0; i < s_pre_n; i++)
+            pl_write(f, &s_pre[i].k, s_pre[i].n, (const uint32_t (*)[8])s_pre[i].words);
+        if (fclose(f) == 0) {
+            remove(path);   /* Windows' rename does not replace */
+            rename(tmp, path);
+        }
+    }
+    s_pl_file = fopen(path, "ab");
+    timespec_get(&s_pre_t0, TIME_UTC);
+    fprintf(stderr, "[VK] pipeline list %s: %u pipelines to build\n", path, s_pre_n);
+}
