+
+/* The PipeKey vsh for a program batch's program. */
+static uint32_t vprog_for(const uint32_t (*prog)[8], uint32_t n)
+{
+    int added, slot;
+
+    if (!atomic_load(&s_vprog_on) || s_jobs_up < 0)
+        return 1;
+    mtx_lock(&s_pipe_mtx);
+    slot = vprog_slot_locked(prog, n, &added);
+    mtx_unlock(&s_pipe_mtx);
+    if (slot < 0)
+        return 1;
+    if (added)
+        job_push_vprog((uint32_t)slot);
+    return atomic_load(&s_vprogs[slot].state) == VPROG_READY ? 2 + (uint32_t)slot : 1;
+}
+
+/* ---- Pipeline list file --------------------------------------------- */
+
+/* Header, then records: n (program instructions, 0 for none), the key (vsh
+ * 0, or 2 with a program), the program, and a check word of all that. A
+ * record cut short by a crash fails its check and ends the list. */
+static const char k_pl_magic[8] = "NV2APL1";
+#define VK_PL_SEEN 65536
+static uint64_t s_pl_seen[VK_PL_SEEN];
+static uint32_t s_pl_nseen;
+static FILE *s_pl_file;
+
+static uint64_t pl_hash(const PipeKey *k, uint32_t n, const uint32_t (*w)[8])
+{
+    const uint8_t *b = (const uint8_t *)k;
+    uint64_t h = 14695981039346656037ull;
+    size_t i;
+
+    for (i = 0; i < sizeof *k; i++)
+        h = (h ^ b[i]) * 1099511628211ull;
+    h = (h ^ n) * 1099511628211ull;
+    b = (const uint8_t *)w;
+    for (i = 0; i < (size_t)n * 32; i++)
+        h = (h ^ b[i]) * 1099511628211ull;
+    return h | 1;    /* 0 marks a free slot */
+}
+
+/* Whether h is new, noting it. Only the recording thread calls this once
+ * the list is loaded. */
+static int pl_note(uint64_t h)
+{
+    uint32_t slot = (uint32_t)(h % VK_PL_SEEN);
+
+    while (s_pl_seen[slot]) {
+        if (s_pl_seen[slot] == h)
+            return 0;
+        slot = (slot + 1) % VK_PL_SEEN;
+    }
+    if (s_pl_nseen >= VK_PL_SEEN / 2)
+        return 0;
+    s_pl_seen[slot] = h;
+    s_pl_nseen++;
+    return 1;
+}
+
+static void pl_write(FILE *f, const PipeKey *k, uint32_t n, const uint32_t (*w)[8])
+{
+    uint32_t check = (uint32_t)pl_hash(k, n, w);
+
+    fwrite(&n, 4, 1, f);
+    fwrite(k, sizeof *k, 1, f);
+    if (n)
+        fwrite(w, 32, n, f);
+    fwrite(&check, 4, 1, f);
+}
+
+/* A pipeline the title asked for, onto the list if it is not there. */
+static void pl_record(const PipeKey *key)
+{
+    PipeKey k = *key;
+    const uint32_t (*w)[8] = NULL;
+    uint32_t n = 0;
+
+    if (!s_pl_file || k.vsh == 1)      /* the interpreter stands in: skip */
+        return;
+    if (k.vsh >= 2) {
+        n = s_vprogs[k.vsh - 2].n;
+        w = (const uint32_t (*)[8])s_vprogs[k.vsh - 2].words;
+        k.vsh = 2;
+    }
+    if (!pl_note(pl_hash(&k, n, w)))
+        return;
+    pl_write(s_pl_file, &k, n, w);
+    fflush(s_pl_file);
+}
+
+/* Read the list (keeping what checks out, written back compacted), queue
+ * it for the compile threads, and keep the file open to add to. */
+static void pl_load(const char *path)
+{
+    FILE *f = fopen(path, "rb");
+    uint8_t *buf = NULL;
+    long size = 0;
+    size_t at;
+    uint32_t cap = 0, ks;
+    char tmp[4096];
