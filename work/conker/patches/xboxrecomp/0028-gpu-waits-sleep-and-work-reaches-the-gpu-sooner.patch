+/* ---- Pipelines ------------------------------------------------------ */
+
+static VkPipeline pipe_get(const PipeKey *k)
+{
+    VkPipeline p;
+    int found, slot, added;
+
+    mtx_lock(&s_pipe_mtx);
+    slot = pipe_find_locked(k, &found);
+    p = found ? s_pipes[slot].p : VK_NULL_HANDLE;
+    mtx_unlock(&s_pipe_mtx);
+    if (found)
+        return p;
+    {
+        uint64_t t0 = now_us();
+        p = pipe_build(k, 0);
+        s_fr_pipe_us += now_us() - t0;
+        s_fr_pipes++;
+    }
+    if (!p)
+        return VK_NULL_HANDLE;
+    p = pipe_add(k, p, &added);
+    if (added) {
+        if (s_gpl && s_jobs_up > 0)
+            job_push_optimise(k);
+        pl_record(k);
+    }
+    return p;
+}
