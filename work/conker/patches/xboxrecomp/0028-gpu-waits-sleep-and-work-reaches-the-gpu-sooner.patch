+/* ---- Pipeline libraries --------------------------------------------- */
+
+/* The four parts (LIB_*), each kept by the part of the key it depends on. */
+#define VK_LIB_SLOTS 8192
+static struct { PipeKey k; uint32_t type; VkPipeline p; int used; } s_libs[VK_LIB_SLOTS];
+static int s_nlibs;
+
+static void lib_key(PipeKey *m, const PipeKey *k, int type)
+{
+    memset(m, 0, sizeof *m);
+    switch (type) {
+    case LIB_VI:
+        m->vsh = k->vsh != 0;
+        break;
+    case LIB_PRE:
+        m->vsh = k->vsh;
+        break;
+    case LIB_FS:
+        memcpy(m->spec, k->spec, sizeof m->spec);
+        m->depth = k->depth;
+        break;
+    default:
+        m->fmt = k->fmt;
+        m->depth = k->depth;
+        m->blend = k->blend;
+        m->src = k->src;
+        m->dst = k->dst;
+        m->eq = k->eq;
+        m->mask = k->mask;
+        break;
+    }
+}
+
+static VkPipeline lib_create(const PipeKey *k, int type)
+{
+    static const VkGraphicsPipelineLibraryFlagsEXT part[LIB_COUNT] = {
+        VK_GRAPHICS_PIPELINE_LIBRARY_VERTEX_INPUT_INTERFACE_BIT_EXT,
+        VK_GRAPHICS_PIPELINE_LIBRARY_PRE_RASTERIZATION_SHADERS_BIT_EXT,
+        VK_GRAPHICS_PIPELINE_LIBRARY_FRAGMENT_SHADER_BIT_EXT,
+        VK_GRAPHICS_PIPELINE_LIBRARY_FRAGMENT_OUTPUT_INTERFACE_BIT_EXT,
+    };
+    VkGraphicsPipelineLibraryCreateInfoEXT li = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_LIBRARY_CREATE_INFO_EXT };
+    VkPipelineDynamicStateCreateInfo dy = { VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO };
+    VkGraphicsPipelineCreateInfo gi = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO };
+    PipeStates ps;
+    VkPipeline p;
+
+    pipe_states(k, &ps);
+    li.pNext = &ps.pr;
+    li.flags = part[type];
+    gi.pNext = &li;
+    gi.flags = VK_PIPELINE_CREATE_LIBRARY_BIT_KHR
+             | VK_PIPELINE_CREATE_RETAIN_LINK_TIME_OPTIMIZATION_INFO_BIT_EXT;
+    gi.layout = s_layout;
+    switch (type) {
+    case LIB_VI:
+        gi.pVertexInputState = &ps.vi;
+        gi.pInputAssemblyState = &ps.ia;
+        break;
+    case LIB_PRE:
+        gi.stageCount = 1;
+        gi.pStages = &ps.st[0];
+        gi.pViewportState = &ps.vp;
+        gi.pRasterizationState = &ps.rs;
+        dy.dynamicStateCount = sizeof k_dyn_pre / sizeof k_dyn_pre[0];
+        dy.pDynamicStates = k_dyn_pre;
+        gi.pDynamicState = &dy;
+        break;
+    case LIB_FS:
+        gi.stageCount = 1;
+        gi.pStages = &ps.st[1];
+        gi.pDepthStencilState = &ps.ds;
+        gi.pMultisampleState = &ps.ms;
+        dy.dynamicStateCount = sizeof k_dyn_fs / sizeof k_dyn_fs[0];
+        dy.pDynamicStates = k_dyn_fs;
+        gi.pDynamicState = &dy;
+        break;
+    default:
+        gi.pColorBlendState = &ps.cb;
+        gi.pMultisampleState = &ps.ms;
+        dy.dynamicStateCount = sizeof k_dyn_fo / sizeof k_dyn_fo[0];
+        dy.pDynamicStates = k_dyn_fo;
+        gi.pDynamicState = &dy;
+        break;
+    }
+    if (vkCreateGraphicsPipelines(s_dev, s_pcache, 1, &gi, NULL, &p) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    return p;
+}
+
+/* Under s_pipe_mtx. */
+static int lib_find_locked(const PipeKey *m, int type, uint32_t *slot)
+{
+    for (*slot = (pipe_hash(m) ^ (uint32_t)type * 0x9E3779B9u) % VK_LIB_SLOTS;
+         s_libs[*slot].used; *slot = (*slot + 1) % VK_LIB_SLOTS)
+        if (s_libs[*slot].type == (uint32_t)type && !memcmp(&s_libs[*slot].k, m, sizeof *m))
+            return 1;
+    return 0;
+}
+
+static VkPipeline lib_get(const PipeKey *k, int type)
+{
+    PipeKey m;
+    VkPipeline p;
+    uint32_t slot;
+
+    lib_key(&m, k, type);
+    mtx_lock(&s_pipe_mtx);
+    if (lib_find_locked(&m, type, &slot)) {
+        p = s_libs[slot].p;
+        mtx_unlock(&s_pipe_mtx);
+        return p;
+    }
+    mtx_unlock(&s_pipe_mtx);
+    {
+        uint64_t t0 = now_us();
+        p = lib_create(k, type);
+        if (!s_compile_thread) {
+            s_fr_lib_us += now_us() - t0;
+            s_fr_libs[type]++;
+        }
+    }
+    if (!p)
+        return VK_NULL_HANDLE;
+    mtx_lock(&s_pipe_mtx);
+    if (lib_find_locked(&m, type, &slot)) {          /* made meanwhile */
+        vkDestroyPipeline(s_dev, p, NULL);
+        p = s_libs[slot].p;
+    } else if (s_nlibs < VK_LIB_SLOTS - 1) {
+        s_libs[slot].k = m;
+        s_libs[slot].type = (uint32_t)type;
+        s_libs[slot].p = p;
+        s_libs[slot].used = 1;
+        s_nlibs++;
+    }
+    mtx_unlock(&s_pipe_mtx);
+    return p;
+}
+
+/* A key's pipeline: linked from its parts, optimised across them (`lto`)
+ * or not; whole without the extension. */
+static VkPipeline pipe_build(const PipeKey *k, int lto)
+{
+    VkPipelineLibraryCreateInfoKHR lci = { VK_STRUCTURE_TYPE_PIPELINE_LIBRARY_CREATE_INFO_KHR };
+    VkGraphicsPipelineCreateInfo gi = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO };
+    VkPipeline libs[LIB_COUNT], p;
+    int t;
+
+    if (!s_gpl)
+        return pipe_create_whole(k);
+    for (t = 0; t < LIB_COUNT; t++)
+        if (!(libs[t] = lib_get(k, t)))
+            return VK_NULL_HANDLE;
+    lci.libraryCount = LIB_COUNT;
+    lci.pLibraries = libs;
+    gi.pNext = &lci;
+    gi.flags = lto ? VK_PIPELINE_CREATE_LINK_TIME_OPTIMIZATION_BIT_EXT : 0;
+    gi.layout = s_layout;
+    if (vkCreateGraphicsPipelines(s_dev, s_pcache, 1, &gi, NULL, &p) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    return p;
+}
+
+/* Under s_pipe_mtx: the key's entry, or where it would go (-1: full). */
+static int pipe_find_locked(const PipeKey *k, int *found)
+{
+    uint32_t slot = pipe_hash(k) % VK_PIPE_SLOTS;
+
+    *found = 0;
+    while (s_pipes[slot].used) {
+        if (!memcmp(&s_pipes[slot].k, k, sizeof *k)) {
+            *found = 1;
+            return (int)slot;
+        }
+        slot = (slot + 1) % VK_PIPE_SLOTS;
+    }
+    return s_npipes >= VK_PIPE_SLOTS - 1 ? -1 : (int)slot;
+}
+
+/* Adds p for k unless one is there already, which is returned instead (p
+ * is then destroyed); *added says which. */
+static VkPipeline pipe_add(const PipeKey *k, VkPipeline p, int *added)
+{
+    int found, slot;
+
+    *added = 0;
+    mtx_lock(&s_pipe_mtx);
+    slot = pipe_find_locked(k, &found);
+    if (found) {
+        VkPipeline have = s_pipes[slot].p;
+        mtx_unlock(&s_pipe_mtx);
+        vkDestroyPipeline(s_dev, p, NULL);
+        return have;
+    }
+    if (slot >= 0) {
+        s_pipes[slot].k = *k;
+        s_pipes[slot].p = p;
+        s_pipes[slot].used = 1;
+        s_npipes++;
+        *added = 1;
+    }
+    mtx_unlock(&s_pipe_mtx);
+    return p;
+}
+
+/* ---- Compile threads ------------------------------------------------ */
+
+/* Two threads, taking in order: vertex programs (a draw is waiting in the
+ * interpreter), optimised pipelines (a draw runs a merely linked one), then
+ * the pipeline list (pipelines a draw may want later). */
+#define VK_JOB_RING 4096
+#define VK_COMPILE_THREADS 2
+static mtx_t s_job_mtx;
+static cnd_t s_job_cnd;
+static int s_jobs_up;            /* 1 running, -1 could not start */
+static uint32_t s_jv[VK_JOB_RING], s_jv_head, s_jv_tail;
+static PipeKey s_jl[VK_JOB_RING];
+static uint32_t s_jl_head, s_jl_tail;
+
+/* The pipeline list: every pipeline the title has asked for, kept across
+ * runs (RECOMP_VK_PIPELINE_LIST names the file) and built again at start,
+ * so a screen seen before does not compile anything when it comes back.
+ * A vertex program's pipeline is listed with the program itself, since
+ * its slot here differs from run to run. */
+typedef struct { PipeKey k; uint32_t n; uint32_t (*words)[8]; } PipeRec;
+static PipeRec *s_pre;
+static uint32_t s_pre_n, s_pre_next;
+static atomic_uint s_pre_done;
+static struct timespec s_pre_t0;
+
+static void pipe_optimise(const PipeKey *k)
+{
+    VkPipeline p = pipe_build(k, 1), old;
+    int found, slot;
+
+    if (!p)
+        return;
+    mtx_lock(&s_pipe_mtx);
+    slot = pipe_find_locked(k, &found);
+    if (found && s_npipe_dead < VK_PIPE_SLOTS) {
+        old = s_pipes[slot].p;
+        s_pipes[slot].p = p;
+        s_pipe_dead[s_npipe_dead++] = old;
+        p = VK_NULL_HANDLE;
+    }
+    mtx_unlock(&s_pipe_mtx);
+    if (p)
+        vkDestroyPipeline(s_dev, p, NULL);
+}
+
+static void precompile(const PipeRec *r)
+{
+    PipeKey k = r->k;
+    int found, added, slot;
+    VkPipeline p;
+    struct timespec t1;
+
+    if (r->n) {
+        k.vsh = 1;
+        if (atomic_load(&s_vprog_on)) {
+            mtx_lock(&s_pipe_mtx);
+            slot = vprog_slot_locked((const uint32_t (*)[8])r->words, r->n, &added);
+            mtx_unlock(&s_pipe_mtx);
+            if (slot >= 0) {
+                struct timespec ms = { 0, 1000000 };
+                vprog_compile((uint32_t)slot);
+                while (atomic_load(&s_vprogs[slot].state) == VPROG_COMPILING)
+                    thrd_sleep(&ms, NULL);
+                if (atomic_load(&s_vprogs[slot].state) == VPROG_READY)
+                    k.vsh = 2 + (uint32_t)slot;
+            }
+        }
+    }
+    mtx_lock(&s_pipe_mtx);
+    pipe_find_locked(&k, &found);
+    mtx_unlock(&s_pipe_mtx);
+    if (!found && (p = pipe_build(&k, 1)))
+        pipe_add(&k, p, &added);
+    if (atomic_fetch_add(&s_pre_done, 1) + 1 == s_pre_n) {
+        timespec_get(&t1, TIME_UTC);
+        fprintf(stderr, "[VK] pipeline list: %u pipelines ready in %.1f s\n", s_pre_n,
+                (double)(t1.tv_sec - s_pre_t0.tv_sec)
+                + (double)(t1.tv_nsec - s_pre_t0.tv_nsec) / 1e9);
+    }
+}
+
+static int compile_thread(void *arg)
+{
+    (void)arg;
+    s_compile_thread = 1;
+    for (;;) {
+        int kind;
+        uint32_t slot = 0;
+        PipeKey k;
+        const PipeRec *r = NULL;
+
+        mtx_lock(&s_job_mtx);
+        for (;;) {
+            if (s_jv_head != s_jv_tail) {
+                kind = 0;
+                slot = s_jv[s_jv_head++ % VK_JOB_RING];
+                break;
+            }
+            if (s_jl_head != s_jl_tail) {
+                kind = 1;
+                k = s_jl[s_jl_head++ % VK_JOB_RING];
+                break;
+            }
+            if (s_pre_next < s_pre_n) {
+                kind = 2;
+                r = &s_pre[s_pre_next++];
+                break;
+            }
+            cnd_wait(&s_job_cnd, &s_job_mtx);
+        }
+        mtx_unlock(&s_job_mtx);
+        if (kind == 0)
+            vprog_compile(slot);
+        else if (kind == 1)
+            pipe_optimise(&k);
+        else
+            precompile(r);
+    }
+    return 0;
+}
+
+static void jobs_start(void)
+{
+    thrd_t t;
+    int i;
+
+    s_jobs_up = -1;
+    if (mtx_init(&s_job_mtx, mtx_plain) != thrd_success
+        || cnd_init(&s_job_cnd) != thrd_success)
+        return;
+    for (i = 0; i < VK_COMPILE_THREADS; i++) {
+        if (thrd_create(&t, compile_thread, NULL) != thrd_success)
+            break;
+        thrd_detach(t);
+        s_jobs_up = 1;
+    }
+}
+
+static void job_push_vprog(uint32_t slot)
+{
+    mtx_lock(&s_job_mtx);
+    s_jv[s_jv_tail++ % VK_JOB_RING] = slot;
+    cnd_signal(&s_job_cnd);
+    mtx_unlock(&s_job_mtx);
+}
+
+static void job_push_optimise(const PipeKey *k)
+{
+    mtx_lock(&s_job_mtx);
+    if (s_jl_tail - s_jl_head < VK_JOB_RING) {   /* else it stays merely linked */
+        s_jl[s_jl_tail++ % VK_JOB_RING] = *k;
+        cnd_signal(&s_job_cnd);
+    }
+    mtx_unlock(&s_job_mtx);
