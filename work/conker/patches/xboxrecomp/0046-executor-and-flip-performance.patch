+/* A run of n words to one method that only gathers a draw's data -- the
+ * indices of ARRAY_ELEMENT16, the vertices of INLINE_ARRAY: the same as n
+ * calls of nv2a_pb_exec_method, in one (they are most of the pushbuffer's
+ * words, and the walk handed them over one call each). 0 for anything else,
+ * or outside BEGIN/END, which goes word by word as before. */
+int nv2a_pb_exec_run(uint32_t subch, uint32_t method, const uint32_t *p, uint32_t n)
+{
+    uint32_t i;
+
+    if (subch != 0 || !n || !s_gpu.prim
+        || (method != NV097_ARRAY_ELEMENT16 && method != NV097_INLINE_ARRAY))
+        return 0;
+    s_reg[method / 4] = p[n - 1];
+    if (method == NV097_INLINE_ARRAY) {
+        uint32_t room = NV_MAX_INLINE - s_gpu.inline_count;
+        if (n < room)
+            room = n;
+        memcpy(&s_gpu.inline_buf[s_gpu.inline_count], p, (size_t)room * 4);
+        s_gpu.inline_count += room;
+    } else {
+        for (i = 0; i < n && s_gpu.idx_count + 2 <= NV_MAX_INDICES; i++) {
+            s_gpu.idx[s_gpu.idx_count++] = (uint16_t)(p[i] & 0xFFFF);
+            s_gpu.idx[s_gpu.idx_count++] = (uint16_t)(p[i] >> 16);
+        }
+    }
+    return 1;
+}
+
