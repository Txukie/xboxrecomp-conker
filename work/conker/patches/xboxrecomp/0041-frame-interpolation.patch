+/* ---- Frame interpolation -------------------------------------------- *
+ *
+ * The title draws 30 frames a second, and everything it does is paced to
+ * that; drawing more frames a second than it does meant running it faster,
+ * and part of it then ran at the wrong speed. Instead it keeps its 30, and
+ * nv2a_vk_set_interpolation(k) shows k frames for each of its own: the title's
+ * last two frames, A and B, blended.
+ *
+ * Each frame's clears and draws are recorded as they come, whole: the batch
+ * with everything it points to (render state, combiners, vertices or the
+ * vertex arrays' used range, indices, the vertex program and its constants).
+ * At B's flip each draw of A is matched to the same draw in B -- the same
+ * target, textures, vertex array, program and size, the n-th such draw of
+ * the frame -- and over the next 1/30 s A is drawn k times again, its vertex
+ * program constants (which hold every transform: camera, objects, bones)
+ * moved from A's toward B's by 0/k, 1/k ... (k-1)/k of the way, and B itself
+ * last. Pre-transformed draws with a partner of the same size have their
+ * vertices moved the same way. A frame where most draws have no partner or
+ * jump far (a camera cut, a new scene) is shown without blending.
+ *
+ * The shown frames are one of the title's frames late: A is on screen when
+ * B has just been drawn.
+ *
+ * These frames are drawn into surfaces of their own (s_surfs_replay), by the
+ * same draw path as the title's, and never go to guest memory: no write-backs,
+ * no guest uploads after a surface is made, no occlusion queries. They are
+ * drawn by the executor's thread when they are due (vk_tick), between the
+ * title's own commands, so the title's next frame goes on being drawn
+ * meanwhile. */
+
+#define REC_CONSTS (NV2A_VSH_CONSTANTS * 16)
+
+typedef struct {
+    uint8_t  kind;              /* 0 clear, 1 pre-transformed, 2 program */
+    uint8_t  blend;             /* constants close enough to blend */
+    uint16_t dlo, dhi;          /* the floats that differ from B's, dlo > dhi none */
+    uint32_t vsh;               /* its compiled vertex program, once ready */
+    Nv2aSurface ns;
+    Nv2aRenderState rs;
+    Nv2aCombiner rc;
+    uint32_t flags, argb, zs;   /* clear */
+    Nv2aFullBatch fb;           /* pre-transformed batch */
+    Nv2aProgramBatch pb;        /* program batch */
+    size_t   data;              /* vertices, or indices */
+    size_t   consts, prog;
+    size_t   attr[16];          /* element 0's offset, (size_t)-1 none */
+    uint64_t key, key2;         /* key2: without the textures (rec_keys) */
+    int      partner;           /* the same draw in B, -1 none */
+} Rec;
+
+typedef struct {
+    Rec     *r;
+    int      n, cap;
+    uint8_t *mem;
+    size_t   used, size;
+    size_t   last_consts, last_prog;
+    uint32_t last_ninst;
+    uint32_t shown_va;
+    int      cut;               /* as A of a pair: shown without blending */
+} RecFrame;
+
+static RecFrame s_recf[3];
+static int s_rec_cur, s_pair_a = -1, s_pair_b = -1, s_prev_done = -1;
+static int s_sub_done, s_in_tick, s_showed_b;
+/* RECOMP_VK_VERBOSE: per 300 frames drawn, how the blending went. */
+static unsigned s_is_frames, s_is_cuts, s_is_shown, s_is_skipped;
+static uint64_t s_is_draws, s_is_matched, s_is_blended, s_is_us;
+static uint64_t s_pair_t0, s_last_flip_us, s_period_us = 33333;
+static atomic_uint s_interp_req = 1;
+
+void nv2a_vk_set_interpolation(unsigned factor)
+{
+    if (factor < 1) factor = 1;
+    if (factor > 8) factor = 8;
+    atomic_store(&s_interp_req, factor);
+}
+
+static size_t rec_push(RecFrame *f, const void *src, size_t n)
+{
+    size_t at = (f->used + 15) & ~(size_t)15;
+    if (at + n > f->size) {
+        size_t sz = f->size ? f->size : ((size_t)8 << 20);
+        uint8_t *m;
+        while (at + n > sz)
+            sz *= 2;
+        m = (uint8_t *)realloc(f->mem, sz);
+        if (!m)
+            return (size_t)-1;
+        f->mem = m;
+        f->size = sz;
+    }
+    if (src)
+        memcpy(f->mem + at, src, n);
+    f->used = at + n;
+    return at;
+}
+
+static Rec *rec_new(RecFrame *f, int kind)
+{
+    Rec *r;
+    if (f->n == f->cap) {
+        int cap = f->cap ? f->cap * 2 : 1024;
+        Rec *n = (Rec *)realloc(f->r, (size_t)cap * sizeof *n);
+        if (!n)
+            return NULL;
+        f->r = n;
+        f->cap = cap;
+    }
+    r = &f->r[f->n++];
+    memset(r, 0, sizeof *r);
+    r->kind = (uint8_t)kind;
+    r->partner = -1;
+    return r;
+}
+
+static void rec_reset(RecFrame *f)
+{
+    f->n = 0;
+    f->used = 0;
+    f->last_consts = f->last_prog = (size_t)-1;
+    f->last_ninst = 0;
+    f->shown_va = 0;
+    f->cut = 0;
+}
+
+static uint64_t rec_mix(uint64_t h, uint64_t v)
+{
+    h ^= v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2);
+    return h * 0xFF51AFD7ED558CCDull;
+}
+
+/* An address as a draw's identity: the frame's back buffer as one token,
+ * since the title draws to and samples a different one each frame. */
+static uint64_t rec_addr(const RecFrame *f, uint32_t va)
+{
+    return va && va == f->shown_va ? 0xB0B0B0B0u : va;
+}
+
+static uint64_t rec_stage_key(const RecFrame *f, uint64_t h, const Nv2aFullBatch *b,
+                              const Nv2aCombiner *rc, int textures)
+{
+    int st;
+    for (st = 0; textures && st < 4; st++)
+        h = rec_mix(h, b->stage[st].valid ? rec_addr(f, b->stage[st].offset) : 0);
+    return rec_mix(h, rc->stage_program);
+}
+
+/* Which draw this is, for finding it again in the next frame: where it
+ * draws, from what textures, with what program and vertex layout, how many
+ * vertices. Not where its vertices are: much of a frame's geometry comes
+ * through D3D's ring of dynamic vertex buffers, at a new place every frame.
+ * Made once the frame is complete and its back buffer known. */
+static void rec_keys(RecFrame *f)
+{
+    int i, k;
+    for (i = 0; i < f->n; i++) {
+        Rec *r = &f->r[i];
+        uint64_t key = rec_mix(r->kind, rec_addr(f, r->ns.color_va));
+        if (r->kind == 0) {
+            key = rec_mix(key, r->flags);
+            r->key2 = key;
+        } else if (r->kind == 1) {
+            key = rec_mix(key, r->fb.count);
+            r->key2 = rec_stage_key(f, key, &r->fb, &r->rc, 0);
+            key = rec_stage_key(f, key, &r->fb, &r->rc, 1);
+        } else {
+            const uint32_t (*prog)[8] = (const uint32_t (*)[8])(f->mem + r->prog);
+            key = rec_mix(rec_mix(key, r->pb.count), r->pb.ninst);
+            for (k = 0; k < 16; k++)
+                key = rec_mix(key, r->attr[k] != (size_t)-1
+                              ? (uint64_t)r->pb.attr[k].stride << 16
+                                | r->pb.attr[k].type << 8 | r->pb.attr[k].size
+                              : 0);
+            key = rec_mix(key, prog[0][0] ^ ((uint64_t)prog[r->pb.ninst - 1][2] << 32));
+            r->key2 = rec_stage_key(f, key, &r->pb.pix, &r->rc, 0);
+            key = rec_stage_key(f, key, &r->pb.pix, &r->rc, 1);
+        }
+        r->key = key;
+    }
+}
+
+static int rec_on(void)
+{
+    return s_interp_k > 1 && !s_replay;
+}
+
+static void rec_clear(const Nv2aSurface *ns, const Nv2aRenderState *rs,
+                      uint32_t flags, uint32_t argb, uint32_t zs)
+{
+    RecFrame *f = &s_recf[s_rec_cur];
+    Rec *r = rec_new(f, 0);
+    if (!r)
+        return;
+    r->ns = *ns;
+    r->rs = *rs;
+    r->flags = flags;
+    r->argb = argb;
+    r->zs = zs;
+}
+
+static void rec_full(const Nv2aSurface *ns, const Nv2aFullBatch *b)
+{
+    RecFrame *f = &s_recf[s_rec_cur];
+    Rec *r = rec_new(f, 1);
+    if (!r)
+        return;
+    r->ns = *ns;
+    r->rs = *b->state;
+    r->rs.zpass_enable = 0;
+    if (b->rc)
+        r->rc = *b->rc;
+    r->fb = *b;
+    r->data = rec_push(f, b->vertices, (size_t)b->count * sizeof(Nv2aFullVertex));
+    if (r->data == (size_t)-1) {
+        f->n--;
+        return;
+    }
+}
+
+static void rec_prog(const Nv2aSurface *ns, const Nv2aProgramBatch *b)
+{
+    RecFrame *f = &s_recf[s_rec_cur];
+    Rec *r;
+    int order[16], na = 0, i, j;
+    uint32_t nv = b->max_index - b->min_index + 1;
+    size_t gbase[16];
+    const uint8_t *gptr[16];
+    uint32_t gstride[16], gend[16];
+    int ng = 0;
+
+    if (!b->count || !b->ninst || b->ninst > NV2A_VSH_SLOTS_VK)
+        return;
+    r = rec_new(f, 2);
+    if (!r)
+        return;
+    r->ns = *ns;
+    r->rs = *b->pix.state;
+    r->rs.zpass_enable = 0;
+    if (b->pix.rc)
+        r->rc = *b->pix.rc;
+    r->pb = *b;
+    r->data = rec_push(f, b->indices, (size_t)b->count * 4);
+    /* Constants and program: kept once while they repeat draw to draw. */
+    if (f->last_consts != (size_t)-1
+        && !memcmp(f->mem + f->last_consts, b->constants, REC_CONSTS))
+        r->consts = f->last_consts;
+    else
+        r->consts = f->last_consts = rec_push(f, b->constants, REC_CONSTS);
+    if (f->last_prog != (size_t)-1 && f->last_ninst == b->ninst
+        && !memcmp(f->mem + f->last_prog, b->program, (size_t)b->ninst * 32))
+        r->prog = f->last_prog;
+    else {
+        r->prog = f->last_prog = rec_push(f, b->program, (size_t)b->ninst * 32);
+        f->last_ninst = b->ninst;
+    }
+    /* The arrays' used range, an interleaved group of attributes once, as
+     * vk_draw_program groups them. */
+    for (i = 0; i < 16; i++) {
+        r->attr[i] = (size_t)-1;
+        if (b->attr[i].data)
+            order[na++] = i;
+    }
+    for (i = 1; i < na; i++)
+        for (j = i; j > 0 && b->attr[order[j]].data < b->attr[order[j - 1]].data; j--) {
+            int t = order[j]; order[j] = order[j - 1]; order[j - 1] = t;
+        }
+    for (i = 0; i < na; i++) {
+        const Nv2aAttrib *a = &b->attr[order[i]];
+        uint32_t end = (uint32_t)((uint64_t)(nv - 1) * a->stride + a->bytes);
+        if (ng && gstride[ng - 1] == a->stride
+            && a->data - gptr[ng - 1] < (ptrdiff_t)a->stride) {
+            uint32_t rel = (uint32_t)(a->data - gptr[ng - 1]) + end;
+            if (rel > gend[ng - 1]) gend[ng - 1] = rel;
+            continue;
+        }
+        gptr[ng] = a->data;
+        gstride[ng] = a->stride;
+        gend[ng] = end;
+        ng++;
+    }
+    for (i = 0; i < ng; i++)
+        gbase[i] = rec_push(f, gptr[i] + (size_t)b->min_index * gstride[i], gend[i]);
+    for (i = 0; i < na; i++) {
+        const Nv2aAttrib *a = &b->attr[order[i]];
+        for (j = 0; j < ng; j++)
+            if (gstride[j] == a->stride && a->data >= gptr[j]
+                && a->data - gptr[j] < (ptrdiff_t)(a->stride ? a->stride : 1))
+                break;
+        if (j < ng && gbase[j] != (size_t)-1)
+            r->attr[order[i]] = gbase[j] + (size_t)(a->data - gptr[j]);
+    }
+    if (r->data == (size_t)-1 || r->consts == (size_t)-1 || r->prog == (size_t)-1) {
+        f->n--;
+        return;
+    }
+}
+
+/* Keys made unique by their order among equal ones: the n-th draw of a kind. */
+static int rec_cmp(const void *x, const void *y)
+{
+    uint64_t a = ((const uint64_t *)x)[0], b = ((const uint64_t *)y)[0];
+    return a < b ? -1 : a > b;
+}
+
+/* (key, draw) for the draws not in `skip`, sorted; *pn how many. With
+ * loose, the key without textures. */
+static uint64_t *rec_index(const RecFrame *f, int loose, const uint8_t *skip, int *pn)
+{
+    uint64_t *ix = (uint64_t *)malloc((size_t)(f->n ? f->n : 1) * 16);
+    int i, j, n = 0;
+    if (!ix)
+        return NULL;
+    for (i = 0; i < f->n; i++) {
+        if (skip && skip[i])
+            continue;
+        ix[2 * n] = loose ? f->r[i].key2 : f->r[i].key;
+        ix[2 * n + 1] = (uint64_t)i;
+        n++;
+    }
+    *pn = n;
+    qsort(ix, (size_t)n, 16, rec_cmp);
+    /* Within a run of equal keys, frame order: make each unique. */
+    for (i = 0; i < n; ) {
+        for (j = i; j < n && ix[2 * j] == ix[2 * i]; j++) ;
+        if (j - i > 1) {
+            int a, b;
+            for (a = i + 1; a < j; a++)          /* stable by index */
+                for (b = a; b > i && ix[2 * b + 1] < ix[2 * (b - 1) + 1]; b--) {
+                    uint64_t t = ix[2 * b + 1];
+                    ix[2 * b + 1] = ix[2 * (b - 1) + 1];
+                    ix[2 * (b - 1) + 1] = t;
+                }
+            for (a = i; a < j; a++)
+                ix[2 * a] = rec_mix(ix[2 * a], (uint64_t)(a - i));
+        }
+        i = j;
+    }
+    qsort(ix, (size_t)n, 16, rec_cmp);
+    return ix;
+}
+
+/* How far a matched program draw's constants moved, 0 none, 1 everything. */
+static float rec_moved(const float *a, const float *b)
+{
+    double d = 0, m = 0;
+    int i;
+    for (i = 0; i < NV2A_VSH_CONSTANTS * 4; i++) {
+        if (a[i] != a[i] || b[i] != b[i])
+            continue;
+        d += fabs((double)b[i] - a[i]);
+        m += fabs((double)a[i]) + fabs((double)b[i]);
+    }
+    return m > 0 ? (float)(d / m) : 0.0f;
+}
+
+/* Pair A's draws with B's by key: first whole, then for what is left
+ * without the textures -- a cutscene can swap a draw's lighting texture
+ * between two copies frame by frame. */
+static void rec_match(RecFrame *A, RecFrame *B)
+{
+    uint8_t *ua = (uint8_t *)calloc((size_t)A->n + 1, 1);
+    uint8_t *ub = (uint8_t *)calloc((size_t)B->n + 1, 1);
+    int i, pass, progs = 0, matched = 0, moved_far = 0;
+
+    for (i = 0; i < A->n; i++)
+        A->r[i].partner = -1;
+    for (pass = 0; pass < 2 && ua && ub; pass++) {
+        int na = 0, nb = 0, x = 0, y = 0;
+        uint64_t *ia = rec_index(A, pass, ua, &na), *ib = rec_index(B, pass, ub, &nb);
+        while (ia && ib && x < na && y < nb) {
+            if (ia[2 * x] < ib[2 * y]) x++;
+            else if (ia[2 * x] > ib[2 * y]) y++;
+            else {
+                int a = (int)ia[2 * x + 1], b = (int)ib[2 * y + 1];
+                if (A->r[a].kind == B->r[b].kind) {
+                    A->r[a].partner = b;
+                    ua[a] = ub[b] = 1;
+                }
+                x++; y++;
+            }
+        }
+        free(ia);
+        free(ib);
+    }
+    free(ua);
+    free(ub);
+    for (i = 0; i < A->n; i++) {
+        Rec *ra = &A->r[i];
+        ra->blend = 0;
+        if (ra->kind != 2)
+            continue;
+        progs++;
+        if (ra->partner < 0)
+            continue;
+        matched++;
+        {
+            const Rec *rb = &B->r[ra->partner];
+            const float *ca = (const float *)(A->mem + ra->consts);
+            const float *cb = (const float *)(B->mem + rb->consts);
+            float mv = rec_moved(ca, cb);
+            int k, lo = -1, hi = -2;
+            for (k = 0; k < NV2A_VSH_CONSTANTS * 4; k++)
+                if (ca[k] != cb[k]) {
+                    if (lo < 0) lo = k;
+                    hi = k;
+                }
+            ra->dlo = (uint16_t)(lo < 0 ? 1 : lo);
+            ra->dhi = (uint16_t)(lo < 0 ? 0 : hi);
+            ra->blend = mv < 0.5f;
+            if (mv > 0.25f)
+                moved_far++;
+        }
+    }
+    /* A cut: most of A gone from B, or most of it moved far. */
+    A->cut = progs > 8 && (matched * 2 < progs || moved_far * 2 > matched);
+    s_is_frames++;
+    s_is_cuts += A->cut;
+    s_is_draws += (uint64_t)progs;
+    s_is_matched += (uint64_t)matched;
+    for (i = 0; i < A->n; i++)
+        s_is_blended += A->r[i].kind == 2 && A->r[i].blend && A->r[i].partner >= 0;
+    if (s_verbose && s_is_frames % 300 == 0) {
+        fprintf(stderr, "[VK] interpolation: %u frames, %u cuts; program draws %.0f%% matched,"
+                        " %.0f%% blended; %u in-between frames shown (%.1f ms each), %u skipped\n",
+                s_is_frames, s_is_cuts, s_is_draws ? 100.0 * s_is_matched / s_is_draws : 0.0,
+                s_is_draws ? 100.0 * s_is_blended / s_is_draws : 0.0, s_is_shown,
+                s_is_shown ? s_is_us / 1000.0 / s_is_shown : 0.0, s_is_skipped);
+        s_is_cuts = s_is_shown = s_is_skipped = 0;
+        s_is_draws = s_is_matched = s_is_blended = s_is_us = 0;
+    }
+}
+
+static float *s_lerp_buf;
+static size_t s_lerp_cap;
+
+static void *lerp_space(size_t bytes)
+{
+    if (bytes > s_lerp_cap) {
+        float *n = (float *)realloc(s_lerp_buf, bytes);
+        if (!n)
+            return NULL;
+        s_lerp_buf = n;
+        s_lerp_cap = bytes;
+    }
+    return s_lerp_buf;
+}
+
+/* Draw frame A again, t of the way toward B (B NULL or t 0: A as it was). */
+static void rec_replay(RecFrame *A, const RecFrame *B, float t)
+{
+    float kc[NV2A_VSH_CONSTANTS * 4];
+    int i, k;
+
+    for (i = 0; i < A->n; i++) {
+        Rec *r = &A->r[i];
+        const Rec *p = (B && t > 0.0f && !A->cut && r->partner >= 0)
+                     ? &B->r[r->partner] : NULL;
+        if (r->kind == 0) {
+            vk_clear(&r->ns, &r->rs, r->flags, r->argb, r->zs);
+        } else if (r->kind == 1) {
+            Nv2aFullBatch b = r->fb;
+            const Nv2aFullVertex *v = (const Nv2aFullVertex *)(A->mem + r->data);
+            b.state = &r->rs;
+            b.rc = &r->rc;
+            b.vertices = v;
+            if (p && p->fb.count == r->fb.count) {
+                const Nv2aFullVertex *w = (const Nv2aFullVertex *)(B->mem + p->data);
+                Nv2aFullVertex *o = (Nv2aFullVertex *)lerp_space((size_t)b.count * sizeof *o);
+                uint32_t n;
+                if (o) {
+                    memcpy(o, v, (size_t)b.count * sizeof *o);
+                    for (n = 0; n < b.count; n++)
+                        for (k = 0; k < 4; k++)
+                            o[n].pos[k] += (w[n].pos[k] - v[n].pos[k]) * t;
+                    b.vertices = o;
+                }
+            }
+            vk_draw_full(&r->ns, &b);
+        } else {
+            Nv2aProgramBatch b = r->pb;
+            const float *ca = (const float *)(A->mem + r->consts);
+            b.pix.state = &r->rs;
+            b.pix.rc = &r->rc;
+            b.indices = (const uint32_t *)(A->mem + r->data);
+            b.program = (const uint32_t (*)[8])(A->mem + r->prog);
+            b.constants = (const float (*)[4])ca;
+            if (p && r->blend && r->dlo <= r->dhi) {
+                const float *cb = (const float *)(B->mem + p->consts);
+                memcpy(kc, ca, sizeof kc);
+                for (k = r->dlo; k <= r->dhi; k++)
+                    if (ca[k] == ca[k] && cb[k] == cb[k])
+                        kc[k] = ca[k] + (cb[k] - ca[k]) * t;
+                b.constants = (const float (*)[4])kc;
+            }
+            for (k = 0; k < 16; k++)
+                if (r->attr[k] != (size_t)-1)
+                    b.attr[k].data = (const uint8_t *)((uintptr_t)(A->mem + r->attr[k])
+                                     - (uintptr_t)b.min_index * b.attr[k].stride);
+                else
+                    b.attr[k].data = NULL;
+            s_vsh_force = r->vsh;
+            vk_draw_program(&r->ns, &b);
+            s_vsh_force = 0;
+            if (!r->vsh && s_vsh_last >= 2)
+                r->vsh = s_vsh_last;
+        }
+    }
+}
+
+/* The in-between frame's surface for `va` into the window. */
+static void replay_present(uint32_t va)
+{
+    extern void xbox_FramebufferWindowPresentPixels(uint32_t, const void *, uint32_t,
+                                                    uint32_t, uint32_t, uint32_t);
+    Surf *shown = NULL;
+    uint32_t pw, ph;
+    int i;
+
+    for (i = 0; i < VK_MAX_SURFACES; i++) {
+        Surf *s = &s_surfs[i];
+        if (s->color.image && s->va == va && (!shown || s->last_use > shown->last_use))
+            shown = s;
+    }
+    if (!shown)
+        return;
+    pw = (shown->w < 640 ? shown->w : 640) * shown->sc;
+    ph = (shown->h < 480 ? shown->h : 480) * shown->sc;
+    if (!pres_reserve((VkDeviceSize)pw * ph * shown->bpp))
+        return;
+    {
+        VkBufferImageCopy r = copy_region(pw, ph, 1, 0, VK_IMAGE_ASPECT_COLOR_BIT);
+        end_rendering();
+        barrier_all();
+        vkCmdCopyImageToBuffer(cmd(), shown->color.image, VK_IMAGE_LAYOUT_GENERAL,
+                               s_pres.buf, 1, &r);
+        barrier_all();
+    }
+    flush();
+    xbox_FramebufferWindowPresentPixels(va, s_pres.map, pw, ph, pw * shown->bpp,
+                                        shown->bpp);
+}
+
+/* Draw and show an in-between frame: A toward B by t, or B as it is. */
+static void replay_frame(RecFrame *A, const RecFrame *B, float t)
+{
+    uint32_t target = s_draw_target_va, va = A->shown_va;
+
+    if (!va)
+        return;
+    end_rendering();
+    s_rt = NULL;
+    s_rt_z = NULL;
+    s_surfs = s_surfs_replay;
+    s_zetas = s_zetas_replay;
+    s_replay = 1;
+    rec_replay(A, B, t);
+    end_rendering();
+    replay_present(va);
+    end_rendering();
+    s_rt = NULL;
+    s_rt_z = NULL;
+    s_replay = 0;
+    s_surfs = s_surfs_title;
+    s_zetas = s_zetas_title;
+    s_draw_target_va = target;
+}
+
+/* Due in-between frames: the latest one that is due, the ones before it
+ * skipped (the executor was busy). */
+static void vk_tick(void)
+{
+    uint64_t now;
+    int k;
+
+    if (s_in_tick || s_replay || s_interp_k <= 1 || s_pair_a < 0)
+        return;
+    now = now_us();
+    k = (int)((now - s_pair_t0) * s_interp_k / s_period_us);
+    if (k > (int)s_interp_k)
+        k = (int)s_interp_k;
+    if (k < s_sub_done)
+        return;
+    s_is_skipped += (unsigned)(k - s_sub_done);
+    s_in_tick = 1;
+    /* B itself only when the title's next frame is late: A of the next pair
+     * is B, and its first frame would show it twice. */
+    if (k == (int)s_interp_k) {
+        replay_frame(&s_recf[s_pair_b], NULL, 0.0f);
+        s_showed_b = 1;
+    } else {
+        replay_frame(&s_recf[s_pair_a], &s_recf[s_pair_b], (float)k / (float)s_interp_k);
+    }
+    s_sub_done = k + 1;
+    s_is_shown++;
+    s_is_us += now_us() - now;
+    s_in_tick = 0;
+}
+
+/* The title's flip: the frame recorded since the last one is complete. */
+static void interp_flip(void)
+{
+    unsigned req = atomic_load(&s_interp_req);
+    uint64_t now = now_us();
+    int done, next;
+
+    if (req != s_interp_k) {
+        s_interp_k = req;
+        s_pair_a = s_pair_b = s_prev_done = -1;
+        rec_reset(&s_recf[0]);
+        rec_reset(&s_recf[1]);
+        rec_reset(&s_recf[2]);
+        s_rec_cur = 0;
+        fprintf(stderr, "[VK] %u frames shown per frame drawn\n", s_interp_k);
+        return;
+    }
+    if (s_interp_k <= 1)
+        return;
+    if (s_last_flip_us) {
+        uint64_t d = now - s_last_flip_us;
+        if (d < 16667) d = 16667;
+        if (d > 66667) d = 66667;
+        s_period_us = (s_period_us * 3 + d) / 4;
+    }
+    s_last_flip_us = now;
+    done = s_rec_cur;
+    rec_keys(&s_recf[done]);
+    if (s_prev_done >= 0 && s_recf[s_prev_done].shown_va && s_recf[done].shown_va) {
+        rec_match(&s_recf[s_prev_done], &s_recf[done]);
+        s_pair_a = s_prev_done;
+        s_pair_b = done;
+        s_pair_t0 = now;
+        s_sub_done = s_showed_b;   /* B was shown: start one frame on */
+        s_showed_b = 0;
+    }
+    s_prev_done = done;
+    for (next = 0; next < 3 && (next == s_pair_a || next == s_pair_b || next == done); next++) ;
+    if (next == 3)
+        next = (done + 1) % 3;
+    s_rec_cur = next;
+    rec_reset(&s_recf[s_rec_cur]);
+}
+
+static void vk_clear_rec(const Nv2aSurface *ns, const Nv2aRenderState *rs,
+                         uint32_t flags, uint32_t argb, uint32_t zs)
+{
+    vk_tick();
+    if (rec_on())
+        rec_clear(ns, rs, flags, argb, zs);
+    vk_clear(ns, rs, flags, argb, zs);
+}
+
+static void vk_draw_full_rec(const Nv2aSurface *ns, const Nv2aFullBatch *b)
+{
+    vk_tick();
+    if (rec_on())
+        rec_full(ns, b);
+    vk_draw_full(ns, b);
+}
+
+static void vk_draw_program_rec(const Nv2aSurface *ns, const Nv2aProgramBatch *b)
+{
+    vk_tick();
+    if (rec_on())
+        rec_prog(ns, b);
+    vk_draw_program(ns, b);
+}
+
+static void interp_shown(uint32_t va)
+{
+    if (s_interp_k > 1)
+        s_recf[s_rec_cur].shown_va = va;
+}
+
+static void vk_flip_rec(void)
+{
+    vk_flip();
+    interp_flip();
+    vk_tick();
+}
+
+/* At a new render scale the in-between frames' surfaces go too. */
+static void interp_reset_surfaces(void)
+{
+    int i;
+    for (i = 0; i < VK_MAX_SURFACES; i++) {
+        img_retire(&s_surfs_replay[i].color);
