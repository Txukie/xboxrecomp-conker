new file mode 100644
index 0000000..12a434f
--- /dev/null
+++ b/src/vulkan/shaders/present.vert
@@ -0,0 +1,12 @@
+#version 450
+/* One triangle over the viewport, which is where the image goes in the
+ * window (vk_window.c); v_uv runs 0..1 across it. */
+
+layout(location = 0) out vec2 v_uv;
+
+void main()
+{
+    vec2 p = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
+    v_uv = p;
+    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
+}
