--- /dev/null
+++ b/src/vulkan/shaders/present.frag
@@ -0,0 +1,14 @@
+#version 450
+/* A frame, or the overlay over it, into the window (vk_window.c). A frame's
+ * alpha is whatever the surface held: it is shown opaque. */
+
+layout(set = 0, binding = 0) uniform sampler2D u_src;
+layout(push_constant) uniform Pc { float opaque; } pc;
+layout(location = 0) in vec2 v_uv;
+layout(location = 0) out vec4 o_color;
+
+void main()
+{
+    vec4 c = texture(u_src, v_uv);
+    o_color = pc.opaque > 0.5 ? vec4(c.rgb, 1.0) : c;
+}
