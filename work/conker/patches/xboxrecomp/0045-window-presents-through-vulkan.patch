@@ -0,0 +1,1381 @@
+/*
+ * The framebuffer window's frames through Vulkan.
+ *
+ * The window (fb_present_sdl.c) used to show every frame with an SDL
+ * renderer: the renderer (nv2a_vk.c) drew the frame on the GPU, read it back
+ * into memory, and SDL uploaded it again to OpenGL to show it -- a copy each
+ * way per frame, at 4K 33 MB each, with the GPU waited for in between, and a
+ * window no Vulkan overlay (MangoHud, the Steam overlay's Vulkan side) could
+ * see, since nothing was ever presented through Vulkan.
+ *
+ * Here the window gets a Vulkan surface and swapchain instead. Frames come
+ * two ways:
+ *
+ *   the renderer's   an image on its device (vkw_target): the frame shown,
+ *                    post-processed, copied on the GPU into one of three
+ *                    images, and shown from there -- nothing goes through
+ *                    memory;
+ *   the CPU's        pixels (XboxPresenter.pixels): the launcher's page, the
+ *                    pipeline build's picture, the CPU rasteriser's frames,
+ *                    the display surface before the first flip; uploaded.
+ *
+ * A thread of its own shows them, the latest of either, letterboxed to the
+ * frame's shape on black, with the window's overlay over it; it waits on the
+ * swapchain (vsync) while the renderer goes on, and a frame that is not
+ * shown in time is replaced by the next, as the SDL window's three slots
+ * did. Before the renderer's device is there (the launcher runs before the
+ * game) the window shows the CPU's frames on a small device of its own,
+ * which goes when the renderer's takes over.
+ *
+ * Both images and pixels use three slots, one each for the writer, the
+ * frame ready and the frame shown, swapped under a mutex. The renderer's
+ * image slot is written by commands it submits after the present thread's
+ * last use of it was submitted (the swaps order them), on the same queue,
+ * behind full barriers: queue order is all the synchronisation they need.
+ *
+ * Off with RECOMP_PRESENT=sdl (the SDL renderer, as before).
+ */
+#include <SDL.h>
+#include <SDL_vulkan.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "display_aspect.h"
+#include "video_player.h"
+#include "vk_window.h"
+
+static const uint32_t k_present_vert[] =
+#include "present.vert.inc"
+;
+static const uint32_t k_present_frag[] =
+#include "present.frag.inc"
+;
+
+#define NFR 2           /* frames in flight */
+#define MAX_IMG 8       /* swapchain images */
+
+typedef struct {
+    VkImage image;
+    VkDeviceMemory mem;
+    VkImageView view;
+    uint32_t w, h;
+} VImg;
+
+typedef struct {
+    VkBuffer buf;
+    VkDeviceMemory mem;
+    void *map;
+    VkDeviceSize size;
+} VBuf;
+
+typedef struct {
+    uint8_t *px;            /* X8R8G8B8, w * 4 per row */
+    size_t cap;
+    uint32_t w, h;
+    int own_shape;
+} CpuFrame;
+
+typedef struct {
+    VkCommandBuffer cb;
+    VkFence fence;
+    VkSemaphore acquired;
+    VkDescriptorSet set[2]; /* the frame, the overlay */
+    VBuf up;                /* uploads: CPU frame, overlay */
+} Frame;
+
+static struct {
+    int inst_state;         /* 0 not tried, 1 made, -1 none */
+    VkInstance inst;
+
+    SDL_Window *win;
+    VkSurfaceKHR surf;
+    SDL_Thread *thread;
+    SDL_mutex *m;           /* everything below shared with the thread */
+    SDL_cond *c;
+    SDL_mutex *wm;          /* one CPU frame writer at a time */
+    int quit, redraw, vsync, dw, dh;
+
+    CpuFrame cpu[3];
+    int cb, cr, cf;
+    uint64_t cpu_seq, cpu_taken;
+    VImg gpu[3];            /* on the renderer's device */
+    int gb, gr, gf;
+    uint64_t gpu_seq, gpu_taken;
+    uint64_t stamp, cpu_stamp, gpu_stamp;
+
+    /* The renderer's device, as offered; usable: it can present here. */
+    int offered, usable;
+    VkPhysicalDevice o_phys;
+    VkDevice o_dev;
+    uint32_t o_qfam;
+    VkQueue o_q;
+    void (*o_lock)(int);
+    VkPhysicalDeviceMemoryProperties o_memp;
+
+    /* The present thread's own from here on. */
+    int attached;           /* showing on the renderer's device */
+    VkPhysicalDevice phys;
+    VkDevice dev;
+    uint32_t qfam;
+    VkQueue q;
+    void (*qlock)(int);
+    VkPhysicalDeviceMemoryProperties memp;
+    int ready;              /* the objects below exist */
+    VkCommandPool pool;
+    Frame fr[NFR];
+    int fi;
+    VkSampler lin, near;
+    VkDescriptorSetLayout dsl;
+    VkPipelineLayout pl;
+    VkDescriptorPool dpool;
+    VkPipeline pipe[2];     /* opaque, blended */
+    VkFormat pipe_fmt;
+    VImg cpu_img, ov_img;
+    int cpu_have, cpu_shape, src_gpu, reupload;
+    VBuf shot;
+
+    VkSwapchainKHR sc;
+    VkFormat fmt;
+    VkExtent2D ext;
+    VkImageUsageFlags usage;
+    uint32_t nimg;
+    VkImage imgs[MAX_IMG];
+    VkImageView views[MAX_IMG];
+    VkSemaphore done[MAX_IMG];
+    int sc_bad, sc_vsync;
+} V;
+
+static void no_lock(int on) { (void)on; }
