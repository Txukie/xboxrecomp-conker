+/* ── The instance ─────────────────────────────────────────────────────── */
+
+static int has_ext(const VkExtensionProperties *e, uint32_t n, const char *name)
+{
+    uint32_t i;
+    for (i = 0; i < n; i++)
+        if (!strcmp(e[i].extensionName, name))
+            return 1;
+    return 0;
+}
+
+VkInstance vkw_instance(void)
+{
+    static const char *const want[] = {
+        "VK_KHR_surface", "VK_KHR_xlib_surface", "VK_KHR_xcb_surface",
+        "VK_KHR_wayland_surface", "VK_KHR_win32_surface", "VK_EXT_metal_surface",
+        "VK_MVK_macos_surface", "VK_EXT_headless_surface",
+        /* What a layer's VK_EXT_swapchain_maintenance1 needs (gamescope's
+         * forces it on). */
+        "VK_KHR_get_surface_capabilities2", "VK_EXT_surface_maintenance1",
+        VK_KHR_PORTABILITY_ENUMERATION_EXTENSION_NAME,
+    };
+    VkApplicationInfo app = { VK_STRUCTURE_TYPE_APPLICATION_INFO };
+    VkInstanceCreateInfo ci = { VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO };
+    VkExtensionProperties *ext;
+    const char *exts[16], *layer = "VK_LAYER_KHRONOS_validation";
+    uint32_t n = 0, ne = 0, i;
+
+    if (V.inst_state)
+        return V.inst_state > 0 ? V.inst : VK_NULL_HANDLE;
+    V.inst_state = -1;
+    app.pApplicationName = "xboxrecomp";
+    app.apiVersion = VK_API_VERSION_1_3;
+    ci.pApplicationInfo = &app;
+    if (vkEnumerateInstanceExtensionProperties(NULL, &n, NULL) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    ext = (VkExtensionProperties *)calloc(n ? n : 1, sizeof *ext);
+    if (!ext)
+        return VK_NULL_HANDLE;
+    vkEnumerateInstanceExtensionProperties(NULL, &n, ext);
+    for (i = 0; i < sizeof want / sizeof *want; i++)
+        if (has_ext(ext, n, want[i]))
+            exts[ne++] = want[i];
+    /* MoltenVK is a portability implementation: listed only when asked. */
+    if (has_ext(ext, n, VK_KHR_PORTABILITY_ENUMERATION_EXTENSION_NAME))
+        ci.flags |= VK_INSTANCE_CREATE_ENUMERATE_PORTABILITY_BIT_KHR;
+    free(ext);
+    ci.enabledExtensionCount = ne;
+    ci.ppEnabledExtensionNames = exts;
+    if (getenv("RECOMP_VK_VALIDATE")) {
+        ci.enabledLayerCount = 1;
+        ci.ppEnabledLayerNames = &layer;
+        if (vkCreateInstance(&ci, NULL, &V.inst) == VK_SUCCESS) {
+            V.inst_state = 1;
+            return V.inst;
+        }
+        fprintf(stderr, "[VK] no validation layer (%s); going on without\n", layer);
+        ci.enabledLayerCount = 0;
+    }
+    if (vkCreateInstance(&ci, NULL, &V.inst) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    V.inst_state = 1;
+    return V.inst;
+}
+
+VkSurfaceKHR vkw_surface(void)
+{
+    return V.surf;
+}
