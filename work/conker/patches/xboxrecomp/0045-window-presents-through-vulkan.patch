+/* ── Memory ───────────────────────────────────────────────────────────── */
+
+static uint32_t mem_type(const VkPhysicalDeviceMemoryProperties *mp, uint32_t bits,
+                         VkMemoryPropertyFlags want)
+{
+    uint32_t i;
+    for (i = 0; i < mp->memoryTypeCount; i++)
+        if ((bits & (1u << i)) && (mp->memoryTypes[i].propertyFlags & want) == want)
+            return i;
+    return UINT32_MAX;
+}
+
+static int img_make(VkDevice dev, const VkPhysicalDeviceMemoryProperties *mp, VImg *im,
+                    uint32_t w, uint32_t h, VkImageUsageFlags usage)
+{
+    VkImageCreateInfo ii = { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+    VkImageViewCreateInfo vi = { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+    VkMemoryAllocateInfo ai = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    VkMemoryRequirements mr;
+
+    memset(im, 0, sizeof *im);
+    ii.imageType = VK_IMAGE_TYPE_2D;
+    ii.format = VK_FORMAT_B8G8R8A8_UNORM;
+    ii.extent.width = w;
+    ii.extent.height = h;
+    ii.extent.depth = 1;
+    ii.mipLevels = ii.arrayLayers = 1;
+    ii.samples = VK_SAMPLE_COUNT_1_BIT;
+    ii.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ii.usage = usage;
+    ii.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (vkCreateImage(dev, &ii, NULL, &im->image) != VK_SUCCESS)
+        return 0;
+    vkGetImageMemoryRequirements(dev, im->image, &mr);
+    ai.allocationSize = mr.size;
+    ai.memoryTypeIndex = mem_type(mp, mr.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (ai.memoryTypeIndex == UINT32_MAX)
+        ai.memoryTypeIndex = mem_type(mp, mr.memoryTypeBits, 0);
+    if (vkAllocateMemory(dev, &ai, NULL, &im->mem) != VK_SUCCESS) {
+        vkDestroyImage(dev, im->image, NULL);
+        im->image = VK_NULL_HANDLE;
+        return 0;
+    }
+    vkBindImageMemory(dev, im->image, im->mem, 0);
+    vi.image = im->image;
+    vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    vi.format = ii.format;
+    vi.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    vi.subresourceRange.levelCount = vi.subresourceRange.layerCount = 1;
+    if (vkCreateImageView(dev, &vi, NULL, &im->view) != VK_SUCCESS) {
+        vkDestroyImage(dev, im->image, NULL);
+        vkFreeMemory(dev, im->mem, NULL);
+        memset(im, 0, sizeof *im);
+        return 0;
+    }
+    im->w = w;
+    im->h = h;
+    return 1;
+}
+
+static void img_free(VkDevice dev, VImg *im)
+{
+    if (im->view)
+        vkDestroyImageView(dev, im->view, NULL);
+    if (im->image)
+        vkDestroyImage(dev, im->image, NULL);
+    if (im->mem)
+        vkFreeMemory(dev, im->mem, NULL);
+    memset(im, 0, sizeof *im);
+}
+
+static int buf_make(VBuf *b, VkDeviceSize size, VkBufferUsageFlags usage)
+{
+    VkBufferCreateInfo bi = { VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+    VkMemoryAllocateInfo ai = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO };
+    VkMemoryRequirements mr;
+
+    memset(b, 0, sizeof *b);
+    bi.size = size;
+    bi.usage = usage;
+    if (vkCreateBuffer(V.dev, &bi, NULL, &b->buf) != VK_SUCCESS)
+        return 0;
+    vkGetBufferMemoryRequirements(V.dev, b->buf, &mr);
+    ai.allocationSize = mr.size;
+    ai.memoryTypeIndex = mem_type(&V.memp, mr.memoryTypeBits,
+                                  VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT
+                                  | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT
+                                  | VK_MEMORY_PROPERTY_HOST_CACHED_BIT);
+    if (ai.memoryTypeIndex == UINT32_MAX)
+        ai.memoryTypeIndex = mem_type(&V.memp, mr.memoryTypeBits,
+                                      VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT
+                                      | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+    if (ai.memoryTypeIndex == UINT32_MAX
+        || vkAllocateMemory(V.dev, &ai, NULL, &b->mem) != VK_SUCCESS) {
+        vkDestroyBuffer(V.dev, b->buf, NULL);
+        memset(b, 0, sizeof *b);
+        return 0;
+    }
+    vkBindBufferMemory(V.dev, b->buf, b->mem, 0);
+    if (vkMapMemory(V.dev, b->mem, 0, VK_WHOLE_SIZE, 0, &b->map) != VK_SUCCESS) {
+        vkDestroyBuffer(V.dev, b->buf, NULL);
+        vkFreeMemory(V.dev, b->mem, NULL);
+        memset(b, 0, sizeof *b);
+        return 0;
+    }
+    b->size = size;
+    return 1;
+}
+
+static void buf_free(VBuf *b)
+{
+    if (b->buf)
+        vkDestroyBuffer(V.dev, b->buf, NULL);
+    if (b->mem)
+        vkFreeMemory(V.dev, b->mem, NULL);
+    memset(b, 0, sizeof *b);
+}
+
+static void wait_idle(void)
+{
+    if (!V.dev)
+        return;
+    V.qlock(1);
+    vkQueueWaitIdle(V.q);
+    V.qlock(0);
+}
+
+/* ── The device: the renderer's, or one of the window's own ──────────── */
+
+/* A device of the window's own, for the CPU's frames until the renderer's
+ * is there: a graphics queue that presents here, Vulkan 1.3. */
+static int own_device(void)
+{
+    VkPhysicalDevice devs[16];
+    uint32_t n = 16, i, k, best = UINT32_MAX, bq = 0;
+    int best_score = -1;
+    float prio = 1.0f;
+    VkDeviceQueueCreateInfo qi = { VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO };
+    VkPhysicalDeviceVulkan13Features f13 = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES };
+    VkPhysicalDeviceFeatures2 f2 = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2 };
+    VkDeviceCreateInfo ci = { VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO };
+    VkExtensionProperties ext[512];
+    const char *exts[2];
+    uint32_t ne = 0, nx = 512;
+
+    if (vkEnumeratePhysicalDevices(V.inst, &n, devs) < 0 || !n)
+        return 0;
+    for (i = 0; i < n; i++) {
+        VkPhysicalDeviceProperties p;
+        VkQueueFamilyProperties q[16];
+        uint32_t nq = 16;
+        int score;
+        vkGetPhysicalDeviceProperties(devs[i], &p);
+        if (p.apiVersion < VK_API_VERSION_1_3)
+            continue;
+        vkGetPhysicalDeviceQueueFamilyProperties(devs[i], &nq, q);
+        for (k = 0; k < nq; k++) {
+            VkBool32 ok = VK_FALSE;
+            if ((q[k].queueFlags & VK_QUEUE_GRAPHICS_BIT)
+                && vkGetPhysicalDeviceSurfaceSupportKHR(devs[i], k, V.surf, &ok) == VK_SUCCESS
+                && ok)
+                break;
+        }
+        if (k == nq)
+            continue;
+        score = p.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU ? 3
+              : p.deviceType == VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU ? 2 : 1;
+        if (score > best_score) {
+            best_score = score;
+            best = i;
+            bq = k;
+        }
+    }
+    if (best == UINT32_MAX)
+        return 0;
+    if (vkEnumerateDeviceExtensionProperties(devs[best], NULL, &nx, ext) < 0
+        || !has_ext(ext, nx, VK_KHR_SWAPCHAIN_EXTENSION_NAME))
+        return 0;
+    exts[ne++] = VK_KHR_SWAPCHAIN_EXTENSION_NAME;
+    if (has_ext(ext, nx, "VK_KHR_portability_subset"))
+        exts[ne++] = "VK_KHR_portability_subset";
+    f13.dynamicRendering = VK_TRUE;
+    f2.pNext = &f13;
+    qi.queueFamilyIndex = bq;
+    qi.queueCount = 1;
+    qi.pQueuePriorities = &prio;
+    ci.pNext = &f2;
+    ci.queueCreateInfoCount = 1;
+    ci.pQueueCreateInfos = &qi;
+    ci.enabledExtensionCount = ne;
+    ci.ppEnabledExtensionNames = exts;
+    if (vkCreateDevice(devs[best], &ci, NULL, &V.dev) != VK_SUCCESS) {
+        V.dev = VK_NULL_HANDLE;
+        return 0;
+    }
+    V.phys = devs[best];
+    V.qfam = bq;
+    vkGetDeviceQueue(V.dev, bq, 0, &V.q);
+    V.qlock = no_lock;
+    vkGetPhysicalDeviceMemoryProperties(V.phys, &V.memp);
+    return 1;
+}
+
+static VkPipeline make_pipeline(VkFormat cf, int blend)
+{
+    VkShaderModuleCreateInfo sm = { VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO };
+    VkShaderModule vs = VK_NULL_HANDLE, fs = VK_NULL_HANDLE;
+    VkPipelineShaderStageCreateInfo st[2];
+    VkPipelineVertexInputStateCreateInfo vin = { VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO };
+    VkPipelineInputAssemblyStateCreateInfo ia = { VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO };
+    VkPipelineViewportStateCreateInfo vp = { VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO };
+    VkPipelineRasterizationStateCreateInfo rs = { VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO };
+    VkPipelineMultisampleStateCreateInfo ms = { VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO };
+    VkPipelineColorBlendAttachmentState cba;
+    VkPipelineColorBlendStateCreateInfo cb = { VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO };
+    VkDynamicState dyn[2] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+    VkPipelineDynamicStateCreateInfo ds = { VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO };
+    VkPipelineRenderingCreateInfo ri = { VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO };
+    VkGraphicsPipelineCreateInfo gi = { VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO };
+    VkPipeline pipe = VK_NULL_HANDLE;
+
+    sm.codeSize = sizeof k_present_vert;
+    sm.pCode = k_present_vert;
+    if (vkCreateShaderModule(V.dev, &sm, NULL, &vs) != VK_SUCCESS)
+        return VK_NULL_HANDLE;
+    sm.codeSize = sizeof k_present_frag;
+    sm.pCode = k_present_frag;
+    if (vkCreateShaderModule(V.dev, &sm, NULL, &fs) != VK_SUCCESS) {
+        vkDestroyShaderModule(V.dev, vs, NULL);
+        return VK_NULL_HANDLE;
+    }
+    memset(st, 0, sizeof st);
+    st[0].sType = st[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    st[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+    st[0].module = vs;
+    st[0].pName = "main";
+    st[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+    st[1].module = fs;
+    st[1].pName = "main";
+    ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    vp.viewportCount = vp.scissorCount = 1;
+    rs.polygonMode = VK_POLYGON_MODE_FILL;
+    rs.cullMode = VK_CULL_MODE_NONE;
+    rs.lineWidth = 1.0f;
+    ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    memset(&cba, 0, sizeof cba);
+    /* The window's alpha stays 1: a screenshot of it is opaque. */
+    cba.colorWriteMask = blend ? 0x7 : 0xF;
+    if (blend) {
+        cba.blendEnable = VK_TRUE;
+        cba.srcColorBlendFactor = VK_BLEND_FACTOR_SRC_ALPHA;
+        cba.dstColorBlendFactor = VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+        cba.colorBlendOp = VK_BLEND_OP_ADD;
+        cba.srcAlphaBlendFactor = VK_BLEND_FACTOR_ZERO;
+        cba.dstAlphaBlendFactor = VK_BLEND_FACTOR_ONE;
+        cba.alphaBlendOp = VK_BLEND_OP_ADD;
+    }
+    cb.attachmentCount = 1;
+    cb.pAttachments = &cba;
+    ds.dynamicStateCount = 2;
+    ds.pDynamicStates = dyn;
+    ri.colorAttachmentCount = 1;
+    ri.pColorAttachmentFormats = &cf;
+    gi.pNext = &ri;
+    gi.stageCount = 2;
+    gi.pStages = st;
+    gi.pVertexInputState = &vin;
+    gi.pInputAssemblyState = &ia;
+    gi.pViewportState = &vp;
+    gi.pRasterizationState = &rs;
+    gi.pMultisampleState = &ms;
+    gi.pColorBlendState = &cb;
+    gi.pDynamicState = &ds;
+    gi.layout = V.pl;
+    if (vkCreateGraphicsPipelines(V.dev, VK_NULL_HANDLE, 1, &gi, NULL, &pipe) != VK_SUCCESS)
+        pipe = VK_NULL_HANDLE;
+    vkDestroyShaderModule(V.dev, vs, NULL);
+    vkDestroyShaderModule(V.dev, fs, NULL);
+    return pipe;
+}
+
+static void destroy_swapchain(void)
+{
+    uint32_t i;
+    for (i = 0; i < V.nimg; i++)
+        if (V.views[i])
+            vkDestroyImageView(V.dev, V.views[i], NULL);
+    memset(V.views, 0, sizeof V.views);
+    V.nimg = 0;
+    if (V.sc)
+        vkDestroySwapchainKHR(V.dev, V.sc, NULL);
+    V.sc = VK_NULL_HANDLE;
+}
+
+/* Everything on the device in use, and the device if it is the window's. */
+static void drop_device(void)
+{
+    int i;
+
+    if (!V.dev)
+        return;
+    wait_idle();
+    destroy_swapchain();
+    for (i = 0; i < MAX_IMG; i++)
+        if (V.done[i])
+            vkDestroySemaphore(V.dev, V.done[i], NULL);
+    memset(V.done, 0, sizeof V.done);
+    if (V.ready) {
+        for (i = 0; i < NFR; i++) {
+            vkDestroyFence(V.dev, V.fr[i].fence, NULL);
+            vkDestroySemaphore(V.dev, V.fr[i].acquired, NULL);
+            buf_free(&V.fr[i].up);
+        }
+        memset(V.fr, 0, sizeof V.fr);
+        for (i = 0; i < 2; i++)
+            if (V.pipe[i])
+                vkDestroyPipeline(V.dev, V.pipe[i], NULL);
+        memset(V.pipe, 0, sizeof V.pipe);
+        V.pipe_fmt = VK_FORMAT_UNDEFINED;
+        vkDestroyDescriptorPool(V.dev, V.dpool, NULL);
+        vkDestroyPipelineLayout(V.dev, V.pl, NULL);
+        vkDestroyDescriptorSetLayout(V.dev, V.dsl, NULL);
+        vkDestroySampler(V.dev, V.lin, NULL);
+        vkDestroySampler(V.dev, V.near, NULL);
+        vkDestroyCommandPool(V.dev, V.pool, NULL);
+        img_free(V.dev, &V.cpu_img);
+        img_free(V.dev, &V.ov_img);
+        buf_free(&V.shot);
+        V.ready = 0;
+    }
+    if (!V.attached)
+        vkDestroyDevice(V.dev, NULL);
+    V.dev = VK_NULL_HANDLE;
+    V.cpu_have = 0;
+}
+
+/* The objects every frame uses, on V.dev. */
+static int make_objects(void)
+{
+    VkCommandPoolCreateInfo pi = { VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO };
+    VkCommandBufferAllocateInfo ca = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO };
+    VkFenceCreateInfo fi = { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+    VkSemaphoreCreateInfo si = { VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+    VkSamplerCreateInfo sa = { VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO };
+    VkDescriptorSetLayoutBinding b;
+    VkDescriptorSetLayoutCreateInfo dl = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO };
+    VkPushConstantRange pcr = { VK_SHADER_STAGE_FRAGMENT_BIT, 0, 4 };
+    VkPipelineLayoutCreateInfo pl = { VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO };
+    VkDescriptorPoolSize ps = { VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 2 * NFR };
+    VkDescriptorPoolCreateInfo dp = { VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO };
+    VkDescriptorSetAllocateInfo da = { VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO };
+    VkDescriptorSetLayout layouts[2];
+    int i;
+
+    pi.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+    pi.queueFamilyIndex = V.qfam;
+    if (vkCreateCommandPool(V.dev, &pi, NULL, &V.pool) != VK_SUCCESS)
+        return 0;
+    sa.magFilter = sa.minFilter = VK_FILTER_LINEAR;
+    sa.addressModeU = sa.addressModeV = sa.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+    vkCreateSampler(V.dev, &sa, NULL, &V.lin);
+    sa.magFilter = sa.minFilter = VK_FILTER_NEAREST;
+    vkCreateSampler(V.dev, &sa, NULL, &V.near);
+    memset(&b, 0, sizeof b);
+    b.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    b.descriptorCount = 1;
+    b.stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+    dl.bindingCount = 1;
+    dl.pBindings = &b;
+    vkCreateDescriptorSetLayout(V.dev, &dl, NULL, &V.dsl);
+    pl.setLayoutCount = 1;
+    pl.pSetLayouts = &V.dsl;
+    pl.pushConstantRangeCount = 1;
+    pl.pPushConstantRanges = &pcr;
+    vkCreatePipelineLayout(V.dev, &pl, NULL, &V.pl);
+    dp.maxSets = 2 * NFR;
+    dp.poolSizeCount = 1;
+    dp.pPoolSizes = &ps;
+    vkCreateDescriptorPool(V.dev, &dp, NULL, &V.dpool);
+    layouts[0] = layouts[1] = V.dsl;
+    ca.commandPool = V.pool;
+    ca.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+    ca.commandBufferCount = 1;
+    fi.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+    da.descriptorPool = V.dpool;
+    da.descriptorSetCount = 2;
+    da.pSetLayouts = layouts;
+    for (i = 0; i < NFR; i++) {
+        if (vkAllocateCommandBuffers(V.dev, &ca, &V.fr[i].cb) != VK_SUCCESS
+            || vkCreateFence(V.dev, &fi, NULL, &V.fr[i].fence) != VK_SUCCESS
+            || vkCreateSemaphore(V.dev, &si, NULL, &V.fr[i].acquired) != VK_SUCCESS
+            || vkAllocateDescriptorSets(V.dev, &da, V.fr[i].set) != VK_SUCCESS)
+            return 0;
+    }
+    for (i = 0; i < MAX_IMG; i++)
+        vkCreateSemaphore(V.dev, &si, NULL, &V.done[i]);
+    V.ready = 1;
+    V.sc_bad = 1;
+    return 1;
+}
+
+/* The renderer's device, when it was offered and the window is not on it
+ * yet; else the window's own, when there is no device at all. */
+static int device_ready(void)
+{
+    int offered;
+
+    SDL_LockMutex(V.m);
+    offered = V.usable && !V.attached;
+    SDL_UnlockMutex(V.m);
+    if (offered) {
+        drop_device();
+        V.attached = 1;
+        V.phys = V.o_phys;
+        V.dev = V.o_dev;
+        V.qfam = V.o_qfam;
+        V.q = V.o_q;
+        V.qlock = V.o_lock;
+        V.memp = V.o_memp;
+        V.reupload = 1;
+        fprintf(stderr, "[VK] window: shown on the renderer's device\n");
+    }
+    if (!V.dev && !own_device())
+        return 0;
+    return V.ready || make_objects();
+}
+
+/* ── The swapchain ────────────────────────────────────────────────────── */
+
+static int make_swapchain(void)
+{
+    VkSurfaceCapabilitiesKHR caps;
+    VkSurfaceFormatKHR fmts[64];
+    VkPresentModeKHR modes[16], mode = VK_PRESENT_MODE_FIFO_KHR;
+    VkSwapchainCreateInfoKHR ci = { VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR };
+    VkSwapchainKHR old = V.sc;
+    uint32_t nf = 64, nm = 16, i, w, h;
+    VkFormat fmt = VK_FORMAT_UNDEFINED;
+    VkImageViewCreateInfo vi = { VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO };
+    int vsync, dw, dh, changed;
+
+    SDL_LockMutex(V.m);
+    vsync = V.vsync;
+    dw = V.dw;
+    dh = V.dh;
+    SDL_UnlockMutex(V.m);
+    V.sc_bad = 0;
+    changed = V.sc_vsync != vsync;
+    V.sc_vsync = vsync;     /* asked for, made or not: nothing to retry */
+    if (vkGetPhysicalDeviceSurfaceCapabilitiesKHR(V.phys, V.surf, &caps) != VK_SUCCESS)
+        return 0;
+    if (caps.currentExtent.width != UINT32_MAX) {
+        w = caps.currentExtent.width;
+        h = caps.currentExtent.height;
+    } else {
+        w = dw > 0 ? (uint32_t)dw : 0;
+        h = dh > 0 ? (uint32_t)dh : 0;
+        if (w < caps.minImageExtent.width) w = caps.minImageExtent.width;
+        if (h < caps.minImageExtent.height) h = caps.minImageExtent.height;
+        if (w > caps.maxImageExtent.width) w = caps.maxImageExtent.width;
+        if (h > caps.maxImageExtent.height) h = caps.maxImageExtent.height;
+    }
+    wait_idle();
+    if (!w || !h) {         /* minimised */
+        destroy_swapchain();
+        return 0;
+    }
+    vkGetPhysicalDeviceSurfaceFormatsKHR(V.phys, V.surf, &nf, fmts);
+    for (i = 0; i < nf && fmt == VK_FORMAT_UNDEFINED; i++)
+        if (fmts[i].format == VK_FORMAT_B8G8R8A8_UNORM
+            && fmts[i].colorSpace == VK_COLOR_SPACE_SRGB_NONLINEAR_KHR)
+            fmt = fmts[i].format;
+    for (i = 0; i < nf && fmt == VK_FORMAT_UNDEFINED; i++)
+        if (fmts[i].format == VK_FORMAT_R8G8B8A8_UNORM
+            && fmts[i].colorSpace == VK_COLOR_SPACE_SRGB_NONLINEAR_KHR)
+            fmt = fmts[i].format;
+    if (fmt == VK_FORMAT_UNDEFINED)
+        fmt = nf && fmts[0].format != VK_FORMAT_UNDEFINED ? fmts[0].format
+                                                          : VK_FORMAT_B8G8R8A8_UNORM;
+    /* Vsync: mailbox, each refresh showing the latest frame, as the SDL
+     * window's swap did with frames dropped in its slots -- and a present
+     * that never waits for the display while it holds the queue the
+     * renderer submits to. FIFO where there is no mailbox. Off: no waiting
+     * at all if the window can. */
+    vkGetPhysicalDeviceSurfacePresentModesKHR(V.phys, V.surf, &nm, modes);
+    for (i = 0; i < nm && !vsync; i++)
+        if (modes[i] == VK_PRESENT_MODE_IMMEDIATE_KHR)
+            mode = modes[i];
+    for (i = 0; i < nm && mode == VK_PRESENT_MODE_FIFO_KHR; i++)
+        if (modes[i] == VK_PRESENT_MODE_MAILBOX_KHR)
+            mode = modes[i];
+    ci.surface = V.surf;
+    ci.minImageCount = caps.minImageCount + 1;
+    if (caps.maxImageCount && ci.minImageCount > caps.maxImageCount)
+        ci.minImageCount = caps.maxImageCount;
+    if (ci.minImageCount > MAX_IMG)
+        ci.minImageCount = MAX_IMG;
+    ci.imageFormat = fmt;
+    ci.imageColorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+    for (i = 0; i < nf; i++)
+        if (fmts[i].format == fmt) {
+            ci.imageColorSpace = fmts[i].colorSpace;
+            break;
+        }
+    ci.imageExtent.width = w;
+    ci.imageExtent.height = h;
+    ci.imageArrayLayers = 1;
+    ci.imageUsage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT
+                  | (caps.supportedUsageFlags & VK_IMAGE_USAGE_TRANSFER_SRC_BIT);
+    ci.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    ci.preTransform = caps.currentTransform;
+    ci.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+    if (!(caps.supportedCompositeAlpha & ci.compositeAlpha)) {
+        for (i = 0; i < 32; i++)
+            if (caps.supportedCompositeAlpha & (1u << i)) {
+                ci.compositeAlpha = (VkCompositeAlphaFlagBitsKHR)(1u << i);
+                break;
+            }
+    }
+    ci.presentMode = mode;
+    ci.clipped = VK_TRUE;
+    ci.oldSwapchain = old;
+    if (vkCreateSwapchainKHR(V.dev, &ci, NULL, &V.sc) != VK_SUCCESS) {
+        V.sc = old;
+        destroy_swapchain();
+        return 0;
+    }
+    for (i = 0; i < V.nimg; i++)
+        vkDestroyImageView(V.dev, V.views[i], NULL);
+    memset(V.views, 0, sizeof V.views);
+    if (old)
+        vkDestroySwapchainKHR(V.dev, old, NULL);
+    V.nimg = MAX_IMG;
+    vkGetSwapchainImagesKHR(V.dev, V.sc, &V.nimg, V.imgs);
+    vi.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    vi.format = fmt;
+    vi.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    vi.subresourceRange.levelCount = vi.subresourceRange.layerCount = 1;
+    for (i = 0; i < V.nimg; i++) {
+        vi.image = V.imgs[i];
+        vkCreateImageView(V.dev, &vi, NULL, &V.views[i]);
+    }
+    if (fmt != V.pipe_fmt) {
+        for (i = 0; i < 2; i++)
+            if (V.pipe[i])
+                vkDestroyPipeline(V.dev, V.pipe[i], NULL);
+        V.pipe[0] = make_pipeline(fmt, 0);
+        V.pipe[1] = make_pipeline(fmt, 1);
+        V.pipe_fmt = fmt;
+    }
+    if (V.ext.width != w || V.ext.height != h || V.fmt != fmt || changed)
+        fprintf(stderr, "[VK] window: %ux%u, %s, vsync %s\n", w, h,
+                mode == VK_PRESENT_MODE_FIFO_KHR ? "fifo"
+                : mode == VK_PRESENT_MODE_MAILBOX_KHR ? "mailbox" : "immediate",
+                vsync ? "on" : "off");
+    V.fmt = fmt;
+    V.ext.width = w;
+    V.ext.height = h;
+    V.usage = ci.imageUsage;
+    return V.pipe[0] && V.pipe[1];
+}
+
+/* ── Drawing a frame ──────────────────────────────────────────────────── */
+
+static void barrier_all(VkCommandBuffer cb)
+{
+    VkMemoryBarrier mb = { VK_STRUCTURE_TYPE_MEMORY_BARRIER };
+    mb.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+    mb.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+    vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                         VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+}
+
+static void layout_to(VkCommandBuffer cb, VkImage im, VkImageLayout from, VkImageLayout to)
+{
+    VkImageMemoryBarrier b = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+    b.srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT;
+    b.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+    b.oldLayout = from;
+    b.newLayout = to;
+    b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    b.image = im;
+    b.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    b.subresourceRange.levelCount = b.subresourceRange.layerCount = 1;
+    vkCmdPipelineBarrier(cb, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                         VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, NULL, 0, NULL, 1, &b);
+}
+
+/* Upload room in this frame's buffer for `bytes`, after `at`. */
+static int up_room(Frame *f, VkDeviceSize bytes)
+{
+    if (f->up.size >= bytes)
+        return 1;
+    buf_free(&f->up);
+    return buf_make(&f->up, bytes + bytes / 4, VK_BUFFER_USAGE_TRANSFER_SRC_BIT);
+}
+
+/* pixels (w x h X8R8G8B8 in f->up at off) into *im, made at that size. */
+static int upload(VkCommandBuffer cb, VImg *im, uint32_t w, uint32_t h, VkDeviceSize off)
+{
+    VkBufferImageCopy r;
+
+    if (!im->image || im->w != w || im->h != h) {
+        int i;
+        /* The other frames may still read it; this one's fence was
+         * waited for, and is reset by now. */
+        for (i = 0; i < NFR; i++)
+            if (i != V.fi)
+                vkWaitForFences(V.dev, 1, &V.fr[i].fence, VK_TRUE, UINT64_MAX);
+        img_free(V.dev, im);
+        if (!img_make(V.dev, &V.memp, im, w, h,
+                      VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT))
+            return 0;
+        layout_to(cb, im->image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL);
+    }
+    memset(&r, 0, sizeof r);
+    r.bufferOffset = off;
+    r.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    r.imageSubresource.layerCount = 1;
+    r.imageExtent.width = w;
+    r.imageExtent.height = h;
+    r.imageExtent.depth = 1;
+    vkCmdCopyBufferToImage(cb, V.fr[V.fi].up.buf, im->image, VK_IMAGE_LAYOUT_GENERAL, 1, &r);
+    return 1;
+}
+
+static void bind_image(VkDescriptorSet set, VkImageView view, VkSampler s)
+{
+    VkDescriptorImageInfo ii;
+    VkWriteDescriptorSet w = { VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET };
+    ii.sampler = s;
+    ii.imageView = view;
+    ii.imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+    w.dstSet = set;
+    w.descriptorCount = 1;
+    w.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    w.pImageInfo = &ii;
+    vkUpdateDescriptorSets(V.dev, 1, &w, 0, NULL);
+}
+
+static void draw_quad(VkCommandBuffer cb, int x, int y, int w, int h, int pipe,
+                      VkDescriptorSet set)
+{
+    VkViewport vp;
+    VkRect2D sc;
+    float opaque = pipe == 0 ? 1.0f : 0.0f;
+    int x1 = x + w, y1 = y + h;
+
+    vp.x = (float)x;
+    vp.y = (float)y;
+    vp.width = (float)w;
+    vp.height = (float)h;
+    vp.minDepth = 0.0f;
+    vp.maxDepth = 1.0f;
+    /* The scissor stays inside the image; the viewport may not. */
+    if (x < 0) x = 0;
+    if (y < 0) y = 0;
+    if (x1 > (int)V.ext.width) x1 = (int)V.ext.width;
+    if (y1 > (int)V.ext.height) y1 = (int)V.ext.height;
+    if (x1 <= x || y1 <= y)
+        return;
+    sc.offset.x = x;
+    sc.offset.y = y;
+    sc.extent.width = (uint32_t)(x1 - x);
+    sc.extent.height = (uint32_t)(y1 - y);
+    vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, V.pipe[pipe]);
+    vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_GRAPHICS, V.pl, 0, 1, &set, 0, NULL);
+    vkCmdPushConstants(cb, V.pl, VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof opaque, &opaque);
+    vkCmdSetViewport(cb, 0, 1, &vp);
+    vkCmdSetScissor(cb, 0, 1, &sc);
+    vkCmdDraw(cb, 3, 1, 0, 0);
+}
+
+static void save_shot(const char *path, uint32_t w, uint32_t h)
+{
+    SDL_Surface *sf = SDL_CreateRGBSurfaceWithFormatFrom(
+        V.shot.map, (int)w, (int)h, 32, (int)w * 4,
+        V.fmt == VK_FORMAT_R8G8B8A8_UNORM ? SDL_PIXELFORMAT_ABGR8888 : SDL_PIXELFORMAT_ARGB8888);
+    if (sf) {
+        SDL_SaveBMP(sf, path);
+        SDL_FreeSurface(sf);
+    }
+}
+
+/* One frame into the window: cpu (the CPU frame `cpu` is new, upload it),
+ * gpu (show the renderer's image `gpu`, else the last CPU frame). */
+static void draw(const CpuFrame *cpu, const VImg *gpu)
+{
+    Frame *f = &V.fr[V.fi];
+    VkCommandBufferBeginInfo bi = { VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO };
+    VkRenderingAttachmentInfo ca = { VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO };
+    VkRenderingInfo ri = { VK_STRUCTURE_TYPE_RENDERING_INFO };
+    VkSubmitInfo si = { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+    VkPresentInfoKHR pi = { VK_STRUCTURE_TYPE_PRESENT_INFO_KHR };
+    VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+    XboxOverlay ov;
+    char shot[1024];
+    int have_ov, have_shot, dx, dy, dw, dh, page;
+    uint32_t idx, sw, sh;
+    VkDeviceSize ov_off = 0;
+    const VImg *src;
+    VkResult r;
+    long long cw, ch, ow, oh;
+
+    if ((V.sc_bad || !V.sc) && !make_swapchain())
+        return;
+    vkWaitForFences(V.dev, 1, &f->fence, VK_TRUE, UINT64_MAX);
+    r = vkAcquireNextImageKHR(V.dev, V.sc, UINT64_MAX, f->acquired, VK_NULL_HANDLE, &idx);
+    if (r == VK_ERROR_OUT_OF_DATE_KHR) {
+        V.sc_bad = 1;
+        SDL_LockMutex(V.m);
+        V.redraw = 1;
+        SDL_UnlockMutex(V.m);
+        return;
+    }
+    if (r != VK_SUCCESS && r != VK_SUBOPTIMAL_KHR)
+        return;
+    if (r == VK_SUBOPTIMAL_KHR)
+        V.sc_bad = 1;
+    vkResetFences(V.dev, 1, &f->fence);
+    vkResetCommandBuffer(f->cb, 0);
+    bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vkBeginCommandBuffer(f->cb, &bi);
+    /* What the renderer submitted before is done with and visible; what it
+     * submits after waits for this. */
+    barrier_all(f->cb);
+
+    if (cpu && cpu->px && up_room(f, (VkDeviceSize)cpu->w * cpu->h * 4)) {
+        memcpy(f->up.map, cpu->px, (size_t)cpu->w * cpu->h * 4);
+        if (upload(f->cb, &V.cpu_img, cpu->w, cpu->h, 0)) {
+            V.cpu_have = 1;
+            V.cpu_shape = cpu->own_shape;
+        }
+        ov_off = ((VkDeviceSize)cpu->w * cpu->h * 4 + 255) & ~(VkDeviceSize)255;
+    }
+    src = gpu ? gpu : V.cpu_have ? &V.cpu_img : NULL;
+
+    /* Where it goes: the largest rectangle of its shape, centred. */
+    ow = V.ext.width;
+    oh = V.ext.height;
+    page = src && !gpu && V.cpu_shape;    /* a page before the game */
+    if (page) {
+        cw = src->w;
+        ch = src->h;
+    } else {
+        cw = xbox_DisplayContentWidth(640, 480);
+        ch = 480;
+    }
+    if (ow * ch <= oh * cw) {
+        dw = (int)ow;
+        dh = (int)(ow * ch / cw);
+    } else {
+        dh = (int)oh;
+        dw = (int)(oh * cw / ch);
+    }
+    dx = (int)(ow - dw) / 2;
+    dy = (int)(oh - dh) / 2;
+    if (src && !page)
+        xbox_WindowSetOutputSize(dw, dh);
+
+    /* The overlay is the game's: none over a page before it. */
+    have_ov = src && !page && xbox_WindowOverlayPixels(dx, dy, dw, dh, &ov)
+              && ov.px && ov.w > 0 && ov.h > 0;
+    if (have_ov) {
+        VkDeviceSize need = ov_off + (VkDeviceSize)ov.w * ov.h * 4;
+        /* A larger buffer would lose the CPU frame copied into it. */
+        if (f->up.size >= need || (ov_off == 0 && up_room(f, need))) {
+            memcpy((uint8_t *)f->up.map + ov_off, ov.px, (size_t)ov.w * ov.h * 4);
+            have_ov = upload(f->cb, &V.ov_img, (uint32_t)ov.w, (uint32_t)ov.h, ov_off);
+        } else {
+            have_ov = 0;
+        }
+    }
+    if (src || have_ov)
+        barrier_all(f->cb);
+
+    layout_to(f->cb, V.imgs[idx], VK_IMAGE_LAYOUT_UNDEFINED,
+              VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+    ca.imageView = V.views[idx];
+    ca.imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    ca.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+    ca.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    ca.clearValue.color.float32[3] = 1.0f;
+    ri.renderArea.extent = V.ext;
+    ri.layerCount = 1;
+    ri.colorAttachmentCount = 1;
+    ri.pColorAttachments = &ca;
+    vkCmdBeginRendering(f->cb, &ri);
+    if (src) {
+        /* Smaller than its rectangle: its pixels as they are; larger (the
+         * renderer above 640x480): filtered down. */
+        bind_image(f->set[0], src->view, (int)src->w > dw ? V.lin : V.near);
+        draw_quad(f->cb, dx, dy, dw, dh, 0, f->set[0]);
+    }
+    if (have_ov) {
+        int s = ov.scale > 0 ? ov.scale : 1;
+        bind_image(f->set[1], V.ov_img.view, V.near);
+        draw_quad(f->cb, ov.x, ov.y, ov.w * s, ov.h * s, 1, f->set[1]);
+    }
+    vkCmdEndRendering(f->cb);
+
+    sw = V.ext.width;
+    sh = V.ext.height;
+    have_shot = xbox_WindowShotPending(shot, sizeof shot)
+             && (V.usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT)
+             && (V.fmt == VK_FORMAT_B8G8R8A8_UNORM || V.fmt == VK_FORMAT_R8G8B8A8_UNORM);
+    if (have_shot && V.shot.size < (VkDeviceSize)sw * sh * 4) {
+        buf_free(&V.shot);
+        have_shot = buf_make(&V.shot, (VkDeviceSize)sw * sh * 4, VK_BUFFER_USAGE_TRANSFER_DST_BIT);
+    }
+    if (have_shot) {
+        VkBufferImageCopy rg;
+        layout_to(f->cb, V.imgs[idx], VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                  VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+        memset(&rg, 0, sizeof rg);
+        rg.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+        rg.imageSubresource.layerCount = 1;
+        rg.imageExtent.width = sw;
+        rg.imageExtent.height = sh;
+        rg.imageExtent.depth = 1;
+        vkCmdCopyImageToBuffer(f->cb, V.imgs[idx], VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                               V.shot.buf, 1, &rg);
+        layout_to(f->cb, V.imgs[idx], VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                  VK_IMAGE_LAYOUT_PRESENT_SRC_KHR);
+    } else {
+        layout_to(f->cb, V.imgs[idx], VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                  VK_IMAGE_LAYOUT_PRESENT_SRC_KHR);
+    }
+    /* What the renderer submits next waits for this frame's reads. */
+    barrier_all(f->cb);
+    vkEndCommandBuffer(f->cb);
+
+    si.waitSemaphoreCount = 1;
+    si.pWaitSemaphores = &f->acquired;
+    si.pWaitDstStageMask = &wait_stage;
+    si.commandBufferCount = 1;
+    si.pCommandBuffers = &f->cb;
+    si.signalSemaphoreCount = 1;
+    si.pSignalSemaphores = &V.done[idx];
+    pi.waitSemaphoreCount = 1;
+    pi.pWaitSemaphores = &V.done[idx];
+    pi.swapchainCount = 1;
+    pi.pSwapchains = &V.sc;
+    pi.pImageIndices = &idx;
+    V.qlock(1);
+    r = vkQueueSubmit(V.q, 1, &si, f->fence);
+    if (r == VK_SUCCESS)
+        r = vkQueuePresentKHR(V.q, &pi);
+    V.qlock(0);
+    if (r == VK_ERROR_OUT_OF_DATE_KHR || r == VK_SUBOPTIMAL_KHR)
+        V.sc_bad = 1;
+    if (have_shot) {
+        vkWaitForFences(V.dev, 1, &f->fence, VK_TRUE, UINT64_MAX);
+        save_shot(shot, sw, sh);
+    }
+    V.fi = (V.fi + 1) % NFR;
+}
+
+/* ── The present thread ───────────────────────────────────────────────── */
+
+static int present_thread(void *arg)
+{
+    (void)arg;
+    SDL_LockMutex(V.m);
+    for (;;) {
+        const CpuFrame *cpu = NULL;
+        const VImg *gpu = NULL;
+        int t;
+
+        while (!V.quit && !V.redraw && V.cpu_seq == V.cpu_taken && V.gpu_seq == V.gpu_taken
+               && !(V.usable && !V.attached) && V.vsync == V.sc_vsync)
+            SDL_CondWaitTimeout(V.c, V.m, 500);
+        if (V.quit)
+            break;
+        if (V.cpu_seq != V.cpu_taken) {
+            t = V.cf; V.cf = V.cr; V.cr = t;
+            V.cpu_taken = V.cpu_seq;
+            cpu = &V.cpu[V.cf];
+        }
+        if (V.gpu_seq != V.gpu_taken) {
+            t = V.gf; V.gf = V.gr; V.gr = t;
+            V.gpu_taken = V.gpu_seq;
+        }
+        V.src_gpu = V.gpu_stamp > V.cpu_stamp;
+        if (V.vsync != V.sc_vsync)
+            V.sc_bad = 1;
+        V.redraw = 0;
+        SDL_UnlockMutex(V.m);
+
+        if (device_ready()) {
+            /* The CPU frame again on a device that has not got it. */
+            if (V.reupload && !cpu && V.cpu_taken)
+                cpu = &V.cpu[V.cf];
+            V.reupload = 0;
+            if (V.src_gpu && V.attached && V.gpu[V.gf].image)
+                gpu = &V.gpu[V.gf];
+            draw(cpu, gpu);
+        } else {
+            V.sc_vsync = V.vsync;   /* nothing to retry until something changes */
+        }
+        SDL_LockMutex(V.m);
+    }
+    SDL_UnlockMutex(V.m);
+    return 0;
+}
+
+static void wake(void)
+{
+    SDL_CondSignal(V.c);
+}
+
+/* ── The renderer's side ──────────────────────────────────────────────── */
+
+void vkw_attach(VkPhysicalDevice phys, VkDevice dev, uint32_t qfam, VkQueue queue,
+                void (*lock)(int on))
+{
+    VkBool32 ok = VK_FALSE;
+
+    if (!V.m)
+        return;
+    SDL_LockMutex(V.m);
+    V.offered = 1;
+    V.o_phys = phys;
+    V.o_dev = dev;
+    V.o_qfam = qfam;
+    V.o_q = queue;
+    V.o_lock = lock ? lock : no_lock;
+    vkGetPhysicalDeviceMemoryProperties(phys, &V.o_memp);
+    if (V.surf && vkGetPhysicalDeviceSurfaceSupportKHR(phys, qfam, V.surf, &ok) == VK_SUCCESS
+        && ok)
+        V.usable = 1;
+    else
+        fprintf(stderr, "[VK] window: the renderer's device cannot show here; its frames"
+                " come through memory\n");
+    SDL_UnlockMutex(V.m);
+    wake();
+}
+
+int vkw_active(void)
+{
+    return V.usable && V.thread;
+}
+
+VkImage vkw_target(uint32_t w, uint32_t h, int *fresh)
+{
+    VImg *im;
+
+    *fresh = 0;
+    if (!vkw_active() || !w || !h)
+        return VK_NULL_HANDLE;
+    im = &V.gpu[V.gb];      /* the writer's alone */
+    if (!im->image || im->w != w || im->h != h) {
+        /* The present thread may still be reading it from a frame it
+         * submitted before: it goes once the queue is done. */
+        if (im->image) {
+            V.o_lock(1);
+            vkQueueWaitIdle(V.o_q);
+            V.o_lock(0);
+            img_free(V.o_dev, im);
+        }
+        if (!img_make(V.o_dev, &V.o_memp, im, w, h,
+                      VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT))
+            return VK_NULL_HANDLE;
+        *fresh = 1;
+    }
+    return im->image;
+}
+
+void vkw_publish(void)
+{
+    int t;
+
+    SDL_LockMutex(V.m);
+    t = V.gr; V.gr = V.gb; V.gb = t;
+    V.gpu_seq++;
+    V.gpu_stamp = ++V.stamp;
+    SDL_UnlockMutex(V.m);
+    wake();
+}
+
+/* ── The window's side (XboxPresenter) ────────────────────────────────── */
+
+static unsigned p_window_flags(void)
+{
+    const char *e = getenv("RECOMP_PRESENT");
+    VkPhysicalDevice devs[16];
+    uint32_t n = 16, i;
+
+    if (e && !strcmp(e, "sdl"))
+        return 0;
+    if (!vkw_instance())
+        return 0;
+    if (vkEnumeratePhysicalDevices(V.inst, &n, devs) < 0)
+        return 0;
+    for (i = 0; i < n; i++) {
+        VkPhysicalDeviceProperties p;
+        vkGetPhysicalDeviceProperties(devs[i], &p);
+        if (p.apiVersion >= VK_API_VERSION_1_3)
+            return SDL_WINDOW_VULKAN;
+    }
+    return 0;
+}
+
+static int p_open(void *sdl_window, int vsync)
+{
+    SDL_Window *win = (SDL_Window *)sdl_window;
+    int i;
+
+    if (V.thread || !win || !(SDL_GetWindowFlags(win) & SDL_WINDOW_VULKAN) || !vkw_instance())
+        return 0;
+    if (!SDL_Vulkan_CreateSurface(win, V.inst, &V.surf)) {
+        fprintf(stderr, "[VK] window: no surface (%s)\n", SDL_GetError());
+        V.surf = VK_NULL_HANDLE;
+        return 0;
+    }
+    if (!V.m) {
+        V.m = SDL_CreateMutex();
+        V.c = SDL_CreateCond();
+        V.wm = SDL_CreateMutex();
+    }
+    V.win = win;
+    V.quit = 0;
+    V.vsync = vsync;
+    V.sc_vsync = -1;
+    V.cb = 0; V.cr = 1; V.cf = 2;
+    V.gb = 0; V.gr = 1; V.gf = 2;
+    SDL_Vulkan_GetDrawableSize(win, &V.dw, &V.dh);
+    /* The renderer's device, offered before the window was there. */
+    if (V.offered) {
+        VkBool32 ok = VK_FALSE;
+        V.usable = vkGetPhysicalDeviceSurfaceSupportKHR(V.o_phys, V.o_qfam, V.surf, &ok)
+                   == VK_SUCCESS && ok;
+    }
+    if (!V.usable && !own_device()) {
+        fprintf(stderr, "[VK] window: no device presents here\n");
+        vkDestroySurfaceKHR(V.inst, V.surf, NULL);
+        V.surf = VK_NULL_HANDLE;
+        return 0;
+    }
+    if (!device_ready()) {
+        drop_device();
+        vkDestroySurfaceKHR(V.inst, V.surf, NULL);
+        V.surf = VK_NULL_HANDLE;
+        return 0;
+    }
+    V.thread = SDL_CreateThread(present_thread, "present", NULL);
+    if (!V.thread) {
+        drop_device();
+        vkDestroySurfaceKHR(V.inst, V.surf, NULL);
+        V.surf = VK_NULL_HANDLE;
+        return 0;
+    }
+    for (i = 0; i < 3; i++)
+        V.cpu[i].own_shape = 0;
+    fprintf(stderr, "[VK] window: frames through Vulkan\n");
+    return 1;
+}
+
+static void p_close(void)
+{
+    if (!V.thread)
+        return;
+    SDL_LockMutex(V.m);
+    V.quit = 1;
+    SDL_UnlockMutex(V.m);
+    wake();
+    /* The renderer may be writing a frame image: they stay, as its device
+     * does, until the process ends. */
+    V.usable = 0;
+    SDL_WaitThread(V.thread, NULL);
+    V.thread = NULL;
+    drop_device();
+    V.attached = 0;
+    vkDestroySurfaceKHR(V.inst, V.surf, NULL);
+    V.surf = VK_NULL_HANDLE;
+    V.win = NULL;
+    V.cpu_seq = V.cpu_taken = V.gpu_seq = V.gpu_taken = 0;
+    V.stamp = V.cpu_stamp = V.gpu_stamp = 0;
+}
+
+static void p_resized(int w, int h)
+{
+    if (!V.thread)
+        return;
+    SDL_LockMutex(V.m);
+    if (w != V.dw || h != V.dh) {
+        V.dw = w;
+        V.dh = h;
+        V.sc_bad = 1;
+    }
+    V.redraw = 1;
+    SDL_UnlockMutex(V.m);
+    wake();
+}
+
+static void p_set_vsync(int on)
+{
+    if (!V.m)
+        return;
+    SDL_LockMutex(V.m);
+    V.vsync = on != 0;
+    SDL_UnlockMutex(V.m);
+    wake();
+}
+
+static void p_pixels(const void *px, uint32_t w, uint32_t h, uint32_t pitch,
+                     uint32_t bpp, int own_shape)
+{
+    CpuFrame *f;
+    size_t need = (size_t)w * h * 4;
+    uint32_t x, y;
+    int t;
+
+    if (!V.thread || !px || !w || !h || (bpp != 2 && bpp != 4))
+        return;
+    SDL_LockMutex(V.wm);
+    f = &V.cpu[V.cb];       /* the writer's alone */
+    if (f->cap < need) {
+        uint8_t *n = (uint8_t *)realloc(f->px, need);
+        if (!n) {
+            SDL_UnlockMutex(V.wm);
+            return;
+        }
+        f->px = n;
+        f->cap = need;
+    }
+    for (y = 0; y < h; y++) {
+        const uint8_t *s = (const uint8_t *)px + (size_t)y * pitch;
+        uint32_t *d = (uint32_t *)(f->px + (size_t)y * w * 4);
+        if (bpp == 4) {
+            memcpy(d, s, (size_t)w * 4);
+        } else {
+            for (x = 0; x < w; x++) {
+                uint32_t c = (uint32_t)s[2 * x] | (uint32_t)s[2 * x + 1] << 8;
+                uint32_t r = (c >> 11) & 31, g = (c >> 5) & 63, b = c & 31;
+                d[x] = 0xFF000000u | ((r << 3 | r >> 2) << 16) | ((g << 2 | g >> 4) << 8)
+                     | (b << 3 | b >> 2);
+            }
+        }
+    }
+    f->w = w;
+    f->h = h;
+    f->own_shape = own_shape;
+    SDL_LockMutex(V.m);
+    t = V.cr; V.cr = V.cb; V.cb = t;
+    V.cpu_seq++;
+    V.cpu_stamp = ++V.stamp;
+    SDL_UnlockMutex(V.m);
+    SDL_UnlockMutex(V.wm);
+    wake();
+}
+
+static const XboxPresenter k_presenter = {
+    p_window_flags, p_open, p_close, p_resized, p_set_vsync, p_pixels,
+};
+
+void nv2a_vk_window_install(void)
+{
+    xbox_WindowSetPresenter(&k_presenter);
+}
diff --git a/src/vulkan/vk_window.h b/src/vulkan/vk_window.h
new file mode 100644
index 0000000..617fd2e
--- /dev/null
+++ b/src/vulkan/vk_window.h
@@ -0,0 +1,38 @@
+/*
+ * The framebuffer window's frames through Vulkan (vk_window.c): what the
+ * renderer (nv2a_vk.c) uses of it. The window's own side is the
+ * XboxPresenter it registers (video_player.h).
+ */
+#ifndef XBOXRECOMP_VK_WINDOW_H
+#define XBOXRECOMP_VK_WINDOW_H
+
+#include <stdint.h>
+#include <vulkan/vulkan.h>
+
+/* The one instance, with the window systems' surface extensions, made on
+ * first use; the renderer's device and the window's surface come from it.
+ * VK_NULL_HANDLE when there is no Vulkan. */
+VkInstance vkw_instance(void);
+
+/* The window's surface, VK_NULL_HANDLE while there is none. */
+VkSurfaceKHR vkw_surface(void);
+
+/* The renderer's device, offered once it is made: the window shows its
+ * frames on it from then on, if the queue family can present to the
+ * window. lock(1) / lock(0) around every use of the queue, from any thread.
+ * The device needs VK_KHR_swapchain. */
+void vkw_attach(VkPhysicalDevice phys, VkDevice dev, uint32_t qfam, VkQueue queue,
+                void (*lock)(int on));
+
+/* Whether the renderer's frames go to the window as images (vkw_target). */
+int vkw_active(void);
+
+/* The image the renderer's next frame goes into, w x h B8G8R8A8_UNORM, kept
+ * in VK_IMAGE_LAYOUT_GENERAL; *fresh when it was just made and is still in
+ * VK_IMAGE_LAYOUT_UNDEFINED. VK_NULL_HANDLE when frames do not go this way.
+ * The renderer's thread only, which then records what writes it, submits
+ * that and calls vkw_publish. */
+VkImage vkw_target(uint32_t w, uint32_t h, int *fresh);
+void vkw_publish(void);
+
+#endif
