+
+/* The overlay over the picture, through an SDL renderer. */
+static void draw_overlay(SDL_Renderer *ren, SDL_Texture **tex, int *tw, int *th,
+                         int x, int y, int w, int h)
+{
+    XboxOverlay ov;
+    SDL_Rect r;
+
+    if (!xbox_WindowOverlayPixels(x, y, w, h, &ov) || !ov.px || ov.w <= 0 || ov.h <= 0)
+        return;
+    if (!*tex || *tw != ov.w || *th != ov.h) {
+        if (*tex)
+            SDL_DestroyTexture(*tex);
+        *tex = SDL_CreateTexture(ren, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STREAMING,
+                                 ov.w, ov.h);
+        if (!*tex)
+            return;
+        SDL_SetTextureBlendMode(*tex, SDL_BLENDMODE_BLEND);
+        *tw = ov.w;
+        *th = ov.h;
+    }
+    SDL_UpdateTexture(*tex, NULL, ov.px, ov.w * 4);
+    r.x = ov.x;
+    r.y = ov.y;
+    r.w = ov.w * (ov.scale > 0 ? ov.scale : 1);
+    r.h = ov.h * (ov.scale > 0 ? ov.scale : 1);
+    SDL_RenderCopy(ren, *tex, NULL, &r);
+}
