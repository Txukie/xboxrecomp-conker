+
+unsigned xbox_WindowCreateFlags(void)
+{
+    static int flags = -1;
+    if (flags < 0)
+        flags = s_pr && s_pr->window_flags ? (int)s_pr->window_flags() : 0;
+    return (unsigned)flags;
+}
+
+static int presenter_open(SDL_Window *win, int vsync)
+{
+    if (s_pr_open)
+        return s_pr_win == win;
+    if (!s_pr || !(SDL_GetWindowFlags(win) & SDL_WINDOW_VULKAN) || !s_pr->open(win, vsync))
+        return 0;
+    s_pr_open = 1;
+    s_pr_win = win;
+    s_view_dw = s_view_dh = 0;
+    return 1;
+}
+
+/* The presenter follows the window's drawable size. */
+static void presenter_size(void)
+{
+    int w = 0, h = 0;
+    SDL_Vulkan_GetDrawableSize(s_pr_win, &w, &h);
+    if (w != s_view_dw || h != s_view_dh) {
+        s_view_dw = w;
+        s_view_dh = h;
+        s_pr->resized(w, h);
+    }
+}
+
+int xbox_WindowViewOpen(void *sdl_window)
+{
+    SDL_Window *win = (SDL_Window *)sdl_window;
+
+    if (!win)
+        return 0;
+    if (presenter_open(win, 1))
+        return 1;
+    s_view_ren = SDL_CreateRenderer(win, -1, SDL_RENDERER_PRESENTVSYNC);
+    return s_view_ren != NULL;
+}
+
+void xbox_WindowViewShow(const void *px, int w, int h, int pitch)
+{
+    if (s_pr_open) {
+        SDL_DisplayMode m;
+        Uint32 now, period;
+
+        presenter_size();
+        s_pr->pixels(px, (uint32_t)w, (uint32_t)h, (uint32_t)pitch, 4, 1);
+        /* The presenter does not wait for the display here: the page's
+         * loop is paced to it. */
+        period = SDL_GetWindowDisplayMode(s_pr_win, &m) == 0 && m.refresh_rate > 0
+               ? 1000u / (Uint32)m.refresh_rate : 16u;
+        now = SDL_GetTicks();
+        if (now - s_view_t < period)
+            SDL_Delay(period - (now - s_view_t));
+        s_view_t = SDL_GetTicks();
+        return;
+    }
+    if (!s_view_ren)
+        return;
+    if (!s_view_tex || s_view_tw != w || s_view_th != h) {
+        if (s_view_tex)
+            SDL_DestroyTexture(s_view_tex);
+        s_view_tex = SDL_CreateTexture(s_view_ren, SDL_PIXELFORMAT_XRGB8888,
+                                       SDL_TEXTUREACCESS_STREAMING, w, h);
+        s_view_tw = w;
+        s_view_th = h;
+    }
+    SDL_SetRenderDrawColor(s_view_ren, 0, 0, 0, 255);
+    SDL_RenderClear(s_view_ren);
+    if (s_view_tex) {
+        SDL_Rect dst;
+        int ow, oh;
+        SDL_UpdateTexture(s_view_tex, NULL, px, pitch);
+        if (SDL_GetRendererOutputSize(s_view_ren, &ow, &oh) != 0 || ow <= 0 || oh <= 0) {
+            ow = w;
+            oh = h;
+        }
+        if ((long long)ow * h <= (long long)oh * w) {
+            dst.w = ow;
+            dst.h = (int)((long long)ow * h / w);
+        } else {
+            dst.h = oh;
+            dst.w = (int)((long long)oh * w / h);
+        }
+        dst.x = (ow - dst.w) / 2;
+        dst.y = (oh - dst.h) / 2;
+        SDL_RenderCopy(s_view_ren, s_view_tex, NULL, &dst);
+    }
+    SDL_RenderPresent(s_view_ren);
+}
+
+void xbox_WindowViewClose(int keep)
+{
+    static const uint32_t black[16];
+
+    if (s_view_tex)
+        SDL_DestroyTexture(s_view_tex);
+    s_view_tex = NULL;
+    if (s_view_ren) {
+        if (keep) {
+            SDL_SetRenderDrawColor(s_view_ren, 0, 0, 0, 255);
+            SDL_RenderClear(s_view_ren);
+            SDL_RenderPresent(s_view_ren);
+        }
+        SDL_DestroyRenderer(s_view_ren);
+        s_view_ren = NULL;
+    }
+    if (s_pr_open) {
+        if (keep) {
+            s_pr->pixels(black, 4, 4, 16, 4, 1);
+        } else {
+            s_pr->close();
+            s_pr_open = 0;
+            s_pr_win = NULL;
+        }
+    }
+}
