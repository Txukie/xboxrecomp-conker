diff --git a/src/kernel/nv2a_backend.h b/src/kernel/nv2a_backend.h
--- a/src/kernel/nv2a_backend.h
+++ b/src/kernel/nv2a_backend.h
@@ -117,4 +117,16 @@
  * the semaphore context DMA object through RAMIN. */
 void nv2a_pb_set_semaphore_target(uint32_t guest_va);
 
+/* Software methods: NO_OPERATION with a non-zero parameter, which the console
+ * traps to the title's GPU interrupt handler (XDK D3D's ServiceGrInterrupt)
+ * with the GPU stalled until it returns. The executor delivers no GPU
+ * interrupts, so a title whose D3D does real work there registers the work
+ * here: the hook runs on the executor thread, in pushbuffer order, before the
+ * command after the NO_OPERATION -- the point where the console's GPU would
+ * resume. XDK D3D's RunPushBuffer, for one, defers patching a pushbuffer the
+ * GPU may still be reading into a software method; unapplied, the
+ * pushbuffer's closing JUMP returns to wherever it was last called from and
+ * the walk replays old commands. NULL removes the hook. */
+void nv2a_pb_set_swmethod_hook(void (*hook)(uint32_t param));
+
 #endif /* NV2A_BACKEND_H */
