+/* A batch's vertices, on the raster pool.
+ *
+ * The vertex program is the executor's hot spot: Conker's front end spends
+ * a third of its time in nv2a_vsh_run, against a few percent drawing pixels.
+ * Each vertex reads only GPU state that cannot change inside a batch and
+ * writes only its own output, so contiguous ranges go to the workers -- unless
+ * the program may write constants (_CXT_WRITE_EN), when order matters. Worker
+ * k (the caller is the last) takes the k-th of n slices. */
+/* Positions in the batch whose index appears there for the first time, and
+ * for every position the first one with the same index. */
+static uint32_t *s_xf_first, *s_xf_src;
+
+static void xf_transform_range(int k, int n)
+{
+    uint32_t j, lo = (uint32_t)((uint64_t)s_pool.nverts * k / n),
+             hi = (uint32_t)((uint64_t)s_pool.nverts * (k + 1) / n);
+    for (j = lo; j < hi; j++) {
+        uint32_t i = s_xf_first[j];
+        if (!transform_vertex(s_gpu.idx[i], &s_xf[i])) {
+            InterlockedExchange(&s_pool.vfail, 1);
+            return;
+        }
+    }
+}
+
+#define NV_XF_MT_MIN_VERTS 256
+
+/* Each index once. Indexed batches name the same vertex 2.3 times on
+ * average in Conker's front end (strips, shared corners), and the same index
+ * fetches the same attributes through the same program, so its output is
+ * computed at its first position and copied to the rest. A 64K table keyed by
+ * the low 16 bits finds repeats; a 32-bit index that collides there is just
+ * transformed again. */
+static uint32_t xf_dedupe(uint32_t nverts)
+{
+    static uint32_t key[1u << 16], pos[1u << 16], stamp[1u << 16], gen;
+    uint32_t i, nu = 0;
+
+    if (++gen == 0) {
+        memset(stamp, 0, sizeof stamp);
+        gen = 1;
+    }
+    for (i = 0; i < nverts; i++) {
+        uint32_t x = s_gpu.idx[i], h = x & 0xFFFFu;
+        if (stamp[h] == gen && key[h] == x) {
+            s_xf_src[i] = pos[h];
+        } else {
+            stamp[h] = gen; key[h] = x; pos[h] = i;
+            s_xf_src[i] = i;
+            s_xf_first[nu++] = i;
+        }
+    }
+    return nu;
+}
+
+static int xf_transform_batch(uint32_t nverts)
+{
+    int n = raster_pool_size(), k;
+    uint32_t i, nu;
+
+    if (!batch_uses_program() || nv2a_vsh_cxt_write()) {
+        for (i = 0; i < nverts; i++)
+            if (!transform_vertex(s_gpu.idx[i], &s_xf[i]))
+                return 0;                              /* no program loaded */
+        return 1;
+    }
+    if (!s_xf_first) {
+        s_xf_first = (uint32_t *)malloc(NV_MAX_INDICES * sizeof *s_xf_first);
+        s_xf_src = (uint32_t *)malloc(NV_MAX_INDICES * sizeof *s_xf_src);
+        if (!s_xf_first || !s_xf_src)
+            return 0;
+    }
+    nu = xf_dedupe(nverts);
+    nv2a_vsh_prepare();                   /* decode here; workers only read */
+    s_pool.nverts = nu;
+    s_pool.vfail = 0;
+    if (n <= 1 || nu < NV_XF_MT_MIN_VERTS) {
+        xf_transform_range(0, 1);
+    } else {
+        s_pool.job = NV_JOB_TRANSFORM;
+        s_pool.pending = n - 1;
+        for (k = 0; k < n - 1; k++)
+            SetEvent(s_pool.start[k]);
+        xf_transform_range(n - 1, n);
+        WaitForSingleObject(s_pool.done, INFINITE);
+    }
+    if (s_pool.vfail)
+        return 0;
+    for (i = 0; i < nverts; i++)
+        if (s_xf_src[i] != i)
+            s_xf[i] = s_xf[s_xf_src[i]];
+    return 1;
+}
