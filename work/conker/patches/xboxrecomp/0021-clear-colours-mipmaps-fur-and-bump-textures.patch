+/* SET_COLOR_CLEAR_VALUE is a pixel in the colour surface's own format, not
+ * always A8R8G8B8 (xemu's pgraph clear decodes it per format): a 16-bit
+ * surface takes it as a raw R5G6B5 or X1R5G5B5 pixel. Read as ARGB, the
+ * 0xFFFF (white) that Conker clears its 128x128 R5G6B5 blob-shadow map to
+ * became 0x0000FFFF, cyan -- and the ground, multiplied by that map, showed
+ * a green-blue square around every character. */
+static uint16_t clear_color_16(void)
+{
+    switch (s_gpu.format & 0xF) {
+    case 0x1: case 0x2: case 0x3:            /* X1R5G5B5 (Z/O), R5G6B5 */
+        return (uint16_t)(s_gpu.clear_color & 0xFFFF);
+    default:                                 /* a 16-bit guess: from ARGB */
+        return (uint16_t)(((s_gpu.clear_color >> 8) & 0xF800)
+                        | ((s_gpu.clear_color >> 5) & 0x07E0)
+                        | ((s_gpu.clear_color >> 3) & 0x001F));
+    }
+}
+
+/* The clear colour as ARGB, whatever the surface format. */
+static uint32_t clear_color_argb(void)
+{
+    uint32_t v = s_gpu.clear_color & 0xFFFF;
