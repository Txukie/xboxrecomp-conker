+    switch (s_gpu.format & 0xF) {
+    case 0x1: case 0x2:                      /* X1R5G5B5 */
+        return 0xFF000000u | d3d8_expand_channel((v >> 10) & 0x1F, 5) << 16
+             | d3d8_expand_channel((v >> 5) & 0x1F, 5) << 8
+             | d3d8_expand_channel(v & 0x1F, 5);
+    case 0x3:                                /* R5G6B5 */
+        return 0xFF000000u | d3d8_expand_channel((v >> 11) & 0x1F, 5) << 16
+             | d3d8_expand_channel((v >> 5) & 0x3F, 6) << 8
+             | d3d8_expand_channel(v & 0x1F, 5);
+    default:
+        return s_gpu.clear_color;
+    }
+}
