+void nv2a_backend_decode_stage_level(const Nv2aStage *st, uint32_t face,
+                                     uint32_t level, uint32_t *argb_out)
+{
+    Texture t;
+    uint32_t u, v, off, lv, w, h;
+    uint32_t block = d3d8_format_dxt_block_bytes(st->color);
+
+    memset(&t, 0, sizeof t);
+    t.width = st->width;
+    t.height = st->height;
+    t.pitch = st->pitch;
+    t.color = st->color;
+    t.levels = st->levels;
+    t.palette = st->palette;
+    t.cube = (int)st->cube;
+    t.addr_u = t.addr_v = 3;
+    off = st->cube ? face * tex_face_stride(&t) : 0;
+    /* The levels follow each other inside a face (tex_face_stride). */
+    for (lv = 0; lv < level; lv++) {
+        uint32_t lw = (st->width >> lv) ? (st->width >> lv) : 1;
+        uint32_t lh = (st->height >> lv) ? (st->height >> lv) : 1;
+        off += block ? ((lw + 3) / 4) * ((lh + 3) / 4) * block
+                     : lw * lh * tex_texel_bytes(st->color);
+    }
+    w = (st->width >> level) ? (st->width >> level) : 1;
+    h = (st->height >> level) ? (st->height >> level) : 1;
+    t.offset = st->offset + off;
+    t.width = w;
+    t.height = h;
+    tex_update_valid(&t);
+    for (v = 0; v < h; v++)
+        for (u = 0; u < w; u++) {
+            uint32_t *o = &argb_out[(size_t)v * w + u];
+            if (!sample_tex(&t, 0, u, v, o))
+                *o = 0xFFFFFFFFu;
+        }
