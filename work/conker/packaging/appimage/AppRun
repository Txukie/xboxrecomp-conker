#!/bin/sh
# Conker recomp AppImage entry point.
#
#   Conker-Recomp-x86_64.AppImage [game] [save-directory]
#
# The AppImage carries no game data. On the first launch a setup window asks
# for your copy of the game -- a disc image (.iso, also a Redump dump, or the
# .7z/.zip holding it) or the folder of an extracted disc -- and installs an
# image into $XDG_DATA_HOME/conker-recomp/game (~/.local/share/...), where
# every later launch finds it. A first argument (a game folder or an image)
# or CONKER_GAME_DIR names the game instead. Saves go to
# $XDG_DATA_HOME/conker-recomp/saves unless a second argument or
# CONKER_SAVE_DIR says otherwise.
#
# Defaults set here, each overridable from the environment: the game window
# (RECOMP_FB_WINDOW=1) and the Vulkan renderer (RECOMP_RENDERER=vulkan; the
# CPU rasteriser takes over when no Vulkan device is usable).
here=$(dirname "$(readlink -f "$0")")
export LD_LIBRARY_PATH="$here/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export RECOMP_FB_WINDOW="${RECOMP_FB_WINDOW:-1}"
export RECOMP_RENDERER="${RECOMP_RENDERER:-vulkan}"

exec "$here/usr/bin/conker_recomp" "$@"
