// The Windows executable's icon and version: CMakeLists.txt fills this in
// with configure_file and adds it to conker_recomp on Windows.
#include <winver.h>

1 ICON "@CONKER_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Conker: Live & Reloaded static recompilation"
            VALUE "ProductName", "Conker Recomp"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "conker_recomp.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
